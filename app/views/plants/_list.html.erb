<div id="plants-list" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
  <% if plants.any? %>
    <% plants.each do |plant| %>
      <div class="bg-white rounded-lg shadow-md overflow-hidden hover:shadow-lg transition-shadow duration-300">
        <div class="relative h-48 overflow-hidden">
          <%= image_tag plant.image_path, 
            class: "w-full h-full object-cover",
            alt: plant.name %>
          <div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-black/70 to-transparent p-4">
            <h3 class="text-white text-xl font-semibold"><%= plant.name %></h3>
            <p class="text-gray-200 text-sm italic"><%= plant.scientific_name %></p>
          </div>
        </div>
        
        <div class="p-4">
          <!-- Functions -->
          <div class="mb-3">
            <h4 class="text-sm font-semibold text-gray-600 mb-2">Functions:</h4>
            <div class="flex flex-wrap gap-2">
              <% plant.plant_functions.each do |function| %>
                <span class="px-2 py-1 bg-green-100 text-green-800 text-xs rounded-full">
                  <%= function %>
                </span>
              <% end %>
            </div>
          </div>

          <!-- Layers -->
          <div class="mb-3">
            <h4 class="text-sm font-semibold text-gray-600 mb-2">Layers:</h4>
            <div class="flex flex-wrap gap-2">
              <% plant.layers.each do |layer| %>
                <span class="px-2 py-1 bg-blue-100 text-blue-800 text-xs rounded-full">
                  <%= layer %>
                </span>
              <% end %>
            </div>
          </div>

          <!-- Zones -->
          <div>
            <h4 class="text-sm font-semibold text-gray-600 mb-2">Growing Zones:</h4>
            <span class="text-gray-700">
              <%= plant.zone_range.begin %> - <%= plant.zone_range.end %>
            </span>
          </div>
        </div>

        <div class="px-4 pb-4">
          <%= link_to "View Details", plant_path(plant), 
            class: "block w-full text-center py-2 bg-green-600 text-white rounded-lg hover:bg-green-700 transition-colors" %>
        </div>
      </div>
    <% end %>
  <% else %>
    <div class="col-span-full text-center py-12">
      <div class="text-gray-500">
        <svg class="mx-auto h-12 w-12 mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"/>
        </svg>
        <h3 class="text-lg font-medium mb-2">No plants found</h3>
        <p>Try adjusting your filters to find more plants.</p>
      </div>
    </div>
  <% end %>
</div> 