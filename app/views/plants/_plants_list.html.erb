<%= turbo_frame_tag "plants-list" do %>
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    <% plants.each do |plant| %>
      <div class="plant-card bg-white rounded-lg shadow overflow-hidden hover:shadow-lg transition-shadow">
        <%# Plant Image %>
        <div class="w-full h-48 overflow-hidden bg-gray-200 flex items-center justify-center">
          <% if plant.respond_to?(:display_image) && plant.display_image.present? %>
            <%= image_tag asset_path(plant.display_image), class: "w-full h-full object-cover", alt: plant.common_name %>
          <% else %>
            <%# Fallback image or placeholder %>
            <div class="text-gray-400 text-center">
              <svg class="w-16 h-16 mx-auto mb-2" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M4 3a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V5a2 2 0 00-2-2H4zm12 12H4l4-8 3 6 2-4 3 6z" clip-rule="evenodd" />
              </svg>
              <p class="text-sm">No image</p>
            </div>
          <% end %>
        </div>

        <div class="p-6">
          <h3 class="text-xl font-bold mb-2">
            <%= link_to plant.common_name, plant_path(plant.to_param), class: "text-green-800 hover:text-green-600" %>
          </h3>
          <p class="text-gray-600 italic mb-3"><%= plant.scientific_name %></p>
          
          <%# Zone information from environmental requirements %>
          <% if plant.environmental_requirements %>
            <div class="mb-4">
              <span class="text-sm font-semibold text-gray-700">Zone:</span>
              <span class="text-sm text-gray-600">
                <%= plant.environmental_requirements.zone_range || "Not specified" %>
              </span>
            </div>
          <% end %>

          <%# Plant type and life cycle %>
          <div class="mb-4">
            <span class="text-sm font-semibold text-gray-700">Type:</span>
            <span class="text-sm text-gray-600">
              <%= plant.plant_type&.humanize || "Not specified" %>
              <% if plant.life_cycle.present? %>
                (<%= plant.life_cycle.humanize %>)
              <% end %>
            </span>
          </div>

          <%# Functions from plant uses %>
          <% if plant.plant_uses.any? %>
            <div class="mb-4">
              <span class="text-sm font-semibold text-gray-700">Uses:</span>
              <div class="flex flex-wrap gap-2 mt-1">
                <% plant.plant_uses.includes(:use_category).limit(5).each do |plant_use| %>
                  <span class="px-2 py-1 bg-green-100 text-green-800 text-xs rounded-full">
                    <%= plant_use.use_category.name %>
                  </span>
                <% end %>
                <% if plant.plant_uses.count > 5 %>
                  <span class="px-2 py-1 bg-gray-100 text-gray-600 text-xs rounded-full">
                    +<%= plant.plant_uses.count - 5 %> more
                  </span>
                <% end %>
              </div>
            </div>
          <% end %>

          <%# Environmental preferences %>
          <% if plant.environmental_requirements %>
            <div class="mb-4">
              <span class="text-sm font-semibold text-gray-700">Light:</span>
              <span class="text-sm text-gray-600">
                <%= plant.environmental_requirements.light_requirement&.humanize&.gsub('_', ' ') || "Not specified" %>
              </span>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>

  <%# Show count %>
  <div class="mt-6 text-center text-gray-600">
    Showing <%= plants.is_a?(Array) ? plants.size : plants.count %> plants
  </div>
<% end %>
