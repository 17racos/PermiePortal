<%= turbo_frame_tag "plants-list" do %>
  <div class="max-w-4xl mx-auto py-8">
    <%= link_to "← Back to Plants", plants_path, class: "inline-block mb-8 text-green-700 hover:text-green-600" %>

    <div class="bg-white rounded-lg shadow-lg overflow-hidden">
      <%# Plant Image %>
      <div class="w-full h-96 overflow-hidden">
        <%= image_tag asset_path(@plant.display_image), class: "w-full h-full object-cover", alt: @plant.common_name %>
      </div>

      <div class="p-8">
        <%# Header Section %>
        <div class="mb-8">
          <h1 class="text-3xl font-bold text-gray-900 mb-2"><%= @plant.common_name %></h1>
          <p class="text-xl text-gray-600 italic"><%= @plant.scientific_name %></p>
        </div>

        <%# Key Info Grid %>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-8">
          <%# Left Column %>
          <div>
            <%# Basic Info %>
            <div class="mb-6">
              <h3 class="text-lg font-semibold mb-3">Basic Information</h3>
              <div class="space-y-3">
                <div>
                  <span class="font-medium">Type:</span>
                  <span class="ml-2"><%= @plant.perennial ? "Perennial" : "Annual" %></span>
                </div>
                <div>
                  <span class="font-medium">USDA Zone:</span>
                  <span class="ml-2"><%= "#{@plant.zone_range.begin}-#{@plant.zone_range.end}" %></span>
                </div>
                <div>
                  <span class="font-medium">Temperature Range:</span>
                  <span class="ml-2"><%= @plant.ideal_temp_range %></span>
                </div>
                <div>
                  <span class="font-medium">Temperature Extremes:</span>
                  <span class="ml-2"><%= @plant.temperature_extremes %></span>
                </div>
              </div>
            </div>

            <%# Functions %>
            <div class="mb-6">
              <h3 class="text-lg font-semibold mb-3">Functions</h3>
              <div class="flex flex-wrap gap-2">
                <% @plant.functions_array.each do |function| %>
                  <span class="px-3 py-1 bg-green-100 text-green-800 rounded-full text-sm">
                    <%= function %>
                  </span>
                <% end %>
              </div>
            </div>

            <%# Layers %>
            <div class="mb-6">
              <h3 class="text-lg font-semibold mb-3">Forest Layers</h3>
              <div class="flex flex-wrap gap-2">
                <% @plant.layers_array.each do |layer| %>
                  <span class="px-3 py-1 bg-blue-100 text-blue-800 rounded-full text-sm">
                    <%= layer %>
                  </span>
                <% end %>
              </div>
            </div>
          </div>

          <%# Right Column %>
          <div>
            <%# Purpose %>
            <div class="mb-6">
              <h3 class="text-lg font-semibold mb-3">Purpose & Uses</h3>
              <div class="prose prose-green">
                <%= simple_format @plant.purpose %>
              </div>
            </div>

            <%# Pests %>
            <% if @plant.valid_pests.any? %>
              <div class="mb-6">
                <h3 class="text-lg font-semibold mb-3">Known Pests</h3>
                <ul class="list-disc list-inside space-y-1">
                  <% @plant.valid_pests.each do |pest| %>
                    <li><%= pest.name %></li>
                  <% end %>
                </ul>
              </div>
            <% end %>
          </div>
        </div>

        <%# Description %>
        <% if @plant.description.present? %>
          <div class="border-t pt-8">
            <h3 class="text-lg font-semibold mb-4">Additional Information</h3>
            <div class="prose prose-green max-w-none">
              <%= simple_format @plant.description %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>
<% end %>
