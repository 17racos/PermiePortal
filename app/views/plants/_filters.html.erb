<div class="mb-8 bg-gradient-to-b from-green-50 to-green-100 shadow-lg rounded-lg p-6 border border-green-300">
  <%= form_with url: plants_path, method: :get, data: { turbo_frame: "plants-list" } do |f| %>
    <!-- Search Bar -->
    <div class="mb-6">
      <div class="relative">
        <%= f.text_field :query, 
          class: "w-full px-4 py-2 pr-10 rounded-lg border border-green-300 focus:ring-2 focus:ring-green-500 focus:border-transparent",
          placeholder: "Search by name or scientific name...",
          onchange: "this.form.requestSubmit()" %>
        <div class="absolute inset-y-0 right-0 flex items-center pr-3">
          <svg class="h-5 w-5 text-gray-400" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M8 4a4 4 0 100 8 4 4 0 000-8zM2 8a6 6 0 1110.89 3.476l4.817 4.817a1 1 0 01-1.414 1.414l-4.816-4.816A6 6 0 012 8z" clip-rule="evenodd" />
          </svg>
        </div>
      </div>
    </div>

    <!-- Active Filters Display -->
    <div class="mb-6" data-filter-target="activeFilters">
      <div class="flex flex-wrap gap-2">
        <!-- Active filters will be inserted here by JavaScript -->
      </div>
    </div>

    <!-- Clear Filters Button -->
    <div class="mb-6 flex justify-end">
      <button type="button" 
        class="px-4 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700 transition-colors"
        data-action="click->filter#clearAll">
        Clear All Filters
      </button>
    </div>

    <div class="grid md:grid-cols-3 gap-6">
      <!-- Functions Filter -->
      <div class="filter-section">
        <h3 class="text-lg font-semibold text-green-900 mb-4">🌿 Functions</h3>
        <div class="space-y-4">
          <% [
            ["Food", ["Edible", "Animal Fodder"]],
            ["Soil", ["Nitrogen Fixer", "Dynamic Accumulator", "Mulcher", "Erosion Control"]],
            ["Wildlife", ["Wildlife Attractor", "Pollinator", "Pest Management"]],
            ["Structure", ["Ground Cover", "Windbreaker", "Border Plant"]],
            ["Other", ["Medicinal", "Biofuel", "Water Purifier"]]
          ].each do |category, functions| %>
            <div class="w-full">
              <h4 class="text-sm font-medium text-green-800 mb-2"><%= category %></h4>
              <div class="space-y-2">
                <% functions.each do |function| %>
                  <label class="flex items-center gap-2">
                    <%= check_box_tag "functions[]", 
                      function, 
                      params[:functions]&.include?(function),
                      class: "w-4 h-4 text-green-600 rounded border-gray-300 focus:ring-green-500",
                      onchange: "this.form.requestSubmit()" %>
                    <span class="text-sm text-gray-700"><%= function %></span>
                  </label>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      </div>

      <!-- Layers Filter -->
      <div class="filter-section">
        <h3 class="text-lg font-semibold text-green-900 mb-4">🌾 Layers</h3>
        <div class="space-y-2">
          <% ["Canopy", "Sub-canopy", "Shrub", "Herbaceous", "Ground", "Root", "Vine", "Aquatic"].each do |layer| %>
            <label class="flex items-center gap-2">
              <%= check_box_tag "layers[]", 
                layer, 
                params[:layers]&.include?(layer),
                class: "w-4 h-4 text-green-600 rounded border-gray-300 focus:ring-green-500",
                onchange: "this.form.requestSubmit()" %>
              <span class="text-sm text-gray-700"><%= layer %></span>
            </label>
          <% end %>
        </div>
      </div>

      <!-- Zones Filter -->
      <div class="filter-section">
        <h3 class="text-lg font-semibold text-green-900 mb-4">🌎 Zones</h3>
        <div class="space-y-4">
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Zone Range</label>
            <div class="flex items-center gap-2">
              <%= f.number_field :min_zone, 
                min: 1, max: 13,
                value: params[:min_zone],
                class: "w-20 px-2 py-1 border border-gray-300 rounded",
                onchange: "this.form.requestSubmit()" %>
              <span>to</span>
              <%= f.number_field :max_zone,
                min: 1, max: 13,
                value: params[:max_zone],
                class: "w-20 px-2 py-1 border border-gray-300 rounded",
                onchange: "this.form.requestSubmit()" %>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Results Count -->
    <div class="mt-6 text-right text-sm text-gray-600" data-filter-target="resultCount">
      Showing all plants
    </div>
  <% end %>
</div>

<% content_for :styles do %>
<style>
.filter-tag {
  background-color: #E5E7EB;
  color: #374151;
}

.filter-tag[data-active="true"] {
  background-color: #059669;
  color: white;
}

.filter-section {
  transition: all 0.3s ease;
}
</style>
<% end %>
