<div class="mb-8 bg-white shadow-md rounded-lg p-6">
  <!-- Filter Container with Right-to-Left Alignment -->
  <div class="flex flex-wrap lg:flex-nowrap justify-end gap-8">
    
    <!-- Function Filters -->
    <div class="mb-6 w-full sm:w-1/3">
      <h3 class="text-md font-semibold text-center mb-4">Filter by Functions</h3>
      <div class="grid grid-cols-3 items-center gap-1.5">
        <% ["Edible", "Medicinal", "Nitrogen Fixer", "Wildlife Attractor", "Mulcher", "Dynamic Accumulator", "Erosion Control", "Ground Cover", "Animal Fodder", "Windbreaker", "Pollinator", "Border Plant", "Pest Management", "Biofuel", "Water Purifier"].each do |plant_function| %>
          <label class="flex items-center gap-2">
            <%= check_box_tag "search[plant_function][]", plant_function, params.dig(:search, :plant_function)&.include?(plant_function), class: "w-5 h-5", onchange: "this.form.requestSubmit()" %>
            <span class="whitespace-nowrap"><%= plant_function %></span>
          </label>
        <% end %>
      </div>
    </div>

    <!-- Layer Filters -->
    <div class="mb-6 w-full sm:w-1/3">
      <h3 class="text-md font-semibold text-center mb-4">Filter by Layers</h3>
      <div class="grid grid-cols-3 items-center gap-1.5">
        <% ["Canopy", "Sub-canopy", "Shrub", "Herbaceous", "Ground", "Root", "Vine", "Aquatic"].each do |layer| %>
          <label class="flex items-center gap-2">
            <%= check_box_tag "search[layers][]", layer, params.dig(:search, :layers)&.include?(layer), class: "w-5 h-5", onchange: "this.form.requestSubmit()" %>
            <span class="whitespace-nowrap"><%= layer %></span>
          </label>
        <% end %>
      </div>
    </div>

    <!-- Zone Filters -->
    <div class="mb-6 w-full sm:w-1/3">
      <h3 class="text-md font-semibold text-center mb-4">Filter by Zones</h3>
      <div class="grid grid-cols-3 items-center gap-1.5">
        <% ["3", "4", "5", "6", "7", "8", "9", "10"].each do |zone| %>
          <label class="flex items-center gap-2">
            <%= check_box_tag "search[zone][]", zone, params.dig(:search, :zone)&.include?(zone), class: "w-5 h-5", onchange: "this.form.requestSubmit()" %>
            <span class="whitespace-nowrap"><%= zone %></span>
          </label>
        <% end %>
      </div>
    </div>

  </div>
</div>
