<div class="mb-8 bg-white shadow-md rounded-lg p-6">
  <!-- Filter Container with Right-to-Left Alignment -->
  <div class="flex flex-wrap lg:flex-nowrap flex-row-reverse justify-end gap-4">
    
    <!-- Function Filters -->
    <div class="mb-6 w-full sm:w-1/3">
      <h3 class="text-md font-semibold mb-2 text-right">Filter by Functions</h3>
      <div class="flex flex-col items-end space-y-2">
        <% ["Edible", "Medicinal", "Nitrogen Fixer", "Wildlife Attractor", "Mulcher", "Dynamic Accumulator", "Erosion Control", "Ground Cover", "Animal Fodder", "Windbreaker", "Pollinator", "Border Plant", "Pest Management"].each do |plant_function| %>
          <label class="inline-flex items-center gap-2">
            <%= check_box_tag "search[plant_function][]", plant_function, params.dig(:search, :plant_function)&.include?(plant_function), class: "w-5 h-5", onchange: "this.form.requestSubmit()" %>
            <%= plant_function %>
          </label>
        <% end %>
      </div>
    </div>

    <!-- Layer Filters -->
    <div class="mb-6 w-full sm:w-1/3">
      <h3 class="text-md font-semibold mb-2 text-right">Filter by Layers</h3>
      <div class="flex flex-col items-end space-y-2">
        <% ["Canopy", "Sub-canopy", "Shrub", "Herbaceous", "Ground", "Root", "Vine"].each do |layer| %>
          <label class="inline-flex items-center gap-2">
            <%= check_box_tag "search[layers][]", layer, params.dig(:search, :layers)&.include?(layer), class: "w-5 h-5", onchange: "this.form.requestSubmit()" %>
            <%= layer %>
          </label>
        <% end %>
      </div>
    </div>

    <!-- Zone Filters -->
    <div class="mb-6 w-full sm:w-1/3">
      <h3 class="text-md font-semibold mb-2 text-right">Filter by Zones</h3>
      <div class="flex flex-col items-end space-y-2">
        <% ["3", "4", "5", "6", "7", "8", "9", "10"].each do |zone| %>
          <label class="inline-flex items-center gap-2">
            <%= check_box_tag "search[zone][]", zone, params.dig(:search, :zone)&.include?(zone), class: "w-5 h-5", onchange: "this.form.requestSubmit()" %>
            <%= zone %>
          </label>
        <% end %>
      </div>
    </div>

  </div>
</div>
