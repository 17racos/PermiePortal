<div class="max-w-6xl mx-auto p-6">
  <div class="bg-white rounded-lg shadow-xl border border-green-200">
    <!-- Enhanced Header -->
    <div class="bg-gradient-to-r from-green-600 to-emerald-600 text-white p-6 rounded-t-lg">
      <div class="flex items-center justify-between">
        <div>
          <h1 class="text-3xl font-bold flex items-center">
            🌱 Chat with PermieBro
            <span id="ai-status-indicator" class="ml-3 w-3 h-3 bg-green-400 rounded-full animate-pulse"></span>
          </h1>
          <p class="text-green-100 mt-2">Your enthusiastic permaculture expert and plant companion! Ask me anything about plants, gardening, and sustainable living.</p>
        </div>
        <div class="text-right">
          <div class="text-sm text-green-100">
            <div>Model: <span id="current-model" class="font-semibold">Loading...</span></div>
            <div>Status: <span id="connection-status" class="font-semibold">Checking...</span></div>
          </div>
        </div>
      </div>
    </div>
    
    <div class="p-6">
      <!-- Chat Messages -->
      <div id="chat-messages" class="h-[500px] overflow-y-auto border border-gray-200 rounded-lg p-6 mb-6 bg-gradient-to-b from-gray-50 to-white">
        <div id="welcome-message" class="text-center text-gray-600 py-12">
          <div class="text-6xl mb-4">🌿</div>
          <h3 class="text-xl font-semibold text-green-800 mb-2">Welcome to your plant companion!</h3>
          <p class="text-lg mb-4">I'm PermieBro, and I'm excited to help you with all things plants and permaculture!</p>
          <div class="max-w-lg mx-auto text-left">
            <p class="text-sm text-gray-600 mb-4"><strong>I can help you with:</strong></p>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-2 text-sm">
              <div class="flex items-center space-x-2">
                <span class="text-green-600">🤝</span>
                <span>Companion planting advice</span>
              </div>
              <div class="flex items-center space-x-2">
                <span class="text-blue-600">🏜️</span>
                <span>Climate-specific recommendations</span>
              </div>
              <div class="flex items-center space-x-2">
                <span class="text-purple-600">🌱</span>
                <span>Plant identification & care</span>
              </div>
              <div class="flex items-center space-x-2">
                <span class="text-orange-600">🐛</span>
                <span>Pest & disease management</span>
              </div>
              <div class="flex items-center space-x-2">
                <span class="text-yellow-600">🎨</span>
                <span>Garden design & planning</span>
              </div>
              <div class="flex items-center space-x-2">
                <span class="text-pink-600">🌍</span>
                <span>Permaculture principles</span>
              </div>
            </div>
          </div>
          <p class="text-sm mt-6 text-gray-500">Ask me anything! I love chatting about plants and helping gardeners succeed.</p>
        </div>
        
        <!-- Typing Indicator -->
        <div id="typing-indicator" class="hidden mb-4 text-left">
          <div class="inline-block max-w-xs px-4 py-3 rounded-lg bg-gray-100 border">
            <div class="flex items-center space-x-2">
              <span class="text-lg">🌿</span>
              <div class="flex space-x-1">
                <div class="w-2 h-2 bg-green-500 rounded-full animate-bounce"></div>
                <div class="w-2 h-2 bg-green-500 rounded-full animate-bounce" style="animation-delay: 0.1s"></div>
                <div class="w-2 h-2 bg-green-500 rounded-full animate-bounce" style="animation-delay: 0.2s"></div>
              </div>
              <span class="text-sm text-gray-600">PermieBro is thinking...</span>
            </div>
          </div>
        </div>
      </div>
      
      <!-- Enhanced Input Area -->
      <div class="space-y-4">
        <!-- Input Form -->
        <div class="flex gap-3">
          <div class="flex-1 relative">
            <textarea 
              id="user-input" 
              placeholder="Ask me anything about plants, gardening, permaculture... I'm here to help! 🌱"
              class="w-full px-4 py-3 pr-12 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-green-500 focus:border-green-500 resize-none transition-all duration-200 text-lg"
              rows="1"
              onkeydown="handleKeyPress(event)"
              oninput="autoResize(this)"
            ></textarea>
            <div class="absolute bottom-2 right-2 text-xs text-gray-400">
              <span id="char-count">0</span>/2000
            </div>
          </div>
          <button 
            id="send-button"
            onclick="sendMessage()" 
            class="px-6 py-3 bg-gradient-to-r from-green-600 to-emerald-600 text-white rounded-xl hover:from-green-700 hover:to-emerald-700 transition-all duration-200 flex items-center space-x-2 shadow-lg hover:shadow-xl"
          >
            <span>Send</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/>
            </svg>
          </button>
        </div>
        
        <!-- Conversation Context -->
        <div id="conversation-context" class="hidden p-3 bg-blue-50 border border-blue-200 rounded-lg">
          <div class="flex items-center justify-between">
            <div class="flex items-center space-x-2">
              <span class="text-blue-600">🧠</span>
              <span class="text-sm font-medium text-blue-800">Conversation Context Active</span>
            </div>
            <button onclick="clearContext()" class="text-xs text-blue-600 hover:text-blue-800">Clear</button>
          </div>
          <div id="context-summary" class="text-xs text-blue-700 mt-1"></div>
        </div>
        
        <!-- Status & Controls -->
        <div class="flex items-center justify-between text-sm">
          <div class="flex items-center space-x-4">
            <div id="message-count" class="text-gray-600">
              Messages: <span class="font-semibold">0</span>
            </div>
            <div id="model-info" class="text-gray-600">
              <span class="hidden" id="token-count">Tokens: <span class="font-semibold">0</span></span>
            </div>
          </div>
          
          <div class="flex items-center space-x-2">
            <button onclick="exportConversation()" class="px-3 py-1 text-gray-600 hover:text-gray-800 transition-colors">
              Export Chat
            </button>
            <button onclick="clearConversation()" class="px-3 py-1 text-red-600 hover:text-red-800 transition-colors">
              Clear Chat
            </button>
            <button onclick="showSettings()" class="px-3 py-1 text-blue-600 hover:text-blue-800 transition-colors">
              Settings
            </button>
          </div>
        </div>

        <!-- Quick Examples -->
        <div class="mt-6">
          <p class="text-sm font-medium text-gray-700 mb-3">💡 Try these conversation starters:</p>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-2">
            <button onclick="askExample('Hi PermieBro! I\'m planning a new garden in zone 8. What are some must-have plants?')" 
                    class="text-left px-4 py-3 bg-gradient-to-r from-green-100 to-green-200 text-green-800 rounded-lg hover:from-green-200 hover:to-green-300 transition-all duration-200 text-sm">
              <div class="font-medium">🌱 Garden Planning</div>
              <div class="text-xs mt-1">"I'm planning a new garden in zone 8..."</div>
            </button>
            <button onclick="askExample('My tomatoes have yellow leaves and black spots. Can you help me diagnose the problem?')" 
                    class="text-left px-4 py-3 bg-gradient-to-r from-orange-100 to-orange-200 text-orange-800 rounded-lg hover:from-orange-200 hover:to-orange-300 transition-all duration-200 text-sm">
              <div class="font-medium">🩺 Plant Problems</div>
              <div class="text-xs mt-1">"My tomatoes have yellow leaves..."</div>
            </button>
            <button onclick="askExample('I want to create a pollinator garden that attracts bees and butterflies. What plants work best together?')" 
                    class="text-left px-4 py-3 bg-gradient-to-r from-yellow-100 to-yellow-200 text-yellow-800 rounded-lg hover:from-yellow-200 hover:to-yellow-300 transition-all duration-200 text-sm">
              <div class="font-medium">🐝 Pollinator Gardens</div>
              <div class="text-xs mt-1">"I want to create a pollinator garden..."</div>
            </button>
            <button onclick="askExample('Can you explain permaculture zones and how to design a food forest?')" 
                    class="text-left px-4 py-3 bg-gradient-to-r from-purple-100 to-purple-200 text-purple-800 rounded-lg hover:from-purple-200 hover:to-purple-300 transition-all duration-200 text-sm">
              <div class="font-medium">🌳 Permaculture Design</div>
              <div class="text-xs mt-1">"Can you explain permaculture zones..."</div>
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Settings Modal -->
<div id="settings-modal" class="hidden fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50">
  <div class="bg-white rounded-lg p-6 max-w-md w-full mx-4">
    <h3 class="text-lg font-semibold mb-4">Chat Settings</h3>
    <div class="space-y-4">
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-2">Response Length</label>
        <select id="response-length" class="w-full px-3 py-2 border border-gray-300 rounded-md">
          <option value="short">Short & Concise</option>
          <option value="medium" selected>Detailed</option>
          <option value="long">Comprehensive</option>
        </select>
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-2">Communication Style</label>
        <select id="communication-style" class="w-full px-3 py-2 border border-gray-300 rounded-md">
          <option value="casual" selected>Friendly & Casual</option>
          <option value="professional">Professional</option>
          <option value="enthusiastic">Very Enthusiastic</option>
        </select>
      </div>
      <div class="flex items-center">
        <input type="checkbox" id="auto-context" checked class="mr-2">
        <label for="auto-context" class="text-sm text-gray-700">Remember conversation context</label>
      </div>
    </div>
    <div class="mt-6 flex justify-end space-x-2">
      <button onclick="closeSettings()" class="px-4 py-2 text-gray-600 hover:text-gray-800">Cancel</button>
      <button onclick="saveSettings()" class="px-4 py-2 bg-green-600 text-white rounded hover:bg-green-700">Save</button>
    </div>
  </div>
</div>

<script>
let chatHistory = [];
let messageCount = 0;
let totalTokens = 0;
let conversationContext = {};
let sessionId = Date.now().toString();

// Initialize on page load
document.addEventListener('DOMContentLoaded', async () => {
  await checkAIStatus();
  loadSettings();
  focusInput();
});

async function checkAIStatus() {
  try {
    const response = await fetch('/api/v1/gpt/status');
    const data = await response.json();
    
    const statusIndicator = document.getElementById('ai-status-indicator');
    const currentModel = document.getElementById('current-model');
    const connectionStatus = document.getElementById('connection-status');
    
    if (data.success && data.data.llm_available) {
      statusIndicator.className = 'ml-3 w-3 h-3 bg-green-400 rounded-full';
      currentModel.textContent = data.data.model || 'llama3.1:8b';
      connectionStatus.textContent = 'Online';
      connectionStatus.className = 'font-semibold text-green-200';
    } else {
      statusIndicator.className = 'ml-3 w-3 h-3 bg-yellow-400 rounded-full animate-pulse';
      currentModel.textContent = 'Fallback Mode';
      connectionStatus.textContent = 'Limited';
      connectionStatus.className = 'font-semibold text-yellow-200';
    }
  } catch (error) {
    const statusIndicator = document.getElementById('ai-status-indicator');
    const connectionStatus = document.getElementById('connection-status');
    
    statusIndicator.className = 'ml-3 w-3 h-3 bg-red-400 rounded-full';
    connectionStatus.textContent = 'Error';
    connectionStatus.className = 'font-semibold text-red-200';
  }
}

async function sendMessage() {
  const input = document.getElementById('user-input');
  let message = input.value.trim();
  
  if (!message) return;
  
  // Clear input and hide welcome
  input.value = '';
  hideWelcomeMessage();
  
  // Add user message
  addMessage('user', message);
  showTypingIndicator();
  
  // Update UI state
  const sendButton = document.getElementById('send-button');
  sendButton.disabled = true;
  sendButton.innerHTML = '<span>Sending...</span>';
  
  try {
    // Enhanced context for better conversations
    const context = {
      session_id: sessionId,
      message_count: messageCount,
      conversation_context: conversationContext,
      user_preferences: getUserPreferences()
    };
    
    const response = await fetch('/api/v1/gpt/chat', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content
      },
      body: JSON.stringify({ 
        messages: chatHistory,
        context: context
      })
    });
    
    const data = await response.json();
    
    hideTypingIndicator();
    
    if (data.success) {
      addMessage('assistant', data.data.response);
      updateStats(data.data.usage);
      updateConversationContext(message, data.data.response);
    } else {
      addMessage('assistant', 'I apologize, but I\'m having trouble processing your request right now. Could you try rephrasing your question? I\'m here to help with anything about plants and gardening! 🌱');
    }
  } catch (error) {
    console.error('Error:', error);
    hideTypingIndicator();
    addMessage('assistant', 'Oops! I seem to be having a connection issue. Let me try to help you anyway - what specific plant or gardening question do you have? 🌿');
  } finally {
    // Reset send button
    sendButton.disabled = false;
    sendButton.innerHTML = '<span>Send</span><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/></svg>';
    
    focusInput();
    autoResize(input);
  }
}

function addMessage(role, content) {
  const messagesDiv = document.getElementById('chat-messages');
  
  hideWelcomeMessage();
  
  const messageDiv = document.createElement('div');
  messageDiv.className = `mb-6 ${role === 'user' ? 'text-right' : 'text-left'} animate-fadeIn`;
  
  const timestamp = new Date().toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'});
  
  if (role === 'user') {
    messageDiv.innerHTML = `
      <div class="inline-block max-w-lg">
        <div class="bg-gradient-to-r from-green-600 to-emerald-600 text-white px-4 py-3 rounded-lg shadow-md">
          <div class="whitespace-pre-wrap">${escapeHtml(content)}</div>
        </div>
        <div class="text-xs text-gray-500 mt-1">${timestamp}</div>
      </div>
    `;
  } else {
    messageDiv.innerHTML = `
      <div class="inline-block max-w-2xl">
        <div class="bg-white border border-gray-200 px-4 py-3 rounded-lg shadow-md">
          <div class="flex items-start space-x-3">
            <span class="text-2xl flex-shrink-0">🌿</span>
            <div class="flex-1">
              <div class="font-medium text-green-800 text-sm mb-1">PermieBro</div>
              <div class="whitespace-pre-wrap text-gray-800">${formatResponseText(content)}</div>
            </div>
          </div>
        </div>
        <div class="text-xs text-gray-500 mt-1">${timestamp}</div>
      </div>
    `;
  }
  
  messagesDiv.appendChild(messageDiv);
  scrollToBottom();
  
  // Update chat history and stats
  chatHistory.push({ role, content });
  messageCount++;
  document.getElementById('message-count').innerHTML = `Messages: <span class="font-semibold">${messageCount}</span>`;
}

function formatResponseText(text) {
  // Enhanced text formatting for better readability
  let formatted = escapeHtml(text);
  
  // Convert markdown-style formatting
  formatted = formatted.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>');
  formatted = formatted.replace(/\*(.*?)\*/g, '<em>$1</em>');
  formatted = formatted.replace(/`(.*?)`/g, '<code class="bg-gray-100 px-1 rounded">$1</code>');
  
  // Convert bullet points
  formatted = formatted.replace(/^- (.+)$/gm, '• $1');
  formatted = formatted.replace(/^\* (.+)$/gm, '• $1');
  
  // Add line breaks for better paragraph spacing
  formatted = formatted.replace(/\n\n/g, '</p><p class="mt-3">');
  formatted = '<p>' + formatted + '</p>';
  
  return formatted;
}

function showTypingIndicator() {
  document.getElementById('typing-indicator').classList.remove('hidden');
  scrollToBottom();
}

function hideTypingIndicator() {
  document.getElementById('typing-indicator').classList.add('hidden');
}

function hideWelcomeMessage() {
  const welcome = document.getElementById('welcome-message');
  if (welcome && !welcome.classList.contains('hidden')) {
    welcome.classList.add('hidden');
  }
}

function updateStats(usage) {
  if (usage && usage.total_tokens) {
    totalTokens += usage.total_tokens;
    const tokenCount = document.getElementById('token-count');
    tokenCount.classList.remove('hidden');
    tokenCount.innerHTML = `Tokens: <span class="font-semibold">${totalTokens}</span>`;
  }
}

function updateConversationContext(userMessage, assistantResponse) {
  // Extract key topics and context for better conversations
  const topics = extractTopics(userMessage + ' ' + assistantResponse);
  conversationContext.topics = [...(conversationContext.topics || []), ...topics].slice(-10);
  conversationContext.lastPlants = extractPlantNames(assistantResponse);
  
  if (Object.keys(conversationContext).length > 0) {
    showConversationContext();
  }
}

function extractTopics(text) {
  const commonTopics = ['companion planting', 'permaculture', 'soil', 'water', 'pest', 'disease', 'harvest', 'plant', 'garden', 'zone'];
  return commonTopics.filter(topic => text.toLowerCase().includes(topic));
}

function extractPlantNames(text) {
  // Simple plant name extraction - could be enhanced with NLP
  const plantWords = text.match(/\b[A-Z][a-z]+(?:\s[A-Z][a-z]+)?\b/g) || [];
  return plantWords.slice(0, 5); // Keep recent plants
}

function showConversationContext() {
  const contextDiv = document.getElementById('conversation-context');
  const summaryDiv = document.getElementById('context-summary');
  
  const topics = conversationContext.topics?.slice(-3).join(', ') || '';
  const plants = conversationContext.lastPlants?.slice(0, 3).join(', ') || '';
  
  let summary = '';
  if (topics) summary += `Topics: ${topics}`;
  if (plants) summary += (summary ? ' | ' : '') + `Plants: ${plants}`;
  
  if (summary) {
    summaryDiv.textContent = summary;
    contextDiv.classList.remove('hidden');
  }
}

function clearContext() {
  conversationContext = {};
  document.getElementById('conversation-context').classList.add('hidden');
}

// UI Helper Functions
function handleKeyPress(event) {
  updateCharCount();
  
  if (event.key === 'Enter') {
    if (event.shiftKey) {
      // Allow new line with Shift+Enter
      return;
    } else {
      event.preventDefault();
      sendMessage();
    }
  }
}

function autoResize(element) {
  element.style.height = 'auto';
  element.style.height = Math.min(element.scrollHeight, 120) + 'px';
}

function updateCharCount() {
  const input = document.getElementById('user-input');
  const count = document.getElementById('char-count');
  count.textContent = input.value.length;
  
  if (input.value.length > 1800) {
    count.className = 'text-red-500 font-semibold';
  } else if (input.value.length > 1500) {
    count.className = 'text-yellow-500';
  } else {
    count.className = 'text-gray-400';
  }
}

function focusInput() {
  document.getElementById('user-input').focus();
}

function scrollToBottom() {
  const messagesDiv = document.getElementById('chat-messages');
  messagesDiv.scrollTop = messagesDiv.scrollHeight;
}

function escapeHtml(text) {
  const div = document.createElement('div');
  div.textContent = text;
  return div.innerHTML;
}

// Additional Features
function askExample(question) {
  document.getElementById('user-input').value = question;
  autoResize(document.getElementById('user-input'));
  updateCharCount();
  focusInput();
}

function clearConversation() {
  if (confirm('Are you sure you want to clear the conversation?')) {
    chatHistory = [];
    messageCount = 0;
    totalTokens = 0;
    conversationContext = {};
    
    const messagesDiv = document.getElementById('chat-messages');
    messagesDiv.innerHTML = `
      <div id="welcome-message" class="text-center text-gray-600 py-12">
        <div class="text-6xl mb-4">🌿</div>
        <h3 class="text-xl font-semibold text-green-800 mb-2">Welcome back!</h3>
        <p class="text-lg">Ready for another great gardening conversation?</p>
      </div>
    `;
    
    document.getElementById('message-count').innerHTML = 'Messages: <span class="font-semibold">0</span>';
    document.getElementById('token-count').classList.add('hidden');
    document.getElementById('conversation-context').classList.add('hidden');
  }
}

function exportConversation() {
  if (chatHistory.length === 0) {
    alert('No conversation to export!');
    return;
  }
  
  const conversation = chatHistory.map(msg => `${msg.role === 'user' ? 'You' : 'PermieBro'}: ${msg.content}`).join('\n\n');
  const blob = new Blob([conversation], { type: 'text/plain' });
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url;
  a.download = `permie-chat-${new Date().toISOString().split('T')[0]}.txt`;
  a.click();
  URL.revokeObjectURL(url);
}

// Settings Functions
function showSettings() {
  document.getElementById('settings-modal').classList.remove('hidden');
}

function closeSettings() {
  document.getElementById('settings-modal').classList.add('hidden');
}

function saveSettings() {
  const settings = {
    responseLength: document.getElementById('response-length').value,
    communicationStyle: document.getElementById('communication-style').value,
    autoContext: document.getElementById('auto-context').checked
  };
  
  localStorage.setItem('permieBroSettings', JSON.stringify(settings));
  closeSettings();
}

function loadSettings() {
  const settings = JSON.parse(localStorage.getItem('permieBroSettings') || '{}');
  
  if (settings.responseLength) {
    document.getElementById('response-length').value = settings.responseLength;
  }
  if (settings.communicationStyle) {
    document.getElementById('communication-style').value = settings.communicationStyle;
  }
  if (settings.autoContext !== undefined) {
    document.getElementById('auto-context').checked = settings.autoContext;
  }
}

function getUserPreferences() {
  const settings = JSON.parse(localStorage.getItem('permieBroSettings') || '{}');
  return {
    response_length: settings.responseLength || 'medium',
    communication_style: settings.communicationStyle || 'casual',
    auto_context: settings.autoContext !== false
  };
}
</script>

<style>
.animate-fadeIn {
  animation: fadeIn 0.3s ease-in;
}

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(10px); }
  to { opacity: 1; transform: translateY(0); }
}

#chat-messages {
  scroll-behavior: smooth;
}

#user-input:focus {
  outline: none;
  box-shadow: 0 0 0 3px rgba(34, 197, 94, 0.1);
}

.animate-bounce {
  animation: bounce 1.4s infinite;
}

@keyframes bounce {
  0%, 80%, 100% { transform: translateY(0); }
  40% { transform: translateY(-6px); }
}
</style> 