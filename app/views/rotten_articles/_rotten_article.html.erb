<div id="<%= dom_id rotten_article %>">
  <p>
    <strong>Title:</strong>
    <%= rotten_article.title %>
  </p>

  <p>
    <strong>Slug:</strong>
    <%= rotten_article.slug %>
  </p>

  <p>
    <strong>Content:</strong>
    <%= rotten_article.content %>
  </p>

  <p>
    <strong>Tags:</strong>
    <%= rotten_article.tags %>
  </p>

  <p>
    <strong>Published:</strong>
    <%= rotten_article.published %>
  </p>

  <p>
    <strong>Author:</strong>
    <%= rotten_article.author %>
  </p>

</div>
