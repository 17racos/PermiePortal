<div id="rotten_article" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
  <% @rotten_articles.each do |rotten_article| %>  <!-- Correctly iterate over the plural variable -->
    <div class="bg-white shadow-md rounded-lg hover:shadow-lg transition overflow-hidden">
      <div class="flex flex-col h-full">
        <h2><%= link_to rotten_article.title, rotten_article_path(rotten_article.slug) %></h2>
        <p><%= truncate(rotten_article.body, length: 150) %></p>
        <% if rotten_article.image.present? %>
          <%= image_tag "/images/#{rotten_article.image}" %>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
