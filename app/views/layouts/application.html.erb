<!DOCTYPE html>
<html lang="en">
  <head>
    <title>PermiePortal | Your Hub for Permaculture Knowledge</title>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <!-- Make sure JavaScript and CSS is properly loaded -->
    <%= stylesheet_link_tag "tailwind", "inter-font", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="PermiePortal: Your central resource for permaculture education and community networking.">
  </head>
  
  <body class="bg-green-50 font-sans text-gray-800">
    <div class="min-h-screen flex flex-col">

      <!-- Header Section -->
      <header class="bg-gradient-to-r from-green-600 to-green-700 text-white py-4">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex justify-between items-center">
          <!-- Logo -->
          <h1 class="text-2xl font-bold">
            <%= link_to 'PermiePortal', root_path, class: "text-white hover:text-green-100 transition-colors" %>
          </h1>

          <!-- Navigation -->
          <nav class="text-sm">
            <% if user_signed_in? %>
              <span class="text-green-100">Welcome, <%= current_user.email %>!</span>
              <%= link_to 'Logout', destroy_user_session_path, method: :delete, class: "ml-4 text-white hover:text-green-100 transition-colors" %>
            <% else %>
              <!-- <%= link_to 'Login', new_user_session_path, class: "text-white hover:text-green-100 transition-colors mr-4" %>
              <%= link_to 'Sign Up', new_user_registration_path, class: "text-white hover:text-green-100 transition-colors" %>
              -->
            <% end %>
          </nav>
        </div>
      </header>

      <!-- Main Content -->
      <main class="flex-grow max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
        <div class="min-h-screen">
          <%= yield %>
        </div>
      </main>

      <!-- Footer -->
      <footer class="bg-gray-800 text-white py-6">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
          <p class="text-sm text-gray-400">
            &copy; <%= Time.current.year %> PermiePortal. All rights reserved.
          </p>
        </div>
      </footer>

    </div>
  </body>
</html>
