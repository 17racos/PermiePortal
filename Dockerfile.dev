# Use official Ruby image
FROM ruby:3.2.2-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update -qq && apt-get install -y \
    build-essential \
    libpq-dev \
    curl \
    git \
    nodejs \
    npm

# Install Node.js 18 and npm 10
RUN curl -fsSL https://deb.nodesource.com/setup_18.x | bash - && \
    apt-get install -y nodejs && \
    npm install -g npm@10 yarn

# Verify Node.js, npm, and Yarn versions
RUN node -v && npm -v && yarn -v

# Copy package files
COPY package.json yarn.lock ./

# Install JavaScript dependencies
RUN yarn install --check-files

# Copy application code
COPY . .

# Install Gems
RUN bundle install --jobs=4 --retry=3

# Build Tailwind CSS
RUN yarn build:css

# Expose port 3000 for Rails development
EXPOSE 3000

# Start the Rails application with Tailwind CSS watcher
CMD ["bash", "-c", "rm -f tmp/pids/server.pid && yarn watch:css & bundle exec rails server -b 0.0.0.0"]
