---
// src/pages/articles/[slug].astro
import BaseLayout from '../../components/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { entrySlug } from '../../lib/content';

export async function getStaticPaths() {
  const all = await getCollection('articles');
  return all.map((e) => ({ params: { slug: entrySlug(e) }, props: { entry: e } }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
const data = entry.data;

const formattedDate = new Date(data.date).toLocaleDateString('en-US', {
  year: 'numeric', month: 'long', day: 'numeric'
});
---

<BaseLayout title={data.title}>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Instrument+Serif:ital@0;1&family=Space+Mono:ital,wght@0,400;0,700;1,400&display=swap');

  :root {
    --soil: #0f0d0a; --bark: #1c1812; --moss: #2a3d1f;
    --leaf: #4a7c35; --lime: #8fb83a; --straw: #d4a843;
    --ash: #b8b0a0; --paper: #ede8dc; --rot: #7a3b1e; --rust: #c4551a;
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }
  body {
    background: var(--soil); color: var(--paper);
    font-family: 'Instrument Serif', Georgia, serif;
  }

  .nav {
    display: flex; justify-content: space-between; align-items: center;
    padding: 1.5rem 2rem;
    border-bottom: 1px solid rgba(139,184,58,0.2);
  }
  .nav-logo {
    font-family: 'Bebas Neue', sans-serif; font-size: 1.8rem;
    letter-spacing: 0.08em; color: var(--lime); text-decoration: none;
  }
  .nav-links { display: flex; gap: 2rem; list-style: none; }
  .nav-links a {
    font-family: 'Space Mono', monospace; font-size: 0.72rem;
    text-transform: uppercase; letter-spacing: 0.12em;
    color: var(--ash); text-decoration: none; transition: color 0.2s;
  }
  .nav-links a:hover { color: var(--lime); }

  .breadcrumb {
    padding: 1rem 2rem;
    font-family: 'Space Mono', monospace; font-size: 0.65rem;
    letter-spacing: 0.1em; text-transform: uppercase;
    color: var(--ash); border-bottom: 1px solid rgba(139,184,58,0.1);
  }
  .breadcrumb a { color: var(--lime); text-decoration: none; }
  .breadcrumb a:hover { text-decoration: underline; }

  /* ARTICLE HEADER */
  .article-header {
    max-width: 760px;
    margin: 0 auto;
    padding: 3rem 2rem 2rem;
    border-bottom: 1px solid rgba(139,184,58,0.1);
  }

  .article-eyebrow {
    font-family: 'Space Mono', monospace; font-size: 0.65rem;
    letter-spacing: 0.2em; text-transform: uppercase;
    color: var(--straw); margin-bottom: 1rem;
    display: flex; align-items: center; gap: 0.75rem;
  }
  .article-eyebrow::before { content: ''; width: 2rem; height: 1px; background: var(--straw); }

  .article-title {
    font-family: 'Bebas Neue', sans-serif;
    font-size: clamp(2.5rem, 6vw, 5rem);
    line-height: 0.95; letter-spacing: 0.02em;
    color: var(--paper); margin-bottom: 1.25rem;
  }

  .article-summary {
    font-size: 1.15rem; line-height: 1.65;
    color: var(--ash); font-style: italic;
    margin-bottom: 1.5rem;
    border-left: 2px solid var(--lime);
    padding-left: 1rem;
  }

  .article-meta {
    display: flex; align-items: center; gap: 1.5rem;
    flex-wrap: wrap;
  }

  .article-date {
    font-family: 'Space Mono', monospace; font-size: 0.68rem;
    letter-spacing: 0.1em; text-transform: uppercase;
    color: var(--ash);
  }

  .article-tags {
    display: flex; gap: 0.4rem; flex-wrap: wrap;
  }

  .article-tag {
    font-family: 'Space Mono', monospace; font-size: 0.6rem;
    letter-spacing: 0.08em; text-transform: uppercase;
    padding: 0.2rem 0.6rem;
    background: rgba(42,61,31,0.5);
    border: 1px solid rgba(74,124,53,0.35);
    color: var(--lime);
  }

  .article-tag.satire {
    background: rgba(122,59,30,0.3);
    border-color: rgba(196,85,26,0.4);
    color: var(--straw);
  }

  /* ARTICLE PROSE */
  .article-body {
    max-width: 760px;
    margin: 0 auto;
    padding: 3rem 2rem 4rem;
  }

  /* Prose styles — scoped to article-body */
  .article-body :global(p) {
    font-size: 1.1rem;
    line-height: 1.85;
    color: var(--ash);
    margin-bottom: 1.5rem;
  }

  .article-body :global(h2) {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 2rem; letter-spacing: 0.03em;
    color: var(--paper); margin: 3rem 0 1rem;
    border-bottom: 1px solid rgba(139,184,58,0.15);
    padding-bottom: 0.5rem;
  }

  .article-body :global(h3) {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 1.4rem; letter-spacing: 0.03em;
    color: var(--paper); margin: 2rem 0 0.75rem;
  }

  .article-body :global(strong) {
    color: var(--paper); font-weight: 600;
  }

  .article-body :global(em) {
    color: var(--paper); font-style: italic;
  }

  .article-body :global(a) {
    color: var(--lime); text-decoration: underline;
    text-underline-offset: 3px;
  }
  .article-body :global(a:hover) { color: var(--paper); }

  .article-body :global(ul),
  .article-body :global(ol) {
    padding-left: 1.5rem;
    margin-bottom: 1.5rem;
  }

  .article-body :global(li) {
    font-size: 1.05rem; line-height: 1.75;
    color: var(--ash); margin-bottom: 0.4rem;
  }

  .article-body :global(blockquote) {
    border-left: 3px solid var(--lime);
    margin: 2rem 0;
    padding: 1rem 1.5rem;
    background: rgba(42,61,31,0.2);
  }

  .article-body :global(blockquote p) {
    font-style: italic;
    color: var(--paper);
    margin-bottom: 0;
  }

  .article-body :global(hr) {
    border: none;
    border-top: 1px solid rgba(139,184,58,0.2);
    margin: 3rem 0;
  }

  .article-body :global(img) {
    width: 100%;
    height: auto;
    display: block;
    margin: 2rem 0;
    border: 1px solid rgba(139,184,58,0.15);
    opacity: 0.9;
  }

  .article-body :global(code) {
    font-family: 'Space Mono', monospace;
    font-size: 0.85em;
    background: rgba(42,61,31,0.4);
    padding: 0.15em 0.4em;
    color: var(--lime);
  }

  .article-body :global(pre) {
    background: var(--bark);
    border: 1px solid rgba(139,184,58,0.15);
    padding: 1.5rem;
    overflow-x: auto;
    margin-bottom: 1.5rem;
  }

  .article-body :global(pre code) {
    background: none;
    padding: 0;
    font-size: 0.85rem;
    color: var(--lime);
  }

  /* Back link */
  .back-link {
    display: inline-flex; align-items: center; gap: 0.5rem;
    font-family: 'Space Mono', monospace; font-size: 0.7rem;
    letter-spacing: 0.1em; text-transform: uppercase;
    color: var(--lime); text-decoration: none;
    padding: 2rem 2rem 0;
    transition: gap 0.2s; max-width: 760px; margin: 0 auto; display: block;
  }
  .back-link:hover { gap: 0.75rem; }

  .footer {
    padding: 2rem 4rem;
    border-top: 1px solid rgba(139,184,58,0.15);
    display: flex; justify-content: space-between; align-items: center;
    margin-top: 2rem;
  }
  .footer-logo {
    font-family: 'Bebas Neue', sans-serif; font-size: 1.2rem;
    color: var(--lime); letter-spacing: 0.08em;
  }
  .footer-copy {
    font-family: 'Space Mono', monospace; font-size: 0.65rem; color: var(--ash);
  }

  @media (max-width: 768px) {
    .nav-links { gap: 1rem; }
    .article-header, .article-body { padding-left: 1.25rem; padding-right: 1.25rem; }
    .footer { flex-direction: column; gap: 1rem; padding: 2rem 1.5rem; }
  }
</style>

<nav class="nav">
  <a href="/" class="nav-logo">PermiePortal</a>
  <ul class="nav-links">
    <li><a href="/plants">Plants</a></li>
    <li><a href="/pests">Pests</a></li>
    <li><a href="/articles">Articles</a></li>
    <li><a href="/projects">Projects</a></li>
    <li><a href="/about">About</a></li>
  </ul>
</nav>

<div class="breadcrumb">
  <a href="/articles">← Articles</a> / {data.title}
</div>

<div class="article-header">
  <p class="article-eyebrow">Field Notes</p>
  <h1 class="article-title">{data.title}</h1>
  {data.summary && (
    <p class="article-summary">{data.summary}</p>
  )}
  <div class="article-meta">
    <span class="article-date">{formattedDate}</span>
    {data.tags && data.tags.length > 0 && (
      <div class="article-tags">
        {data.tags.map((tag: string) => (
          <span class={`article-tag ${tag === 'satire' ? 'satire' : ''}`}>{tag}</span>
        ))}
      </div>
    )}
  </div>
</div>

<div class="article-body" id="main">
  <Content />
</div>

<footer class="footer">
  <div class="footer-logo">PermiePortal</div>
  <div class="footer-copy">© {new Date().getFullYear()} — Built in a food forest in Yulee, FL</div>
</footer>

</BaseLayout>
