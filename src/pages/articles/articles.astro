---
// src/pages/articles.astro
import BaseLayout from '../components/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { entrySlug } from '../lib/content';

const PAGE_SIZE = 12;
const entries = (await getCollection('articles'))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const totalPages = Math.max(1, Math.ceil(entries.length / PAGE_SIZE));
const currentPage = Math.min(
  Math.max(parseInt(Astro.url.searchParams.get('page') || '1', 10), 1),
  totalPages
);
const start = (currentPage - 1) * PAGE_SIZE;
const pageItems = entries.slice(start, start + PAGE_SIZE);
---

<BaseLayout title="Articles">
<style>
  @import url('https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Instrument+Serif:ital@0;1&family=Space+Mono:ital,wght@0,400;0,700;1,400&display=swap');

  :root {
    --soil: #0f0d0a; --bark: #1c1812; --moss: #2a3d1f;
    --leaf: #4a7c35; --lime: #8fb83a; --straw: #d4a843;
    --ash: #b8b0a0; --paper: #ede8dc; --rot: #7a3b1e; --rust: #c4551a;
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }
  body {
    background: var(--soil); color: var(--paper);
    font-family: 'Instrument Serif', Georgia, serif;
    min-height: 100vh;
  }

  .nav {
    display: flex; justify-content: space-between; align-items: center;
    padding: 1.5rem 2rem;
    border-bottom: 1px solid rgba(139,184,58,0.2);
  }
  .nav-logo {
    font-family: 'Bebas Neue', sans-serif; font-size: 1.8rem;
    letter-spacing: 0.08em; color: var(--lime); text-decoration: none;
  }
  .nav-links { display: flex; gap: 2rem; list-style: none; }
  .nav-links a {
    font-family: 'Space Mono', monospace; font-size: 0.72rem;
    text-transform: uppercase; letter-spacing: 0.12em;
    color: var(--ash); text-decoration: none; transition: color 0.2s;
  }
  .nav-links a:hover, .nav-links a[aria-current] { color: var(--lime); }

  .page-header {
    padding: 3rem 2rem 2rem;
    border-bottom: 1px solid rgba(139,184,58,0.15);
    display: grid; grid-template-columns: 1fr auto;
    align-items: end; gap: 2rem;
  }

  .page-eyebrow {
    font-family: 'Space Mono', monospace; font-size: 0.65rem;
    letter-spacing: 0.2em; text-transform: uppercase;
    color: var(--lime); margin-bottom: 0.75rem;
    display: flex; align-items: center; gap: 0.75rem;
  }
  .page-eyebrow::before { content: ''; width: 2rem; height: 1px; background: var(--lime); }

  .page-title {
    font-family: 'Bebas Neue', sans-serif;
    font-size: clamp(3rem, 6vw, 5rem);
    line-height: 1; letter-spacing: 0.02em; color: var(--paper);
  }

  .page-sub {
    font-style: italic; font-size: 1rem;
    color: var(--ash); margin-top: 0.5rem;
  }

  .page-count {
    font-family: 'Space Mono', monospace; font-size: 0.7rem;
    color: var(--ash); text-align: right;
  }
  .page-count span {
    display: block; font-family: 'Bebas Neue', sans-serif;
    font-size: 3rem; color: var(--lime); line-height: 1;
  }

  .grid-wrap { padding: 2rem; }

  .articles-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1px;
    background: rgba(139,184,58,0.08);
  }

  .article-card {
    background: var(--bark);
    padding: 2rem;
    text-decoration: none;
    display: block;
    transition: background 0.2s;
    position: relative;
    overflow: hidden;
  }

  .article-card::after {
    content: '';
    position: absolute; bottom: 0; left: 0;
    width: 100%; height: 2px; background: var(--lime);
    transform: scaleX(0); transform-origin: left;
    transition: transform 0.25s;
  }

  .article-card:hover { background: rgba(42,61,31,0.4); }
  .article-card:hover::after { transform: scaleX(1); }

  .card-date {
    font-family: 'Space Mono', monospace; font-size: 0.62rem;
    letter-spacing: 0.1em; text-transform: uppercase;
    color: var(--straw); margin-bottom: 0.75rem;
  }

  .card-title {
    font-family: 'Bebas Neue', sans-serif; font-size: 1.6rem;
    letter-spacing: 0.03em; line-height: 1.1;
    color: var(--paper); margin-bottom: 0.75rem;
  }

  .card-summary {
    font-size: 0.95rem; line-height: 1.65;
    color: var(--ash); margin-bottom: 1rem;
  }

  .card-tags {
    display: flex; flex-wrap: wrap; gap: 0.4rem;
  }

  .card-tag {
    font-family: 'Space Mono', monospace; font-size: 0.58rem;
    letter-spacing: 0.08em; text-transform: uppercase;
    padding: 0.2rem 0.6rem;
    background: rgba(42,61,31,0.5);
    border: 1px solid rgba(74,124,53,0.35);
    color: var(--lime);
  }

  .card-tag.satire {
    background: rgba(122,59,30,0.3);
    border-color: rgba(196,85,26,0.4);
    color: var(--straw);
  }

  .pagination {
    display: flex; align-items: center; justify-content: space-between;
    padding: 2rem;
    border-top: 1px solid rgba(139,184,58,0.1);
    font-family: 'Space Mono', monospace; font-size: 0.7rem;
  }

  .page-btn {
    letter-spacing: 0.1em; text-transform: uppercase;
    padding: 0.6rem 1.2rem;
    border: 1px solid rgba(139,184,58,0.25);
    color: var(--lime); text-decoration: none;
    transition: all 0.2s;
  }
  .page-btn:hover { border-color: var(--lime); background: rgba(139,184,58,0.08); }
  .page-btn.disabled { opacity: 0.3; pointer-events: none; }

  .page-info { color: var(--ash); }

  .footer {
    padding: 2rem 4rem;
    border-top: 1px solid rgba(139,184,58,0.15);
    display: flex; justify-content: space-between; align-items: center;
    margin-top: 2rem;
  }
  .footer-logo {
    font-family: 'Bebas Neue', sans-serif; font-size: 1.2rem;
    color: var(--lime); letter-spacing: 0.08em;
  }
  .footer-copy {
    font-family: 'Space Mono', monospace; font-size: 0.65rem; color: var(--ash);
  }

  @media (max-width: 768px) {
    .page-header { grid-template-columns: 1fr; }
    .articles-grid { grid-template-columns: 1fr; }
    .nav-links { gap: 1rem; }
    .footer { flex-direction: column; gap: 1rem; padding: 2rem 1.5rem; }
  }
</style>

<nav class="nav">
  <a href="/" class="nav-logo">PermiePortal</a>
  <ul class="nav-links">
    <li><a href="/plants">Plants</a></li>
    <li><a href="/pests">Pests</a></li>
    <li><a href="/articles" aria-current="true">Articles</a></li>
    <li><a href="/projects">Projects</a></li>
    <li><a href="/about">About</a></li>
  </ul>
</nav>

<div class="page-header">
  <div>
    <p class="page-eyebrow">Satire & Guides</p>
    <h1 class="page-title">Field Notes</h1>
    <p class="page-sub">Dark truths, bad botany jokes, and actual useful information.</p>
  </div>
  <div class="page-count">
    <span>{entries.length}</span>
    articles
  </div>
</div>

<div class="grid-wrap">
  <div class="articles-grid" id="main">
    {pageItems.map((a) => {
      const href = `/articles/${entrySlug(a)}`;
      const isSatire = a.data.tags?.includes('satire');
      return (
        <a href={href} class="article-card">
          <div class="card-date">
            {new Date(a.data.date).toLocaleDateString('en-US', {
              year: 'numeric', month: 'long', day: 'numeric'
            })}
          </div>
          <div class="card-title">{a.data.title}</div>
          <p class="card-summary">{a.data.summary}</p>
          {a.data.tags && a.data.tags.length > 0 && (
            <div class="card-tags">
              {a.data.tags.map((tag: string) => (
                <span class={`card-tag ${tag === 'satire' ? 'satire' : ''}`}>{tag}</span>
              ))}
            </div>
          )}
        </a>
      );
    })}
  </div>
</div>

{totalPages > 1 && (
  <nav class="pagination" aria-label="Pagination">
    <a
      href={`?page=${currentPage - 1}`}
      class={`page-btn ${currentPage === 1 ? 'disabled' : ''}`}
    >← Previous</a>
    <span class="page-info">Page {currentPage} of {totalPages}</span>
    <a
      href={`?page=${currentPage + 1}`}
      class={`page-btn ${currentPage === totalPages ? 'disabled' : ''}`}
    >Next →</a>
  </nav>
)}

<footer class="footer">
  <div class="footer-logo">PermiePortal</div>
  <div class="footer-copy">© {new Date().getFullYear()} — Built in a food forest in Yulee, FL</div>
</footer>

</BaseLayout>
