---
import '../../styles/tailwind.css';
import '../../styles/base.css';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const entries = await getCollection('articles');
  return entries.map((e) => ({ params: { slug: e.slug } }));
}

const { slug } = Astro.params;
const all = await getCollection('articles');
const match = all.find((e) => e.slug === slug);
if (!match) throw new Error('Article not found');
const { Content } = await match.render();
const data = match.data;
---
<header>
  <Navbar />
</header>
<main id="main" class="prose prose-invert max-w-3xl px-4">
  <article>
    <h1 class="!mb-2">{data.title}</h1>
    <p class="text-sm text-secondary">{data.date.toDateString()}</p>
    <div class="mt-6">
      <Content />
    </div>
    <script type="application/ld+json">{JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Article',
      headline: data.title,
      datePublished: data.date.toISOString(),
      author: { '@type': 'Organization', name: 'PermiePortal' },
      url: new URL(Astro.url.pathname, Astro.site).toString()
    })}</script>
  </article>
</main>
<Footer />


