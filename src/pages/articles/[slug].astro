---
import Navbar from '../../components/Navbar.astro';
// src/pages/articles/[slug].astro
import BaseLayout from '../../components/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { entrySlug } from '../../lib/content';

export async function getStaticPaths() {
  const all = await getCollection('articles');
  return all.map((e) => ({ params: { slug: entrySlug(e) }, props: { entry: e } }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
const data = entry.data;

const isSatire = data.tags?.includes('satire');
const dateStr = new Date(data.date).toLocaleDateString('en-US', {
  year: 'numeric', month: 'long', day: 'numeric'
});
---

<BaseLayout
  title={`${data.title} | PermiePortal`}
  description={data.summary}
>
<style>
  :root {
    --soil: #0f0d0a; --bark: #1c1812; --moss: #2a3d1f;
    --leaf: #4a7c35; --lime: #8fb83a; --straw: #d4a843;
    --ash: #b8b0a0; --paper: #ede8dc; --rot: #7a3b1e; --rust: #c4551a;
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }
  body { background: var(--soil); color: var(--paper); font-family: 'Instrument Serif', Georgia, serif; }

  /* BREADCRUMB */
  .breadcrumb { padding: 1rem 2rem; font-family: 'Space Mono', monospace; font-size: 0.65rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--ash); border-bottom: 1px solid rgba(139,184,58,0.1); }
  .breadcrumb a { color: var(--lime); text-decoration: none; }
  .breadcrumb a:hover { text-decoration: underline; }



  /* ARTICLE HEADER */
  .article-header {
    max-width: 800px; margin: 0 auto;
    padding: 3.5rem 2rem 2.5rem;
    border-bottom: 1px solid rgba(139,184,58,0.1);
  }
  .article-eyebrow {
    font-family: 'Space Mono', monospace; font-size: 0.65rem;
    letter-spacing: 0.2em; text-transform: uppercase;
    margin-bottom: 1.5rem; display: flex; align-items: center; gap: 0.75rem;
  }
  .article-eyebrow.rot { color: var(--rust); }
  .article-eyebrow.rot::before { content: ''; width: 2rem; height: 1px; background: var(--rust); }
  .article-eyebrow.field { color: var(--lime); }
  .article-eyebrow.field::before { content: ''; width: 2rem; height: 1px; background: var(--lime); }

  .article-title {
    font-family: 'Bebas Neue', sans-serif;
    font-size: clamp(2.5rem, 6vw, 5rem);
    line-height: 0.95; letter-spacing: 0.02em;
    color: var(--paper); margin-bottom: 1.5rem;
  }
  .article-summary {
    font-size: 1.15rem; line-height: 1.7; color: var(--ash);
    font-style: italic; margin-bottom: 1.5rem;
    padding-left: 1rem; border-left: 2px solid rgba(139,184,58,0.3);
  }
  .article-meta { display: flex; align-items: center; gap: 1.5rem; flex-wrap: wrap; }
  .article-date { font-family: 'Space Mono', monospace; font-size: 0.68rem; color: var(--ash); letter-spacing: 0.08em; }
  .article-tags { display: flex; flex-wrap: wrap; gap: 0.35rem; }
  .article-tag { font-family: 'Space Mono', monospace; font-size: 0.58rem; letter-spacing: 0.06em; text-transform: uppercase; padding: 0.15rem 0.55rem; border: 1px solid rgba(139,184,58,0.2); color: var(--ash); }
  .article-tag.satire-tag { border-color: rgba(196,85,26,0.3); color: var(--rust); }

  /* ARTICLE BODY */
  .article-body { max-width: 800px; margin: 0 auto; padding: 3rem 2rem 5rem; }

  .article-body :global(h1),
  .article-body :global(h2),
  .article-body :global(h3),
  .article-body :global(h4) {
    font-family: 'Bebas Neue', sans-serif; letter-spacing: 0.03em;
    color: var(--paper); margin-top: 2.5rem; margin-bottom: 1rem; line-height: 1.1;
  }
  .article-body :global(h1) { font-size: 2.8rem; }
  .article-body :global(h2) { font-size: 2.2rem; }
  .article-body :global(h3) { font-size: 1.8rem; }
  .article-body :global(h4) { font-size: 1.4rem; }

  .article-body :global(p) { font-size: 1.1rem; line-height: 1.85; color: var(--ash); margin-bottom: 1.5rem; }
  .article-body :global(strong) { color: var(--paper); font-weight: normal; }
  .article-body :global(em) { color: var(--straw); font-style: italic; }

  .article-body :global(a) { color: var(--lime); text-decoration: underline; text-decoration-color: rgba(139,184,58,0.4); transition: text-decoration-color 0.2s; }
  .article-body :global(a:hover) { text-decoration-color: var(--lime); }

  .article-body :global(ul), .article-body :global(ol) { margin: 1.5rem 0 1.5rem 1.5rem; color: var(--ash); }
  .article-body :global(li) { font-size: 1.05rem; line-height: 1.75; margin-bottom: 0.5rem; }

  .article-body :global(blockquote) { margin: 2rem 0; padding: 1.25rem 1.5rem; border-left: 3px solid var(--straw); background: rgba(28,24,18,0.6); font-style: italic; }
  .article-body :global(blockquote p) { margin-bottom: 0; color: var(--paper); }

  .article-body :global(hr) { border: none; border-top: 1px solid rgba(139,184,58,0.15); margin: 3rem 0; }

  /* Images in article body — don't show the hero image again if it's the first image */
  .article-body :global(img) {
    width: 100%; height: auto; display: block;
    margin: 2rem 0; opacity: 0.85;
  }

  .article-body :global(code) { font-family: 'Space Mono', monospace; font-size: 0.85em; background: rgba(28,24,18,0.8); padding: 0.1em 0.4em; color: var(--lime); }
  .article-body :global(pre) { background: rgba(28,24,18,0.9); border: 1px solid rgba(139,184,58,0.15); padding: 1.5rem; overflow-x: auto; margin: 2rem 0; }
  .article-body :global(pre code) { background: none; padding: 0; font-size: 0.85rem; line-height: 1.6; }

  /* BACK LINK */
  .back-link-wrap { max-width: 800px; margin: 0 auto; padding: 0 2rem 3rem; }
  .back-link { font-family: 'Space Mono', monospace; font-size: 0.7rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--lime); text-decoration: none; display: inline-flex; align-items: center; gap: 0.5rem; transition: gap 0.2s; }
  .back-link:hover { gap: 0.75rem; }
  .back-link::before { content: '←'; }

  /* FOOTER */
  .footer { padding: 2rem 4rem; border-top: 1px solid rgba(139,184,58,0.15); display: flex; justify-content: space-between; align-items: center; }
  .footer-logo { font-family: 'Bebas Neue', sans-serif; font-size: 1.2rem; color: var(--lime); letter-spacing: 0.08em; }
  .footer-copy { font-family: 'Space Mono', monospace; font-size: 0.65rem; color: var(--ash); }

  @media (max-width: 768px) {
    .article-header { padding: 2.5rem 1.5rem 2rem; }
    .article-body { padding: 2rem 1.5rem 4rem; }
    .back-link-wrap { padding: 0 1.5rem 2rem; }
    .hero-image-wrap { height: 240px; }
    .footer { flex-direction: column; gap: 1rem; text-align: center; padding: 2rem 1.5rem; }
  }
</style>

<Navbar />

<div class="breadcrumb">
  <a href="/articles">← Articles</a> / {isSatire ? 'Rotten Articles' : 'Field Notes'}
</div>



<div class="article-header">
  <p class={`article-eyebrow ${isSatire ? 'rot' : 'field'}`}>
    {isSatire ? 'Rotten Articles — Satire' : 'Field Notes — Guide'}
  </p>
  <h1 class="article-title">{data.title}</h1>
  {data.summary && <p class="article-summary">{data.summary}</p>}
  <div class="article-meta">
    <span class="article-date">{dateStr}</span>
    <div class="article-tags">
      {(data.tags || []).map((t: string) => (
        <span class={`article-tag ${t === 'satire' ? 'satire-tag' : ''}`}>{t}</span>
      ))}
    </div>
  </div>
</div>

<div class="article-body">
  <Content />
</div>

<div class="back-link-wrap">
  <a href="/articles" class="back-link">Back to Articles</a>
</div>

<footer class="footer">
  <div class="footer-logo">PermiePortal</div>
  <div class="footer-copy">© {new Date().getFullYear()} PermiePortal</div>
</footer>

</BaseLayout>
