---
import '../../../styles.css';
import Navbar from '../../../components/Navbar.astro';
import Footer from '../../../components/Footer.astro';
import ArticleCard from '../../../components/ArticleCard.astro';

export async function getStaticPaths() {
  const modules = import.meta.glob('../../../content/articles/**/*.mdx', { eager: true });
  const articles = Object.values(modules)
    .map((m) => ({ ...(m.frontmatter || {}), url: m.url }))
    .filter((a) => a.title)
    .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());

  const PAGE_SIZE = 12;
  const totalPages = Math.max(1, Math.ceil(articles.length / PAGE_SIZE));

  return Array.from({ length: totalPages }, (_, i) => {
    const currentPage = i + 1;
    const start = i * PAGE_SIZE;
    const end = start + PAGE_SIZE;
    return {
      params: { page: String(currentPage) },
      props: {
        pageItems: articles.slice(start, end),
        totalPages,
        currentPage
      }
    };
  });
}

const { pageItems, totalPages, currentPage } = Astro.props as any;
---
<header>
  <Navbar />
  <a class="sr-only" href="#main">Skip to content</a>
  </header>
<main id="main">
  <h1 class="sr-only">Articles</h1>
  <section class="mt-8" aria-labelledby="articles-list">
    <h2 id="articles-list" class="text-2xl font-bold">Rotten Articles</h2>
    <div class="mt-4 grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {pageItems.map((a) => (
        <ArticleCard title={a.title} summary={a.summary} date={a.date} tags={a.tags} href={a.url || `/articles/${a.slug}`} />
      ))}
    </div>
    <nav class="mt-8 flex items-center justify-between" aria-label="Pagination">
      <a aria-disabled={currentPage === 1} class={`px-3 py-2 rounded border ${currentPage === 1 ? 'opacity-50 pointer-events-none' : ''}`} href={currentPage === 2 ? '/articles' : `/articles/page/${currentPage - 1}`}>Previous</a>
      <p class="text-sm">Page {currentPage} of {totalPages}</p>
      <a aria-disabled={currentPage === totalPages} class={`px-3 py-2 rounded border ${currentPage === totalPages ? 'opacity-50 pointer-events-none' : ''}`} href={`/articles/page/${currentPage + 1}`}>Next</a>
    </nav>
  </section>
</main>
<Footer />


