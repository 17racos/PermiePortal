---
import BaseLayout from '../../components/layouts/BaseLayout.astro';
import pestsData from '../../data/pests.json';

const SYMPTOM_LABELS: Record<string, string> = {
  'holes-in-leaves':    'Holes in Leaves',
  'yellowing-leaves':   'Yellowing Leaves',
  'wilting':            'Wilting',
  'sticky-residue':     'Sticky Residue',
  'white-powder':       'White Powder',
  'leaf-spots':         'Leaf Spots',
  'curling-leaves':     'Curling Leaves',
  'webbing':            'Webbing',
  'chewed-stems':       'Chewed Stems',
  'stem-damage':        'Stem Damage',
  'root-damage':        'Root Damage',
  'fruit-damage':       'Fruit Damage',
  'black-coating':      'Black Coating',
  'distorted-growth':   'Distorted Growth',
  'tunneling':          'Tunneling',
  'galls':              'Galls',
  'dropping-leaves':    'Dropping Leaves',
  'silvery-streaking':  'Silvery Streaking',
  'brown-edges':        'Brown Edges',
  'die-back':           'Die-Back',
  'sooty-deposits':     'Sooty Deposits',
  'slime-trails':       'Slime Trails',
  'skeletonized-leaves':'Skeletonized Leaves',
  'bark-damage':        'Bark Damage',
  'crown-damage':       'Crown Damage',
};

const SYMPTOM_DESC: Record<string, string> = {
  'holes-in-leaves':    'Ragged or clean holes chewed through leaf tissue',
  'yellowing-leaves':   'Leaves turning yellow, pale, or losing green color',
  'wilting':            'Stems or leaves drooping and losing rigidity',
  'sticky-residue':     'Honeydew or sticky coating on leaves and stems',
  'white-powder':       'White powdery coating on leaf surfaces',
  'leaf-spots':         'Circular or irregular spots on leaf surface',
  'curling-leaves':     'Leaf edges or blades curling inward or upward',
  'webbing':            'Fine silk webbing on leaves or between stems',
  'chewed-stems':       'Stems partially or fully chewed through',
  'stem-damage':        'Lesions, cankers, or wounds on stems',
  'root-damage':        'Roots rotted, chewed, or stunted',
  'fruit-damage':       'Fruit scarred, tunneled, or prematurely dropping',
  'black-coating':      'Black sooty or moldy coating on plant surfaces',
  'distorted-growth':   'New growth twisted, cupped, or deformed',
  'tunneling':          'Galleries or tunnels in wood, stems, or leaves',
  'galls':              'Abnormal growths or swellings on leaves or stems',
  'dropping-leaves':    'Premature leaf drop before end of season',
  'silvery-streaking':  'Silver or bronze streaking on leaf surfaces',
  'brown-edges':        'Leaf margins turning brown and crispy',
  'die-back':           'Branch tips or whole sections dying from tip back',
  'sooty-deposits':     'Black sooty deposits on leaves or fruit',
  'slime-trails':       'Silvery slime trails on leaves or soil surface',
  'skeletonized-leaves':'Leaf tissue eaten leaving only veins behind',
  'bark-damage':        'Bark stripped, scored, or bored into',
  'crown-damage':       'Damage at the base of the plant where stem meets roots',
};

// Count pests per symptom
const symptomCounts: Record<string, number> = {};
for (const pest of pestsData) {
  for (const sym of (pest.symptoms || [])) {
    symptomCounts[sym] = (symptomCounts[sym] || 0) + 1;
  }
}

const symptoms = Object.keys(SYMPTOM_LABELS).sort((a, b) => 
  (symptomCounts[b] || 0) - (symptomCounts[a] || 0)
);
---
<BaseLayout
  title="Plant Problem Symptoms — Identify Garden Pests by What You See | PermiePortal"
  description="What's wrong with your plant? Browse 25 common symptom categories to identify garden pests organically. Holes in leaves, yellowing, wilting, sticky residue and more."
>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Instrument+Serif:ital@0;1&family=Space+Mono:ital,wght@0,400;0,700;1,400&display=swap');
  :root {
    --soil: #0f0d0a; --bark: #1c1812; --moss: #2a3d1f;
    --leaf: #4a7c35; --lime: #8fb83a; --straw: #d4a843;
    --ash: #b8b0a0; --paper: #ede8dc; --rot: #7a3b1e; --rust: #c4551a;
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body { background: var(--soil); color: var(--paper); font-family: 'Instrument Serif', Georgia, serif; }
  .nav { display: flex; justify-content: space-between; align-items: center; padding: 1.5rem 2rem; border-bottom: 1px solid rgba(139,184,58,0.2); position: sticky; top: 0; z-index: 100; background: rgba(15,13,10,0.97); backdrop-filter: blur(8px); }
  .nav-logo { font-family: 'Bebas Neue', sans-serif; font-size: 1.8rem; letter-spacing: 0.08em; color: var(--lime); text-decoration: none; }
  .nav-links { display: flex; gap: 2rem; list-style: none; }
  .nav-links a { font-family: 'Space Mono', monospace; font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.12em; color: var(--ash); text-decoration: none; transition: color 0.2s; }
  .nav-links a:hover { color: var(--lime); }
  .page-header { padding: 4rem 2rem 3rem; border-bottom: 1px solid rgba(139,184,58,0.15); }
  .page-eyebrow { font-family: 'Space Mono', monospace; font-size: 0.65rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--rust); margin-bottom: 1rem; display: flex; align-items: center; gap: 0.75rem; }
  .page-eyebrow::before { content: ''; width: 2rem; height: 1px; background: var(--rust); }
  .page-title { font-family: 'Bebas Neue', sans-serif; font-size: clamp(3rem, 7vw, 6rem); line-height: 0.92; color: var(--paper); margin-bottom: 1rem; }
  .page-title em { color: var(--rust); font-style: normal; }
  .page-sub { font-size: 1.1rem; color: var(--ash); max-width: 600px; line-height: 1.7; font-style: italic; }
  .symptoms-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 1rem; padding: 2.5rem 2rem; max-width: 1200px; margin: 0 auto; }
  .symptom-card { display: block; text-decoration: none; background: var(--bark); border: 1px solid rgba(196,85,26,0.15); padding: 1.5rem; transition: all 0.2s; position: relative; overflow: hidden; }
  .symptom-card::after { content: ''; position: absolute; bottom: 0; left: 0; width: 100%; height: 2px; background: var(--rust); transform: scaleX(0); transform-origin: left; transition: transform 0.3s; }
  .symptom-card:hover { border-color: rgba(196,85,26,0.4); background: rgba(122,59,30,0.1); }
  .symptom-card:hover::after { transform: scaleX(1); }
  .symptom-name { font-family: 'Bebas Neue', sans-serif; font-size: 1.4rem; letter-spacing: 0.03em; color: var(--paper); margin-bottom: 0.5rem; }
  .symptom-desc { font-size: 0.88rem; color: var(--ash); line-height: 1.6; margin-bottom: 1rem; font-style: italic; }
  .symptom-count { font-family: 'Space Mono', monospace; font-size: 0.62rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--rust); }
  .diagnose-cta { margin: 0 2rem 3rem; padding: 2rem; background: rgba(42,61,31,0.3); border: 1px solid rgba(139,184,58,0.2); display: flex; align-items: center; justify-content: space-between; gap: 2rem; max-width: 1200px; }
  .diagnose-cta-text { font-size: 1rem; color: var(--ash); line-height: 1.6; }
  .diagnose-cta-text strong { color: var(--paper); }
  .diagnose-cta-link { font-family: 'Space Mono', monospace; font-size: 0.7rem; letter-spacing: 0.1em; text-transform: uppercase; padding: 0.75rem 1.5rem; border: 1px solid var(--lime); color: var(--lime); text-decoration: none; white-space: nowrap; transition: all 0.2s; flex-shrink: 0; }
  .diagnose-cta-link:hover { background: rgba(139,184,58,0.1); }
  .footer { padding: 2rem 4rem; border-top: 1px solid rgba(139,184,58,0.15); display: flex; justify-content: space-between; align-items: center; margin-top: 2rem; }
  .footer-logo { font-family: 'Bebas Neue', sans-serif; font-size: 1.2rem; color: var(--lime); letter-spacing: 0.08em; }
  .footer-copy { font-family: 'Space Mono', monospace; font-size: 0.65rem; color: var(--ash); }
  @media (max-width: 768px) {
    .nav-links { gap: 1rem; }
    .nav-links a { font-size: 0.62rem; }
    .symptoms-grid { grid-template-columns: 1fr 1fr; padding: 1.5rem 1rem; gap: 0.75rem; }
    .diagnose-cta { flex-direction: column; margin: 0 1rem 2rem; }
    .footer { flex-direction: column; gap: 1rem; padding: 1.5rem; }
  }
</style>

<nav class="nav">
  <a href="/" class="nav-logo">PermiePortal</a>
  <ul class="nav-links">
    <li><a href="/plants">Plants</a></li>
    <li><a href="/pests">Pests</a></li>
    <li><a href="/diagnose">Diagnose</a></li>
    <li><a href="/articles">Articles</a></li>
    <li><a href="/about">About</a></li>
  </ul>
</nav>

<main>
<div class="page-header">
  <p class="page-eyebrow">Plant Problem Identification</p>
  <h1 class="page-title">What Does the<br>Damage <em>Look Like?</em></h1>
  <p class="page-sub">Select a symptom to see every pest that causes it — with organic controls for each one.</p>
</div>

<div class="diagnose-cta">
  <p class="diagnose-cta-text"><strong>Seeing multiple symptoms?</strong> Use the interactive diagnosis tool to filter by combinations — it narrows results as you add more symptoms.</p>
  <a href="/diagnose" class="diagnose-cta-link">Open Diagnosis Tool →</a>
</div>

<div class="symptoms-grid">
  {symptoms.map(sym => (
    <a href={`/symptoms/${sym}`} class="symptom-card">
      <div class="symptom-name">{SYMPTOM_LABELS[sym]}</div>
      <p class="symptom-desc">{SYMPTOM_DESC[sym]}</p>
      <span class="symptom-count">{symptomCounts[sym] || 0} possible pest{(symptomCounts[sym] || 0) !== 1 ? 's' : ''}</span>
    </a>
  ))}
</div>
</main>

<footer class="footer">
  <div class="footer-logo">PermiePortal</div>
  <div class="footer-copy">© {new Date().getFullYear()} PermiePortal</div>
</footer>
</BaseLayout>
