---
import '../../styles/tailwind.css';
import '../../styles/base.css';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';

const { slug } = Astro.params;
const entries = await getCollection('projects');
const match = entries.find((e) => e.data.slug === slug);
if (!match) return Astro.redirect('/projects');
const { Content, data } = await match.render();
---
<header>
  <Navbar />
</header>
<main id="main" class="prose prose-invert max-w-3xl px-4">
  <article>
    <h1 class="!mb-2">{data.title}</h1>
    <p class="text-sm text-secondary">{data.date.toDateString()}</p>
    <div class="mt-6">
      <Content />
    </div>
  </article>
</main>
<Footer />


