---
import '../../styles/tailwind.css';
import '../../styles/base.css';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const entries = await getCollection('projects');
  return entries.map((e) => ({ params: { slug: e.data.slug }, props: { slug: e.data.slug } }));
}

const { slug } = Astro.props as { slug: string };
const all = await getCollection('projects');
const match = all.find((e) => e.data.slug === slug);
if (!match) throw new Error('Project not found');
const { Content, data } = await match.render();
---
<header>
  <Navbar />
</header>
<main id="main" class="prose prose-invert max-w-3xl px-4">
  <article>
    <h1 class="!mb-2">{data.title}</h1>
    <p class="text-sm text-secondary">{data.date.toDateString()}</p>
    <div class="mt-6">
      <Content />
    </div>
  </article>
</main>
<Footer />


