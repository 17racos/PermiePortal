---
import '../../styles.css';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';

const { slug } = Astro.params;
const modules = import.meta.glob('../../content/projects/**/*.mdx', { eager: true });
const entries = Object.values(modules) as any[];
const match = entries.find((m) => m.frontmatter && m.frontmatter.slug === slug);

if (!match) {
  return Astro.redirect('/projects');
}

const Page = match.default;
const fm = match.frontmatter;
---
<header>
  <Navbar />
</header>
<main id="main" class="prose prose-invert max-w-3xl">
  <article>
    <h1 class="!mb-2">{fm.title}</h1>
    <p class="text-sm text-gray-400">{new Date(fm.date).toLocaleDateString()}</p>
    {fm.tags && (
      <ul class="mt-2 flex flex-wrap gap-2" aria-label="tags">
        {fm.tags.map((t: string) => <li class="text-xs bg-ink border border-gray-800 rounded px-2 py-0.5">{t}</li>)}
      </ul>
    )}
    <div class="mt-6">
      <Page />
    </div>
  </article>
  
</main>
<Footer />


