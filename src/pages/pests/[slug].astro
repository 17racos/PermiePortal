---
// src/pages/pests/[slug].astro
import BaseLayout from '../../components/layouts/BaseLayout.astro';
import pestsData from '../../data/pests.json';

export function getStaticPaths() {
  return pestsData.map(pest => ({
    params: { slug: pest.slug },
    props: { pest }
  }));
}

const { pest } = Astro.props;

const controlSectionLabels: Record<string, string> = {
  organic_sprays: 'Organic Sprays',
  biological_controls: 'Biological Controls',
  cultural_practices: 'Cultural Practices',
  mechanical_physical: 'Mechanical & Physical',
  preventive_methods: 'Prevention',
  integrated_preventive_methods: 'Integrated Prevention',
};
---

<BaseLayout title={pest.name}>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Instrument+Serif:ital@0;1&family=Space+Mono:ital,wght@0,400;0,700;1,400&display=swap');

  :root {
    --soil: #0f0d0a; --bark: #1c1812; --moss: #2a3d1f;
    --leaf: #4a7c35; --lime: #8fb83a; --straw: #d4a843;
    --ash: #b8b0a0; --paper: #ede8dc; --rot: #7a3b1e; --rust: #c4551a;
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }
  body {
    background: var(--soil); color: var(--paper);
    font-family: 'Instrument Serif', Georgia, serif;
  }

  .nav {
    display: flex; justify-content: space-between; align-items: center;
    padding: 1.5rem 2rem; border-bottom: 1px solid rgba(139,184,58,0.2);
  }
  .nav-logo {
    font-family: 'Bebas Neue', sans-serif; font-size: 1.8rem;
    letter-spacing: 0.08em; color: var(--lime); text-decoration: none;
  }
  .nav-links { display: flex; gap: 2rem; list-style: none; }
  .nav-links a {
    font-family: 'Space Mono', monospace; font-size: 0.72rem;
    text-transform: uppercase; letter-spacing: 0.12em;
    color: var(--ash); text-decoration: none; transition: color 0.2s;
  }
  .nav-links a:hover { color: var(--lime); }

  .breadcrumb {
    padding: 1rem 2rem;
    font-family: 'Space Mono', monospace; font-size: 0.65rem;
    letter-spacing: 0.1em; text-transform: uppercase; color: var(--ash);
    border-bottom: 1px solid rgba(139,184,58,0.1);
  }
  .breadcrumb a { color: var(--lime); text-decoration: none; }
  .breadcrumb a:hover { text-decoration: underline; }

  .hero {
    padding: 3rem 2rem 2rem;
    border-bottom: 1px solid rgba(196,85,26,0.2);
    position: relative; overflow: hidden;
  }

  .hero::before {
    content: '';
    position: absolute; right: -5%; top: -20%;
    width: 50%; height: 150%;
    background: radial-gradient(ellipse, rgba(122,59,30,0.15) 0%, transparent 70%);
    pointer-events: none;
  }

  .pest-eyebrow {
    font-family: 'Space Mono', monospace; font-size: 0.65rem;
    letter-spacing: 0.2em; text-transform: uppercase;
    color: var(--rust); margin-bottom: 0.75rem;
    display: flex; align-items: center; gap: 0.75rem;
  }
  .pest-eyebrow::before {
    content: ''; width: 2rem; height: 1px; background: var(--rust);
  }

  .pest-name {
    font-family: 'Bebas Neue', sans-serif;
    font-size: clamp(3rem, 7vw, 6rem);
    line-height: 0.95; letter-spacing: 0.02em; color: var(--paper);
    margin-bottom: 0.5rem;
  }

  .pest-sci {
    font-style: italic; font-size: 1.1rem; color: var(--ash);
    margin-bottom: 1.5rem;
  }

  .pest-stats {
    display: flex; gap: 2rem; flex-wrap: wrap;
  }

  .stat {
    border-left: 2px solid var(--rust); padding-left: 0.75rem;
  }

  .stat-number {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 2rem; color: var(--rust); line-height: 1;
  }

  .stat-label {
    font-family: 'Space Mono', monospace; font-size: 0.6rem;
    text-transform: uppercase; letter-spacing: 0.1em; color: var(--ash);
  }

  /* CONTENT */
  .content { max-width: 1200px; }

  .section {
    padding: 2.5rem 2rem;
    border-bottom: 1px solid rgba(139,184,58,0.1);
  }

  .section-label {
    font-family: 'Space Mono', monospace; font-size: 0.65rem;
    letter-spacing: 0.2em; text-transform: uppercase;
    color: var(--straw); margin-bottom: 1rem;
  }

  .section-title {
    font-family: 'Bebas Neue', sans-serif; font-size: 2rem;
    letter-spacing: 0.03em; color: var(--paper); margin-bottom: 1.25rem;
  }

  .description {
    font-size: 1.05rem; line-height: 1.8; color: var(--ash);
  }

  .characteristics {
    font-size: 1rem; line-height: 1.75; color: var(--ash);
    margin-top: 1rem; padding-top: 1rem;
    border-top: 1px solid rgba(139,184,58,0.1);
  }

  /* CONTROL METHODS */
  .controls-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1rem;
  }

  .control-card {
    background: var(--bark);
    border: 1px solid rgba(139,184,58,0.15);
    padding: 1.25rem;
  }

  .control-title {
    font-family: 'Space Mono', monospace; font-size: 0.7rem;
    letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--lime); margin-bottom: 0.75rem;
    display: flex; align-items: center; gap: 0.5rem;
  }

  .control-title::before {
    content: '▸'; color: var(--leaf);
  }

  .control-text {
    font-size: 0.9rem; line-height: 1.65; color: var(--ash);
  }

  /* NATURAL ENEMIES */
  .enemies-list {
    list-style: none; display: flex; flex-wrap: wrap; gap: 0.5rem;
  }

  .enemy-tag {
    font-family: 'Space Mono', monospace; font-size: 0.68rem;
    letter-spacing: 0.06em; text-transform: uppercase;
    padding: 0.35rem 0.85rem;
    background: rgba(42,61,31,0.5);
    border: 1px solid rgba(74,124,53,0.4);
    color: var(--lime);
  }

  /* AFFECTED PLANTS */
  .plants-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: 0.5rem;
  }

  .plant-link {
    display: block; text-decoration: none;
    padding: 0.6rem 0.9rem;
    background: rgba(28,24,18,0.6);
    border: 1px solid rgba(139,184,58,0.15);
    transition: all 0.2s;
  }

  .plant-link:hover {
    border-color: rgba(139,184,58,0.4);
    background: rgba(42,61,31,0.3);
  }

  .plant-link-name {
    font-family: 'Space Mono', monospace; font-size: 0.72rem;
    color: var(--paper); letter-spacing: 0.04em;
  }

  .footer {
    padding: 2rem 4rem;
    border-top: 1px solid rgba(139,184,58,0.15);
    display: flex; justify-content: space-between; align-items: center;
    margin-top: 2rem;
  }
  .footer-logo {
    font-family: 'Bebas Neue', sans-serif; font-size: 1.2rem;
    color: var(--lime); letter-spacing: 0.08em;
  }
  .footer-copy {
    font-family: 'Space Mono', monospace; font-size: 0.65rem; color: var(--ash);
  }

  @media (max-width: 768px) {
    .pest-stats { gap: 1.25rem; }
    .controls-grid { grid-template-columns: 1fr; }
    .footer { flex-direction: column; gap: 1rem; padding: 2rem 1.5rem; }
    .nav-links { gap: 1rem; }
  }
</style>

<nav class="nav">
  <a href="/" class="nav-logo">PermiePortal</a>
  <ul class="nav-links">
    <li><a href="/plants">Plants</a></li>
    <li><a href="/pests">Pests</a></li>
    <li><a href="/articles">Articles</a></li>
    <li><a href="/projects">Projects</a></li>
    <li><a href="/about">About</a></li>
  </ul>
</nav>

<div class="breadcrumb">
  <a href="/pests">← Pests</a> / {pest.name}
</div>

<div class="hero">
  <p class="pest-eyebrow">Organic Control Profile</p>
  <h1 class="pest-name">{pest.name}</h1>
  {pest.scientific_name && (
    <p class="pest-sci">{pest.scientific_name}</p>
  )}
  <div class="pest-stats">
    <div class="stat">
      <div class="stat-number">{pest.affected_plants?.length || 0}</div>
      <div class="stat-label">Plants Affected</div>
    </div>
    <div class="stat">
      <div class="stat-number">{pest.natural_enemies?.length || 0}</div>
      <div class="stat-label">Natural Enemies</div>
    </div>
    <div class="stat">
      <div class="stat-number">{Object.keys(pest.control_methods || {}).length}</div>
      <div class="stat-label">Control Strategies</div>
    </div>
  </div>
</div>

<div class="content">
  {(pest.description || pest.characteristics) && (
    <div class="section">
      <p class="section-label">Identification</p>
      {pest.description && <p class="description">{pest.description}</p>}
      {pest.characteristics && <p class="characteristics">{pest.characteristics}</p>}
    </div>
  )}

  {pest.control_methods && Object.keys(pest.control_methods).length > 0 && (
    <div class="section">
      <p class="section-label">How to Deal With It</p>
      <h2 class="section-title">Organic Control Methods</h2>
      <div class="controls-grid">
        {Object.entries(pest.control_methods).map(([key, value]) => (
          <div class="control-card">
            <div class="control-title">
              {controlSectionLabels[key] || key.replace(/_/g, ' ')}
            </div>
            <p class="control-text">{String(value)}</p>
          </div>
        ))}
      </div>
    </div>
  )}

  {pest.natural_enemies && pest.natural_enemies.length > 0 && (
    <div class="section">
      <p class="section-label">Let Nature Handle It</p>
      <h2 class="section-title">Natural Enemies</h2>
      <ul class="enemies-list">
        {pest.natural_enemies.map((enemy: string) => (
          <li class="enemy-tag">{enemy}</li>
        ))}
      </ul>
    </div>
  )}

  {pest.affected_plants && pest.affected_plants.length > 0 && (
    <div class="section">
      <p class="section-label">Threat Map</p>
      <h2 class="section-title">Plants Affected — {pest.affected_plants.length} in Database</h2>
      <div class="plants-grid">
        {pest.affected_plants.map((plant: {slug: string, name: string}) => (
          <a href={`/plants/${plant.slug}`} class="plant-link">
            <div class="plant-link-name">{plant.name}</div>
          </a>
        ))}
      </div>
    </div>
  )}
</div>

<footer class="footer">
  <div class="footer-logo">PermiePortal</div>
  <div class="footer-copy">© {new Date().getFullYear()} — Built in a food forest in Yulee, FL</div>
</footer>

</BaseLayout>
