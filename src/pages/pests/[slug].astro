---
// src/pages/pests/[slug].astro
import BaseLayout from '../../components/layouts/BaseLayout.astro';
import pestsData from '../../data/pests.json';

export function getStaticPaths() {
  return pestsData.map(pest => ({
    params: { slug: pest.slug },
    props: { pest }
  }));
}

const { pest } = Astro.props;

const controlSectionLabels: Record<string, string> = {
  organic_sprays: 'Organic Sprays',
  biological_controls: 'Biological Controls',
  cultural_practices: 'Cultural Practices',
  mechanical_physical: 'Mechanical & Physical',
  preventive_methods: 'Prevention',
  integrated_preventive_methods: 'Integrated Prevention',
};

const imagePath = pest.picture ? `/assets/pests/${pest.picture}` : null;

// Use common name for all external links — more reliable than scientific names
const nameQuery = encodeURIComponent(pest.name);

// iNaturalist: taxon_name= accepts common names, scientific names, and synonyms
const iNatObsUrl     = `https://www.inaturalist.org/observations?place_id=any&taxon_name=${nameQuery}`;
const iNatSpeciesUrl = `https://www.inaturalist.org/taxa/search?q=${nameQuery}`;
const wikipediaUrl   = (() => {
  // Wikipedia uses Title_Case_With_Lowercase_After_First: "Apple_scab" not "Apple_Scab"
  const words = pest.name.split(' ');
  const titled = words[0].charAt(0).toUpperCase() + words[0].slice(1).toLowerCase();
  const rest = words.slice(1).map((w: string) => w.toLowerCase()).join('_');
  const wikiName = rest ? titled + '_' + rest : titled;
  return `https://en.wikipedia.org/wiki/${encodeURIComponent(wikiName)}`;
})();

// Disease/fungal pests — show UF/IFAS which has best subtropical disease content
// Uses word-level matching to avoid flagging "Carrot Rust Fly" as a disease
const pestNameLower = pest.name.toLowerCase();
const isDisease = (
  /\bgreening\b/.test(pestNameLower) ||
  /\bblight\b/.test(pestNameLower) ||
  /\brot\b/.test(pestNameLower) ||
  /\bmold\b/.test(pestNameLower) ||
  /\bmildew\b/.test(pestNameLower) ||
  /\bcanker\b/.test(pestNameLower) ||
  /\bvirus\b/.test(pestNameLower) ||
  /\bwilt\b/.test(pestNameLower) ||
  /\bscab\b/.test(pestNameLower) ||
  /\banthraco/.test(pestNameLower) ||
  /\balternaria\b/.test(pestNameLower) ||
  /\bcercospora\b/.test(pestNameLower) ||
  /\bpythium\b/.test(pestNameLower) ||
  /\bphytophthora\b/.test(pestNameLower) ||
  /\bganoderma\b/.test(pestNameLower) ||
  /\bblast\b/.test(pestNameLower)
);
const ifasUrl = `https://edis.ifas.ufl.edu/search?q=${nameQuery}`;
---

<BaseLayout title={pest.name}>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Instrument+Serif:ital@0;1&family=Space+Mono:ital,wght@0,400;0,700;1,400&display=swap');

  :root {
    --soil: #0f0d0a; --bark: #1c1812; --moss: #2a3d1f;
    --leaf: #4a7c35; --lime: #8fb83a; --straw: #d4a843;
    --ash: #b8b0a0; --paper: #ede8dc; --rot: #7a3b1e; --rust: #c4551a;
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }
  body { background: var(--soil); color: var(--paper); font-family: 'Instrument Serif', Georgia, serif; }

  /* NAV */
  .nav { display: flex; justify-content: space-between; align-items: center; padding: 1.5rem 2rem; border-bottom: 1px solid rgba(139,184,58,0.2); }
  .nav-logo { font-family: 'Bebas Neue', sans-serif; font-size: 1.8rem; letter-spacing: 0.08em; color: var(--lime); text-decoration: none; }
  .nav-links { display: flex; gap: 2rem; list-style: none; }
  .nav-links a { font-family: 'Space Mono', monospace; font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.12em; color: var(--ash); text-decoration: none; transition: color 0.2s; }
  .nav-links a:hover { color: var(--lime); }

  /* BREADCRUMB */
  .breadcrumb { padding: 1rem 2rem; font-family: 'Space Mono', monospace; font-size: 0.65rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--ash); border-bottom: 1px solid rgba(139,184,58,0.1); }
  .breadcrumb a { color: var(--lime); text-decoration: none; }
  .breadcrumb a:hover { text-decoration: underline; }

  /* HERO IMAGE */
  .hero-image-wrap { position: relative; width: 100%; height: clamp(260px, 38vw, 460px); overflow: hidden; border-bottom: 1px solid rgba(196,85,26,0.2); }
  .hero-image { width: 100%; height: 100%; object-fit: cover; display: block; opacity: 0.8; }
  .hero-image-placeholder { width: 100%; height: 100%; flex-direction: column; gap: 0.5rem; background: linear-gradient(135deg, rgba(122,59,30,0.4) 0%, var(--bark) 100%); display: flex; align-items: center; justify-content: center; }
  .placeholder-main { font-family: 'Bebas Neue', sans-serif; font-size: 1rem; letter-spacing: 0.2em; color: rgba(139,184,58,0.3); text-transform: uppercase; }
  .placeholder-sub { font-family: 'Space Mono', monospace; font-size: 0.55rem; letter-spacing: 0.12em; text-transform: uppercase; color: rgba(139,184,58,0.2); margin-top: 0.5rem; }
  .hero-image-placeholder span { font-family: 'Bebas Neue', sans-serif; font-size: 1rem; letter-spacing: 0.2em; color: rgba(196,85,26,0.3); text-transform: uppercase; }
  .hero-image-wrap::after { content: ''; position: absolute; bottom: 0; left: 0; right: 0; height: 50%; background: linear-gradient(to top, rgba(15,13,10,0.95) 0%, transparent 100%); pointer-events: none; }

  /* Quick ID links on image */
  .id-links { position: absolute; bottom: 1.25rem; right: 1.5rem; display: flex; gap: 0.5rem; z-index: 2; }
  .id-link { font-family: 'Space Mono', monospace; font-size: 0.6rem; letter-spacing: 0.08em; text-transform: uppercase; padding: 0.3rem 0.7rem; background: rgba(15,13,10,0.85); border: 1px solid rgba(196,85,26,0.4); color: var(--rust); text-decoration: none; transition: all 0.2s; }
  .id-link:hover { border-color: var(--rust); color: var(--paper); background: rgba(122,59,30,0.5); }

  /* HERO TEXT */
  .hero { padding: 2.5rem 2rem 2rem; border-bottom: 1px solid rgba(196,85,26,0.15); }
  .pest-eyebrow { font-family: 'Space Mono', monospace; font-size: 0.65rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--rust); margin-bottom: 0.75rem; display: flex; align-items: center; gap: 0.75rem; }
  .pest-eyebrow::before { content: ''; width: 2rem; height: 1px; background: var(--rust); }
  .pest-name { font-family: 'Bebas Neue', sans-serif; font-size: clamp(3rem, 7vw, 6rem); line-height: 0.95; letter-spacing: 0.02em; color: var(--paper); margin-bottom: 0.5rem; }
  .pest-sci { font-style: italic; font-size: 1.1rem; color: var(--ash); margin-bottom: 1.5rem; }
  .pest-stats { display: flex; gap: 2rem; flex-wrap: wrap; }
  .stat { border-left: 2px solid var(--rust); padding-left: 0.75rem; }
  .stat-number { font-family: 'Bebas Neue', sans-serif; font-size: 2rem; color: var(--rust); line-height: 1; }
  .stat-label { font-family: 'Space Mono', monospace; font-size: 0.6rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--ash); }

  /* CONTENT */
  .content { max-width: 1200px; }
  .section { padding: 2.5rem 2rem; border-bottom: 1px solid rgba(139,184,58,0.1); }
  .section-label { font-family: 'Space Mono', monospace; font-size: 0.65rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--straw); margin-bottom: 1rem; }
  .section-title { font-family: 'Bebas Neue', sans-serif; font-size: 2rem; letter-spacing: 0.03em; color: var(--paper); margin-bottom: 1.25rem; }
  .description { font-size: 1.05rem; line-height: 1.8; color: var(--ash); }
  .characteristics { font-size: 1rem; line-height: 1.75; color: var(--ash); margin-top: 1.25rem; padding-top: 1.25rem; border-top: 1px solid rgba(139,184,58,0.1); }

  /* PHOTO STRIP */
  .photo-strip { margin-top: 1.5rem; padding: 1.25rem 1.5rem; background: rgba(28,24,18,0.7); border: 1px solid rgba(196,85,26,0.15); }
  .photo-strip-label { font-family: 'Space Mono', monospace; font-size: 0.6rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--ash); opacity: 0.8; margin-bottom: 0.85rem; }
  .photo-strip-links { display: flex; flex-wrap: wrap; gap: 0.6rem; }
  .photo-link { font-family: 'Space Mono', monospace; font-size: 0.65rem; letter-spacing: 0.05em; padding: 0.45rem 1rem; border: 1px solid rgba(196,85,26,0.3); color: var(--rust); text-decoration: none; transition: all 0.2s; display: inline-flex; align-items: center; gap: 0.4rem; }
  .photo-link:hover { border-color: var(--rust); background: rgba(122,59,30,0.2); color: var(--paper); }
  .photo-link .arrow { font-size: 0.55rem; opacity: 0.7; }
  .photo-link.primary { border-color: rgba(196,85,26,0.5); color: var(--straw); }
  .photo-link.primary:hover { border-color: var(--straw); color: var(--paper); background: rgba(122,59,30,0.3); }

  /* CONTROLS */
  .controls-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 1rem; }
  .control-card { background: var(--bark); border: 1px solid rgba(139,184,58,0.15); padding: 1.25rem; }
  .control-title { font-family: 'Space Mono', monospace; font-size: 0.7rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--lime); margin-bottom: 0.75rem; display: flex; align-items: center; gap: 0.5rem; }
  .control-title::before { content: '▸'; color: var(--leaf); }
  .control-text { font-size: 0.9rem; line-height: 1.65; color: var(--ash); }

  /* NATURAL ENEMIES */
  .enemies-list { list-style: none; display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .enemy-tag { font-family: 'Space Mono', monospace; font-size: 0.68rem; letter-spacing: 0.06em; text-transform: uppercase; padding: 0.35rem 0.85rem; background: rgba(42,61,31,0.5); border: 1px solid rgba(74,124,53,0.4); color: var(--lime); }

  /* AFFECTED PLANTS */
  .plants-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 0.5rem; }
  .plant-link { display: block; text-decoration: none; padding: 0.6rem 0.9rem; background: rgba(28,24,18,0.6); border: 1px solid rgba(139,184,58,0.15); transition: all 0.2s; }
  .plant-link:hover { border-color: rgba(139,184,58,0.4); background: rgba(42,61,31,0.3); }
  .plant-link-name { font-family: 'Space Mono', monospace; font-size: 0.72rem; color: var(--paper); letter-spacing: 0.04em; }

  /* FOOTER */
  .footer { padding: 2rem 4rem; border-top: 1px solid rgba(139,184,58,0.15); display: flex; justify-content: space-between; align-items: center; margin-top: 2rem; }
  .footer-logo { font-family: 'Bebas Neue', sans-serif; font-size: 1.2rem; color: var(--lime); letter-spacing: 0.08em; }
  .footer-copy { font-family: 'Space Mono', monospace; font-size: 0.65rem; color: var(--ash); }

  @media (max-width: 768px) {
    .pest-stats { gap: 1.25rem; }
    .controls-grid { grid-template-columns: 1fr; }
    .footer { flex-direction: column; gap: 1rem; padding: 2rem 1.5rem; }
    .nav-links { gap: 1rem; }
    .hero-image-wrap { height: 220px; }
    .id-links { position: static; padding: 0.75rem 1.5rem; background: rgba(15,13,10,0.9); justify-content: flex-start; }
  }
</style>

<nav class="nav">
  <a href="/" class="nav-logo">PermiePortal</a>
  <ul class="nav-links">
    <li><a href="/plants">Plants</a></li>
    <li><a href="/pests">Pests</a></li>
    <li><a href="/plants/families">Plant Families</a></li>
    <li><a href="/articles">Articles</a></li>
    <li><a href="/about">About</a></li>
  </ul>
</nav>

<div class="breadcrumb">
  <a href="/pests">← Pests</a> / {pest.name}
</div>

<div class="hero-image-wrap">
  {imagePath ? (
    <img class="hero-image" src={imagePath} alt={`${pest.name} identification`} loading="eager" />
  ) : (
    <div class="hero-image-placeholder">
      <span class="placeholder-main">{pest.name}</span>
      <span class="placeholder-sub">Image pending. Reforestation ongoing.</span>
    </div>
  )}

</div>

<div class="hero">
  <p class="pest-eyebrow">Organic Control Profile</p>
  <h1 class="pest-name">{pest.name}</h1>
  {pest.scientific_name && pest.scientific_name !== 'NEEDS_DATA' && (
    <p class="pest-sci">{pest.scientific_name}</p>
  )}
  <div class="pest-stats">
    <div class="stat">
      <div class="stat-number">{pest.affected_plants?.length || 0}</div>
      <div class="stat-label">Plants Affected</div>
    </div>
    <div class="stat">
      <div class="stat-number">{pest.natural_enemies?.length || 0}</div>
      <div class="stat-label">Natural Enemies</div>
    </div>
    <div class="stat">
      <div class="stat-number">{Object.keys(pest.control_methods || {}).length}</div>
      <div class="stat-label">Control Strategies</div>
    </div>
  </div>
</div>

<div class="content">

  {(pest.description || pest.characteristics) && (
    <div class="section">
      <p class="section-label">Field Identification</p>
      {pest.description && <p class="description">{pest.description}</p>}
      {pest.characteristics && <p class="characteristics">{pest.characteristics}</p>}

      <div class="photo-strip">
        <div class="photo-strip-label">More identification photos — verified field observations</div>
        <div class="photo-strip-links">
          <a href={iNatObsUrl} target="_blank" rel="noopener" class="photo-link primary">
            <span class="arrow">↗</span> iNaturalist Observations
          </a>
          <a href={iNatSpeciesUrl} target="_blank" rel="noopener" class="photo-link">
            <span class="arrow">↗</span> iNaturalist Species
          </a>
          <a href={wikipediaUrl} target="_blank" rel="noopener" class="photo-link">
            <span class="arrow">↗</span> Wikipedia
          </a>
          {isDisease && (
            <a href={ifasUrl} target="_blank" rel="noopener" class="photo-link">
              <span class="arrow">↗</span> UF/IFAS Extension
            </a>
          )}
        </div>
      </div>
    </div>
  )}

  {pest.control_methods && Object.keys(pest.control_methods).length > 0 && (
    <div class="section">
      <p class="section-label">How to Deal With It</p>
      <h2 class="section-title">Organic Control Methods</h2>
      <div class="controls-grid">
        {Object.entries(pest.control_methods).map(([key, value]) => (
          <div class="control-card">
            <div class="control-title">
              {controlSectionLabels[key] || key.replace(/_/g, ' ')}
            </div>
            <p class="control-text">{String(value)}</p>
          </div>
        ))}
      </div>
    </div>
  )}

  {pest.natural_enemies && pest.natural_enemies.length > 0 && (
    <div class="section">
      <p class="section-label">Let Nature Handle It</p>
      <h2 class="section-title">Natural Enemies</h2>
      <ul class="enemies-list">
        {pest.natural_enemies.map((enemy: string) => (
          <li class="enemy-tag">{enemy}</li>
        ))}
      </ul>
    </div>
  )}

  {pest.affected_plants && pest.affected_plants.length > 0 && (
    <div class="section">
      <p class="section-label">Threat Map</p>
      <h2 class="section-title">Plants Affected — {pest.affected_plants.length} in Database</h2>
      <div class="plants-grid">
        {pest.affected_plants.map((plant: {slug: string, name: string}) => (
          <a href={`/plants/${plant.slug}`} class="plant-link">
            <div class="plant-link-name">{plant.name}</div>
          </a>
        ))}
      </div>
    </div>
  )}

</div>

<footer class="footer">
  <div class="footer-logo">PermiePortal</div>
  <div class="footer-copy">© {new Date().getFullYear()} PermiePortal</div>
</footer>

</BaseLayout>
