---
// src/pages/pests/index.astro
import BaseLayout from '../../components/layouts/BaseLayout.astro';
import pestsData from '../../data/pests.json';

const pests = pestsData.sort((a, b) => a.name.localeCompare(b.name));
---

<BaseLayout title="Pest Database">
<style>
  @import url('https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Instrument+Serif:ital@0;1&family=Space+Mono:ital,wght@0,400;0,700;1,400&display=swap');

  :root {
    --soil: #0f0d0a; --bark: #1c1812; --moss: #2a3d1f;
    --leaf: #4a7c35; --lime: #8fb83a; --straw: #d4a843;
    --ash: #b8b0a0; --paper: #ede8dc; --rot: #7a3b1e; --rust: #c4551a;
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    background: var(--soil);
    color: var(--paper);
    font-family: 'Instrument Serif', Georgia, serif;
    min-height: 100vh;
  }

  .nav {
    display: flex; justify-content: space-between; align-items: center;
    padding: 1.5rem 2rem;
    border-bottom: 1px solid rgba(139,184,58,0.2);
  }
  .nav-logo {
    font-family: 'Bebas Neue', sans-serif; font-size: 1.8rem;
    letter-spacing: 0.08em; color: var(--lime); text-decoration: none;
  }
  .nav-links { display: flex; gap: 2rem; list-style: none; }
  .nav-links a {
    font-family: 'Space Mono', monospace; font-size: 0.72rem;
    text-transform: uppercase; letter-spacing: 0.12em;
    color: var(--ash); text-decoration: none; transition: color 0.2s;
  }
  .nav-links a:hover, .nav-links a[aria-current] { color: var(--lime); }

  .page-header {
    padding: 3rem 2rem 2rem;
    border-bottom: 1px solid rgba(196,85,26,0.2);
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: end;
    gap: 2rem;
  }

  .page-eyebrow {
    font-family: 'Space Mono', monospace; font-size: 0.65rem;
    letter-spacing: 0.2em; text-transform: uppercase;
    color: var(--rust); margin-bottom: 0.75rem;
    display: flex; align-items: center; gap: 0.75rem;
  }
  .page-eyebrow::before {
    content: ''; width: 2rem; height: 1px; background: var(--rust);
  }

  .page-title {
    font-family: 'Bebas Neue', sans-serif;
    font-size: clamp(3rem, 6vw, 5rem);
    line-height: 1; letter-spacing: 0.02em; color: var(--paper);
  }

  .page-sub {
    font-style: italic; font-size: 1rem;
    color: var(--ash); margin-top: 0.5rem;
  }

  .page-count {
    font-family: 'Space Mono', monospace; font-size: 0.7rem;
    color: var(--ash); text-align: right;
  }
  .page-count span {
    display: block; font-family: 'Bebas Neue', sans-serif;
    font-size: 3rem; color: var(--rust); line-height: 1;
  }

  .search-bar {
    padding: 1.25rem 2rem;
    border-bottom: 1px solid rgba(139,184,58,0.15);
  }

  .search-input {
    font-family: 'Space Mono', monospace; font-size: 0.75rem;
    background: rgba(28,24,18,0.8);
    border: 1px solid rgba(196,85,26,0.25);
    color: var(--paper); padding: 0.5rem 1rem;
    width: 280px; outline: none; transition: border-color 0.2s;
  }
  .search-input::placeholder { color: var(--ash); opacity: 0.5; }
  .search-input:focus { border-color: var(--rust); }

  .grid-wrap { padding: 2rem; }

  .pests-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1px;
    background: rgba(196,85,26,0.1);
  }

  .pest-card {
    background: var(--bark);
    padding: 0;
    text-decoration: none;
    display: block;
    transition: background 0.2s;
    position: relative;
    overflow: hidden;
  }

  .pest-card::after {
    content: '';
    position: absolute; bottom: 0; left: 0;
    width: 100%; height: 2px;
    background: var(--rust);
    transform: scaleX(0); transform-origin: left;
    transition: transform 0.25s;
  }

  .pest-card:hover { background: rgba(122,59,30,0.2); }
  .pest-card:hover::after { transform: scaleX(1); }
  .pest-card.hidden { display: none; }

  .card-img {
    width: 100%;
    height: 160px;
    object-fit: cover;
    display: block;
    opacity: 0.88;
    transition: opacity 0.2s;
  }

  .pest-card:hover .card-img { opacity: 1; }

  .card-body { padding: 1.25rem; }

  .pest-name {
    font-family: 'Bebas Neue', sans-serif; font-size: 1.5rem;
    letter-spacing: 0.03em; color: var(--paper);
    margin-bottom: 0.2rem; line-height: 1.1;
  }

  .pest-sci {
    font-style: italic; font-size: 0.8rem;
    color: var(--ash); margin-bottom: 0.75rem;
  }

  .pest-desc {
    font-size: 0.875rem; line-height: 1.55;
    color: var(--ash); margin-bottom: 0.75rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .pest-meta {
    display: flex; align-items: center; gap: 1rem;
    font-family: 'Space Mono', monospace; font-size: 0.6rem;
    letter-spacing: 0.08em; text-transform: uppercase;
    color: var(--rust);
  }

  .no-results {
    padding: 4rem 2rem; text-align: center;
    font-family: 'Space Mono', monospace;
    font-size: 0.85rem; color: var(--ash);
    display: none;
  }

  .footer {
    padding: 2rem 4rem;
    border-top: 1px solid rgba(139,184,58,0.15);
    display: flex; justify-content: space-between; align-items: center;
    margin-top: 2rem;
  }
  .footer-logo {
    font-family: 'Bebas Neue', sans-serif; font-size: 1.2rem;
    color: var(--lime); letter-spacing: 0.08em;
  }
  .footer-copy {
    font-family: 'Space Mono', monospace; font-size: 0.65rem; color: var(--ash);
  }

  /* ── Tablet ── */
  @media (max-width: 768px) {
    .page-header { grid-template-columns: 1fr; gap: 1rem; }
    .nav-links { gap: 1rem; }
    .search-input { width: 100%; }
    .footer { flex-direction: column; gap: 1rem; padding: 2rem 1.5rem; }
  }

  /* ── Mobile photo grid ── */
  @media (max-width: 640px) {
    .search-bar {
      padding: 0.75rem 1rem;
    }
    .search-input { width: 100%; }

    .grid-wrap { padding: 0.5rem; }

    .pests-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 2px;
      background: transparent;
    }

    .pest-card::after { display: none; }

    .card-img { height: 110px; }

    .card-body { padding: 0.35rem 0.25rem 0.5rem; }

    .pest-sci,
    .pest-desc,
    .pest-meta { display: none; }

    .pest-name {
      font-size: 0.6rem;
      letter-spacing: 0.01em;
      line-height: 1.2;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
  }
</style>

<nav class="nav">
  <a href="/" class="nav-logo">PermiePortal</a>
  <ul class="nav-links">
    <li><a href="/plants">Plants</a></li>
    <li><a href="/pests" aria-current="true">Pests</a></li>
    <li><a href="/plants/families">Plant Families</a></li>
    <li><a href="/articles">Articles</a></li>
    <li><a href="/about">About</a></li>
  </ul>
</nav>

<div class="page-header">
  <div>
    <p class="page-eyebrow">Organic Solutions Only</p>
    <h1 class="page-title">Pest Index</h1>
    <p class="page-sub">No Roundup. Not ever.</p>
  </div>
  <div class="page-count">
    <span>{pests.length}</span>
    pests profiled
  </div>
</div>

<div class="search-bar">
  <input
    type="search"
    class="search-input"
    placeholder="Search pests..."
    id="pest-search"
    autocomplete="off"
  />
</div>

<div class="grid-wrap">
  <div class="pests-grid" id="pests-grid">
    {pests.map(pest => (
      <a
        href={`/pests/${pest.slug}`}
        class="pest-card"
        data-name={pest.name.toLowerCase()}
        data-sci={pest.scientific_name?.toLowerCase() || ''}
        data-sci={pest.scientific_name?.toLowerCase() || ''}
      >
        {pest.picture
          ? <img class="card-img" src={`/assets/pests/${pest.picture}`} alt={pest.name} loading="lazy" />
          : <div style="width:100%;height:160px;background:var(--rot);opacity:0.25;" />
        }
        <div class="card-body">
          <div class="pest-name">{pest.name}</div>
          {pest.scientific_name && (
            <div class="pest-sci">{pest.scientific_name}</div>
          )}
          {pest.description && (
            <div class="pest-desc">{pest.description}</div>
          )}
          <div class="pest-meta">
            <span>⚠ {pest.affected_plants?.length || 0} plants affected</span>
            {pest.natural_enemies?.length > 0 && (
              <span>{pest.natural_enemies.length} natural enemies</span>
            )}
          </div>
        </div>
      </a>
    ))}
  </div>
  <div class="no-results" id="no-results">
    No pests found. Lucky you.
  </div>
</div>

<footer class="footer">
  <div class="footer-logo">PermiePortal</div>
  <div class="footer-copy">© {new Date().getFullYear()} — Built in a food forest in Yulee, FL</div>
</footer>

<script>
  const search = document.getElementById('pest-search') as HTMLInputElement;
  const grid = document.getElementById('pests-grid')!;
  const allCards = Array.from(grid.querySelectorAll('.pest-card')) as HTMLElement[];
  const noResults = document.getElementById('no-results')!;

  let visibleCount = 60;

  // Sentinel triggers loading more on scroll
  const sentinel = document.createElement('div');
  sentinel.id = 'load-sentinel';
  sentinel.style.height = '1px';
  grid.after(sentinel);

  const observer = new IntersectionObserver(entries => {
    if (entries[0].isIntersecting) {
      visibleCount += 60;
      applyFilters();
    }
  }, { rootMargin: '300px' });
  observer.observe(sentinel);

  function applyFilters(term = '') {
    const isSearching = term.length > 0;
    let shown = 0;
    let matched = 0;
    allCards.forEach(card => {
      const match = !term || card.dataset.name!.includes(term);
      if (match) {
        matched++;
        if (isSearching || shown < visibleCount) {
          card.classList.remove('hidden');
          shown++;
        } else {
          card.classList.add('hidden');
        }
      } else {
        card.classList.add('hidden');
      }
    });
    noResults.style.display = matched === 0 ? 'block' : 'none';
  }

  let currentTerm = '';

  search?.addEventListener('input', e => {
    currentTerm = (e.target as HTMLInputElement).value.toLowerCase().trim();
    applyFilters(currentTerm);
  });

  applyFilters();
</script>

</BaseLayout>
