---
import '../styles.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import ArticleCard from '../components/ArticleCard.astro';

const PAGE_SIZE = 12;
const { page } = Astro.props;

const modules = import.meta.glob('../content/articles/**/*.mdx', { eager: true });
let articles = Object.values(modules).map((m: any) => ({ ...(m.frontmatter || {}), url: m.url }))
  .filter(a => a.title)
  .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());

const totalPages = Math.max(1, Math.ceil(articles.length / PAGE_SIZE));
const currentPage = Math.min(Math.max(parseInt(Astro.url.searchParams.get('page') || '1', 10), 1), totalPages);
const start = (currentPage - 1) * PAGE_SIZE;
const end = start + PAGE_SIZE;
const pageItems = articles.slice(start, end);
---
<header>
  <Navbar />
</header>
<main id="main">
  <h1 class="sr-only">Articles</h1>
  <section class="mt-8" aria-labelledby="articles-list">
    <h2 id="articles-list" class="text-2xl font-bold">Articles</h2>
    <div class="mt-4 grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {pageItems.map((a) => (
        <ArticleCard title={a.title} summary={a.summary} date={a.date} tags={a.tags} href={a.url || `/articles/${a.slug}`} />
      ))}
    </div>
    <nav class="mt-8 flex items-center justify-between" aria-label="Pagination">
      <a aria-disabled={currentPage === 1} class={`px-3 py-2 rounded border ${currentPage === 1 ? 'opacity-50 pointer-events-none' : ''}`} href={`?page=${currentPage - 1}`}>Previous</a>
      <p class="text-sm">Page {currentPage} of {totalPages}</p>
      <a aria-disabled={currentPage === totalPages} class={`px-3 py-2 rounded border ${currentPage === totalPages ? 'opacity-50 pointer-events-none' : ''}`} href={`?page=${currentPage + 1}`}>Next</a>
    </nav>
  </section>
</main>
<Footer />


