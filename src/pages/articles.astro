---
import Navbar from '../components/Navbar.astro';
// src/pages/articles.astro
import BaseLayout from '../components/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { entrySlug } from '../lib/content';

const all = (await getCollection('articles'))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const satire = all.filter(a => a.data.tags?.includes('satire'));
const guides = all.filter(a => !a.data.tags?.includes('satire'));
---

<BaseLayout
  title="Permaculture Articles, Field Notes & Satire | PermiePortal"
  description="Field notes, educational guides, and unfiltered satire about food forests, soil science, lawn culture, and why the grass has to go. No greenwash."
>
<style>
  :root {
    --soil: #0f0d0a; --bark: #1c1812; --moss: #2a3d1f;
    --leaf: #4a7c35; --lime: #8fb83a; --straw: #d4a843;
    --ash: #b8b0a0; --paper: #ede8dc; --rot: #7a3b1e; --rust: #c4551a;
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body { background: var(--soil); color: var(--paper); font-family: 'Instrument Serif', Georgia, serif; overflow-x: hidden; }
  .page-header { padding: 4rem 2rem 3rem; border-bottom: 1px solid rgba(139,184,58,0.15); display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; align-items: end; }
  .page-eyebrow { font-family: 'Space Mono', monospace; font-size: 0.65rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--straw); margin-bottom: 1rem; display: flex; align-items: center; gap: 0.75rem; }
  .page-eyebrow::before { content: ''; width: 2rem; height: 1px; background: var(--straw); }
  .page-title { font-family: 'Bebas Neue', sans-serif; font-size: clamp(4rem, 8vw, 7rem); line-height: 0.9; letter-spacing: 0.02em; color: var(--paper); }
  .page-title em { color: var(--rust); font-style: normal; }
  .page-desc { font-size: 1.1rem; line-height: 1.75; color: var(--ash); }
  .page-desc strong { color: var(--paper); }
  .section-header { padding: 3rem 2rem 1.5rem; display: flex; align-items: baseline; gap: 1.5rem; border-bottom: 1px solid rgba(139,184,58,0.08); }
  .section-number { font-family: 'Bebas Neue', sans-serif; font-size: 4rem; line-height: 1; opacity: 0.12; color: var(--lime); }
  .section-label { font-family: 'Space Mono', monospace; font-size: 0.6rem; letter-spacing: 0.2em; text-transform: uppercase; margin-bottom: 0.3rem; }
  .section-label.rot { color: var(--rust); }
  .section-label.field { color: var(--lime); }
  .section-name { font-family: 'Bebas Neue', sans-serif; font-size: 2.5rem; letter-spacing: 0.03em; color: var(--paper); }
  .section-tagline { font-size: 0.9rem; color: var(--ash); font-style: italic; margin-top: 0.2rem; }
  .article-grid { padding: 2rem; display: grid; grid-template-columns: repeat(auto-fill, minmax(340px, 1fr)); gap: 1.5rem; }
  .article-card { display: block; text-decoration: none; background: var(--bark); border: 1px solid rgba(139,184,58,0.12); transition: all 0.25s; position: relative; overflow: hidden; }
  .article-card::after { content: ''; position: absolute; bottom: 0; left: 0; width: 100%; height: 2px; transform: scaleX(0); transform-origin: left; transition: transform 0.3s; }
  .article-card.rot { border-color: rgba(196,85,26,0.15); }
  .article-card.rot::after { background: var(--rust); }
  .article-card.rot:hover { background: rgba(122,59,30,0.1); border-color: rgba(196,85,26,0.3); }
  .article-card.field::after { background: var(--lime); }
  .article-card.field:hover { background: rgba(42,61,31,0.2); border-color: rgba(139,184,58,0.3); }
  .article-card:hover::after { transform: scaleX(1); }
  .card-image-wrap { width: 100%; aspect-ratio: 16 / 9; overflow: hidden; }
  .card-image { width: 100%; height: 100%; object-fit: contain; display: block; opacity: 0.75; transition: opacity 0.3s, transform 0.4s; }
  .article-card:hover .card-image { opacity: 0.9; transform: scale(1.03); }
  .card-image-placeholder { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; }
  .card-image-placeholder.rot { background: linear-gradient(135deg, rgba(122,59,30,0.5) 0%, var(--bark) 100%); }
  .card-image-placeholder.field { background: linear-gradient(135deg, rgba(42,61,31,0.6) 0%, var(--bark) 100%); }
  .card-image-placeholder span { font-family: 'Space Mono', monospace; font-size: 0.6rem; letter-spacing: 0.2em; text-transform: uppercase; color: rgba(139,184,58,0.25); }
  .card-body { padding: 1.5rem; }
  .card-meta { font-family: 'Space Mono', monospace; font-size: 0.6rem; letter-spacing: 0.12em; text-transform: uppercase; margin-bottom: 0.75rem; }
  .card-meta.rot { color: var(--rust); opacity: 0.8; }
  .card-meta.field { color: var(--lime); opacity: 0.7; }
  .card-title { font-family: 'Bebas Neue', sans-serif; font-size: 1.5rem; letter-spacing: 0.03em; color: var(--paper); margin-bottom: 0.65rem; line-height: 1.1; }
  .card-summary { font-size: 0.88rem; line-height: 1.65; color: var(--ash); margin-bottom: 1.1rem; }
  .card-tags { display: flex; flex-wrap: wrap; gap: 0.35rem; margin-bottom: 1rem; }
  .card-tag { font-family: 'Space Mono', monospace; font-size: 0.58rem; letter-spacing: 0.06em; text-transform: uppercase; padding: 0.15rem 0.55rem; border: 1px solid rgba(139,184,58,0.2); color: var(--ash); }
  .card-tag.satire-tag { border-color: rgba(196,85,26,0.25); color: var(--rust); opacity: 0.8; }
  .card-read { font-family: 'Space Mono', monospace; font-size: 0.65rem; letter-spacing: 0.1em; text-transform: uppercase; display: inline-flex; align-items: center; gap: 0.4rem; }
  .card-read.rot { color: var(--rust); }
  .card-read.field { color: var(--lime); }
  .card-read::after { content: '→'; transition: transform 0.2s; }
  .article-card:hover .card-read::after { transform: translateX(4px); }
  .footer { padding: 2rem 4rem; border-top: 1px solid rgba(139,184,58,0.15); display: flex; justify-content: space-between; align-items: center; margin-top: 2rem; }
  .footer-logo { font-family: 'Bebas Neue', sans-serif; font-size: 1.2rem; color: var(--lime); letter-spacing: 0.08em; }
  .footer-copy { font-family: 'Space Mono', monospace; font-size: 0.65rem; color: var(--ash); }
  @media (max-width: 768px) {
    .page-header { grid-template-columns: 1fr; gap: 1.5rem; padding: 2.5rem 1.5rem; }
    .article-grid { grid-template-columns: 1fr; padding: 1.5rem; }
    .footer { flex-direction: column; gap: 1rem; text-align: center; padding: 2rem 1.5rem; }
  }
</style>

<Navbar />

<main>
<div class="page-header">
  <div>
    <p class="page-eyebrow">Field Notes & Rotten Articles</p>
    <h1 class="page-title">Read<br>Something<br><em>Useful.</em></h1>
  </div>
  <div>
    <p class="page-desc">
      Two kinds of content. <strong>Field Notes</strong> — practical guides, plant deep-dives,
      and soil science worth knowing. <strong>Rotten Articles</strong> — satire sharp enough
      to leave a mark. Both aim at the same target: the gap between what we're told and what's
      actually happening in the dirt.
    </p>
  </div>
</div>

{satire.length > 0 && (
  <div>
    <div class="section-header">
      <div class="section-number">01</div>
      <div class="section-info">
        <div class="section-label rot">Satire / Dark Humor</div>
        <div class="section-name">Rotten Articles</div>
        <div class="section-tagline">Truth dressed up as comedy. The joke is always on the system.</div>
      </div>
    </div>
    <div class="article-grid">
      {satire.map(a => (
        <a href={`/articles/${entrySlug(a)}`} class="article-card rot">
          <div class="card-image-wrap">
            {a.data.image ? (
              <img class="card-image" src={a.data.image} alt={a.data.title} loading="lazy" />
            ) : (
              <div class="card-image-placeholder rot"><span>Rotten Articles</span></div>
            )}
          </div>
          <div class="card-body">
            <div class="card-meta rot">{new Date(a.data.date).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}</div>
            <div class="card-title">{a.data.title}</div>
            <p class="card-summary">{a.data.summary}</p>
            <div class="card-tags">
              {(a.data.tags || []).map((t: string) => (
                <span class={`card-tag ${t === 'satire' ? 'satire-tag' : ''}`}>{t}</span>
              ))}
            </div>
            <span class="card-read rot">Read it</span>
          </div>
        </a>
      ))}
    </div>
  </div>
)}

{guides.length > 0 && (
  <div>
    <div class="section-header">
      <div class="section-number">02</div>
      <div class="section-info">
        <div class="section-label field">Guides / Deep Dives</div>
        <div class="section-name">Field Notes</div>
        <div class="section-tagline">Practical knowledge from people who actually grow things.</div>
      </div>
    </div>
    <div class="article-grid">
      {guides.map(a => (
        <a href={`/articles/${entrySlug(a)}`} class="article-card field">
          <div class="card-image-wrap">
            {a.data.image ? (
              <img class="card-image" src={a.data.image} alt={a.data.title} loading="lazy" />
            ) : (
              <div class="card-image-placeholder field"><span>Field Notes</span></div>
            )}
          </div>
          <div class="card-body">
            <div class="card-meta field">{new Date(a.data.date).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}</div>
            <div class="card-title">{a.data.title}</div>
            <p class="card-summary">{a.data.summary}</p>
            <div class="card-tags">
              {(a.data.tags || []).map((t: string) => (
                <span class="card-tag">{t}</span>
              ))}
            </div>
            <span class="card-read field">Read it</span>
          </div>
        </a>
      ))}
    </div>
  </div>
)}

</main>
<footer class="footer">
  <div class="footer-logo">PermiePortal</div>
  <div class="footer-copy">© {new Date().getFullYear()} PermiePortal</div>
</footer>

</BaseLayout>
