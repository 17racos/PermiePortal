---
// src/pages/index.astro
import BaseLayout from '../components/layouts/BaseLayout.astro';
import plantsData from '../data/plants.json';
import pestsData from '../data/pests.json';

const plantCount = plantsData.length;
const pestCount = pestsData.length;

// Random featured plant on each build
const featuredPlant = plantsData[Math.floor(Math.random() * plantsData.length)];

// Ticker messages — voice: dark, specific, earned
const tickerMessages = [
  // insight → insight → punch → insight → punch
  `${plantCount} plants documented. Zero of them are grass.`,
  "Soil has more living organisms per teaspoon than there are people on Earth.",
  "Your lawn costs more to maintain than it will ever produce. That is the point.",
  "Diversity is not aesthetic. It is biological insurance.",
  "Every time you mow you are literally paying to own nothing.",

  "Companion planting isn't mysticism. It's chemistry that predates Dow Chemical by ten thousand years.",
  "Nature stacks functions. Lawns delete them.",
  "Your HOA is enforcing an aesthetic invented by 17th century English aristocrats.",
  "Healthy systems make problems rare. Sick systems make inputs profitable.",
  "You are not maintaining a lawn. You are financing one.",

  `${pestCount} pests documented. Every single one has a natural enemy. Use it.`,
  "If bugs are eating your plant, something bigger should be eating the bugs.",
  "Neem oil is not a personality. It's a starting point.",
  "Compost is time doing what fertilizer pretends to.",
  "If it only works in perfect conditions, it doesn't work.",

  "Most plant problems start underground and announce themselves late.",
  "The soil food web has been running longer than any government. It knows what it's doing.",
  "We subsidize the crops that make us sick and charge for the ones that don't.",
  "Permaculture is pattern recognition applied over time.",
  "Your yard could feed a family. Instead it feeds a mower payment.",

  "Lake Huron is crystal clear. That's the bad news.",
  "A food forest requires less maintenance than a lawn after year three.",
  "The first three years are just spite.",
  "Weeds: free, drought-tolerant, pollinator habitat. Grass: eighty dollars a month and a bad back.",
  "Genghis Khan rewilded a continent. Nobody gave him a grant.",

  "If everything is a pest, your system is the problem.",
  "You don't need more inputs. You need better conditions.",
  "Information should be free. That's why this exists.",
  "Diversity is resilience. Monoculture is a liability that hasn't matured yet.",
  "Every grasshole is a food forest that hasn't happened yet.",
];
---

<BaseLayout
  title="PermiePortal — Permaculture Plants, Pest Control & Food Forest Guides"
  description="1000+ permaculture plants, 200 organic pest profiles, food forest guides, and unfiltered satire about why your lawn is the problem. Built in a food forest in Yulee, FL."
>
<style>
  :root {
    --soil: #0f0d0a; --bark: #1c1812; --moss: #2a3d1f;
    --leaf: #4a7c35; --lime: #8fb83a; --straw: #d4a843;
    --ash: #b8b0a0; --paper: #ede8dc; --rot: #7a3b1e; --rust: #c4551a;
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }
  body { background: var(--soil); color: var(--paper); font-family: 'Instrument Serif', Georgia, serif; overflow-x: hidden; }

  body::before {
    content: ''; position: fixed; inset: 0;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)' opacity='0.04'/%3E%3C/svg%3E");
    pointer-events: none; z-index: 0; opacity: 0.4;
  }

  /* NAV */
  .nav { display: flex; justify-content: space-between; align-items: center; padding: 1.5rem 2rem; border-bottom: 1px solid rgba(139,184,58,0.2); position: relative; z-index: 10; }
  .nav-logo { font-family: 'Bebas Neue', sans-serif; font-size: 1.8rem; letter-spacing: 0.08em; color: var(--lime); text-decoration: none; }
  .nav-links { display: flex; gap: 2rem; list-style: none; }
  .nav-links a { font-family: 'Space Mono', monospace; font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.12em; color: var(--ash); text-decoration: none; transition: color 0.2s; }
  .nav-links a:hover { color: var(--lime); }

  /* HERO */
  .hero { position: relative; min-height: 92vh; display: grid; grid-template-columns: 1fr 1fr; align-items: center; padding: 4rem 2rem 4rem 4rem; gap: 4rem; overflow: hidden; }
  .hero::before { content: ''; position: absolute; right: -10%; top: -20%; width: 70%; height: 120%; background: radial-gradient(ellipse at center, rgba(42,61,31,0.6) 0%, transparent 70%); border-radius: 40% 60% 70% 30% / 40% 50% 60% 50%; pointer-events: none; }
  .hero-text { position: relative; z-index: 2; }

  .hero-eyebrow { font-family: 'Space Mono', monospace; font-size: 0.7rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--lime); margin-bottom: 1.5rem; display: flex; align-items: center; gap: 0.75rem; }
  .hero-eyebrow::before { content: ''; display: inline-block; width: 2rem; height: 1px; background: var(--lime); }

  .hero-headline { font-family: 'Bebas Neue', sans-serif; font-size: clamp(4rem, 9vw, 8rem); line-height: 0.92; letter-spacing: 0.02em; color: var(--paper); margin-bottom: 1.5rem; }
  .hero-headline em { color: var(--lime); font-style: normal; }
  .hero-headline .strike { position: relative; color: var(--ash); }
  .hero-headline .strike::after { content: ''; position: absolute; left: 0; top: 50%; width: 100%; height: 3px; background: var(--rust); transform: rotate(-2deg); }

  .hero-sub { font-size: 1.2rem; line-height: 1.65; color: var(--ash); max-width: 480px; margin-bottom: 2.5rem; font-style: italic; }
  .hero-sub strong { color: var(--paper); font-style: normal; }

  .hero-cta-group { display: flex; gap: 1rem; flex-wrap: wrap; }

  .btn-primary { font-family: 'Space Mono', monospace; font-size: 0.78rem; letter-spacing: 0.1em; text-transform: uppercase; padding: 0.9rem 1.8rem; background: var(--lime); color: var(--soil); text-decoration: none; font-weight: 700; transition: all 0.2s; clip-path: polygon(0 0, calc(100% - 12px) 0, 100% 12px, 100% 100%, 12px 100%, 0 calc(100% - 12px)); }
  .btn-primary:hover { background: var(--straw); transform: translateY(-2px); }

  .btn-ghost { font-family: 'Space Mono', monospace; font-size: 0.78rem; letter-spacing: 0.1em; text-transform: uppercase; padding: 0.9rem 1.8rem; border: 1px solid rgba(139,184,58,0.4); color: var(--lime); text-decoration: none; transition: all 0.2s; clip-path: polygon(0 0, calc(100% - 12px) 0, 100% 12px, 100% 100%, 12px 100%, 0 calc(100% - 12px)); }
  .btn-ghost:hover { border-color: var(--lime); background: rgba(139,184,58,0.08); }

  /* STATS PANEL */
  .hero-panel { position: relative; z-index: 2; background: rgba(28,24,18,0.8); border: 1px solid rgba(139,184,58,0.25); padding: 2.5rem; backdrop-filter: blur(4px); }
  .hero-panel::before { content: '// FIELD DATABASE'; font-family: 'Space Mono', monospace; font-size: 0.65rem; letter-spacing: 0.15em; color: var(--lime); opacity: 0.7; display: block; margin-bottom: 2rem; }

  .stat-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; margin-bottom: 2rem; }
  .stat { border-left: 2px solid var(--moss); padding-left: 1rem; }
  .stat-number { font-family: 'Bebas Neue', sans-serif; font-size: 3.5rem; line-height: 1; color: var(--lime); }
  .stat-label { font-family: 'Space Mono', monospace; font-size: 0.65rem; text-transform: uppercase; letter-spacing: 0.12em; color: var(--ash); margin-top: 0.25rem; }

  .featured-plant { border-top: 1px solid rgba(139,184,58,0.15); padding-top: 1.5rem; }
  .featured-label { font-family: 'Space Mono', monospace; font-size: 0.65rem; letter-spacing: 0.15em; text-transform: uppercase; color: var(--straw); margin-bottom: 0.5rem; }
  .featured-name { font-family: 'Bebas Neue', sans-serif; font-size: 1.8rem; color: var(--paper); letter-spacing: 0.05em; }
  .featured-sci { font-style: italic; font-size: 0.85rem; color: var(--ash); margin-bottom: 0.75rem; }
  .featured-tags { display: flex; flex-wrap: wrap; gap: 0.4rem; }
  :global(.tag) { font-family: 'Space Mono', monospace; font-size: 0.6rem; letter-spacing: 0.08em; padding: 0.2rem 0.6rem; background: rgba(42,61,31,0.6); border: 1px solid rgba(74,124,53,0.4); color: var(--lime); text-transform: uppercase; }
  .featured-img { width: 100%; aspect-ratio: 16 / 9; object-fit: cover; display: block; opacity: 0.85; margin-bottom: 1rem; }

  /* TICKER */
  .rant-bar { background: var(--moss); padding: 0.75rem 0; overflow: hidden; border-top: 1px solid rgba(139,184,58,0.2); border-bottom: 1px solid rgba(139,184,58,0.2); position: relative; z-index: 5; }
  .rant-track { display: flex; width: max-content; animation: ticker 140s linear infinite; }
  .rant-track:hover { animation-play-state: paused; cursor: default; }
  .rant-segment { display: flex; align-items: center; white-space: nowrap; }
  .rant-item { font-family: 'Space Mono', monospace; font-size: 0.75rem; color: var(--lime); letter-spacing: 0.04em; padding: 0 2rem; }
  .rant-dot { color: var(--straw); font-size: 0.5rem; opacity: 0.7; }

  @keyframes ticker {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }

  /* THREE PILLARS */
  .pillars { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0; border-top: 1px solid rgba(139,184,58,0.15); }
  .pillar { padding: 3rem 2.5rem; border-right: 1px solid rgba(139,184,58,0.15); text-decoration: none; display: block; transition: background 0.3s; position: relative; overflow: hidden; }
  .pillar:last-child { border-right: none; }
  .pillar::before { content: ''; position: absolute; bottom: 0; left: 0; width: 100%; height: 2px; background: var(--lime); transform: scaleX(0); transform-origin: left; transition: transform 0.3s; }
  .pillar:hover { background: rgba(42,61,31,0.3); }
  .pillar:hover::before { transform: scaleX(1); }

  .pillar-number { font-family: 'Bebas Neue', sans-serif; font-size: 5rem; line-height: 1; color: rgba(139,184,58,0.12); margin-bottom: 1rem; transition: color 0.3s; }
  .pillar:hover .pillar-number { color: rgba(139,184,58,0.25); }
  .pillar-icon { font-size: 1.8rem; margin-bottom: 1rem; display: block; }
  .pillar-title { font-family: 'Bebas Neue', sans-serif; font-size: 2rem; letter-spacing: 0.05em; color: var(--paper); margin-bottom: 0.75rem; }
  .pillar-desc { font-size: 0.95rem; line-height: 1.6; color: var(--ash); margin-bottom: 1.5rem; }
  .pillar-link { font-family: 'Space Mono', monospace; font-size: 0.7rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--lime); display: flex; align-items: center; gap: 0.5rem; }
  .pillar-link::after { content: '→'; transition: transform 0.2s; }
  .pillar:hover .pillar-link::after { transform: translateX(4px); }

  /* MANIFESTO */
  .manifesto { background: var(--bark); padding: 5rem 4rem; border-top: 1px solid rgba(139,184,58,0.15); display: grid; grid-template-columns: 1fr 2fr; gap: 4rem; align-items: start; }
  .manifesto-left { position: sticky; top: 2rem; }
  .manifesto-label { font-family: 'Space Mono', monospace; font-size: 0.65rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--straw); margin-bottom: 1rem; }
  .manifesto-title { font-family: 'Bebas Neue', sans-serif; font-size: 3.5rem; line-height: 1; color: var(--paper); letter-spacing: 0.03em; }

  .manifesto-body { font-size: 1.15rem; line-height: 1.85; color: var(--ash); }
  .manifesto-body p { margin-bottom: 1.5rem; }
  .manifesto-body p:last-child { margin-bottom: 0; }
  .manifesto-body strong { color: var(--paper); font-weight: normal; }
  .manifesto-body em { color: var(--lime); font-style: normal; }



  /* FOOTER */
  .footer { padding: 2rem 4rem; border-top: 1px solid rgba(139,184,58,0.15); display: flex; justify-content: space-between; align-items: center; }
  .footer-logo { font-family: 'Bebas Neue', sans-serif; font-size: 1.2rem; color: var(--lime); letter-spacing: 0.08em; }
  .footer-copy { font-family: 'Space Mono', monospace; font-size: 0.65rem; color: var(--ash); letter-spacing: 0.08em; }

  /* ANIMATIONS */
  /* START HERE */
  .start-here { padding: 5rem 4rem; background: var(--soil); border-top: 1px solid rgba(139,184,58,0.15); border-bottom: 1px solid rgba(139,184,58,0.15); }
  .start-here-inner { max-width: 1200px; margin: 0 auto; }
  .start-here-header { margin-bottom: 3rem; }
  .start-eyebrow { font-family: 'Space Mono', monospace; font-size: 0.65rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--lime); margin-bottom: 0.75rem; display: flex; align-items: center; gap: 0.75rem; }
  .start-eyebrow::before { content: ''; width: 2rem; height: 1px; background: var(--lime); display: inline-block; }
  .start-title { font-family: 'Bebas Neue', sans-serif; font-size: clamp(2.5rem, 5vw, 4rem); color: var(--paper); letter-spacing: 0.02em; line-height: 1; margin-bottom: 0.75rem; }
  .start-sub { font-family: 'Instrument Serif', serif; font-style: italic; color: var(--ash); font-size: 1.1rem; }
  .start-cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 1px; background: rgba(139,184,58,0.1); border: 1px solid rgba(139,184,58,0.1); }
  .start-card { display: flex; align-items: center; gap: 1.5rem; padding: 1.5rem 2rem; background: var(--bark); text-decoration: none; transition: background 0.2s; }
  .start-card:hover { background: rgba(42,61,31,0.5); }
  .start-card-number { font-family: 'Bebas Neue', sans-serif; font-size: 2.5rem; color: rgba(139,184,58,0.2); line-height: 1; min-width: 3rem; }
  .start-card-content { flex: 1; }
  .start-card-title { font-family: 'Space Mono', monospace; font-size: 0.75rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--paper); margin-bottom: 0.4rem; }
  .start-card-desc { font-family: 'Instrument Serif', serif; font-style: italic; font-size: 0.95rem; color: var(--ash); line-height: 1.4; }
  .start-card-arrow { font-size: 1.2rem; color: var(--lime); opacity: 0.4; transition: opacity 0.2s, transform 0.2s; }
  .start-card:hover .start-card-arrow { opacity: 1; transform: translateX(4px); }
  @media (max-width: 768px) { .start-here { padding: 3rem 1.5rem; } .start-cards { grid-template-columns: 1fr; } }

  /* RANDOM PLANT SECTION */
  .random-plant-section { padding: 4rem 4rem; background: var(--bark); border-top: 1px solid rgba(139,184,58,0.15); border-bottom: 1px solid rgba(139,184,58,0.15); }
  .random-plant-inner { max-width: 1200px; margin: 0 auto; }
  .random-eyebrow { font-family: 'Space Mono', monospace; font-size: 0.65rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--lime); margin-bottom: 0.5rem; display: flex; align-items: center; gap: 0.75rem; }
  .random-eyebrow::before { content: ''; width: 2rem; height: 1px; background: var(--lime); display: inline-block; }
  .random-title { font-family: 'Bebas Neue', sans-serif; font-size: clamp(2rem, 4vw, 3rem); color: var(--paper); letter-spacing: 0.02em; margin-bottom: 1.5rem; }
  .random-card { max-width: 480px; }
  .random-card-link { display: flex; gap: 1.5rem; text-decoration: none; align-items: flex-start; }
  .random-img { width: 140px; height: 140px; object-fit: cover; border: 1px solid rgba(139,184,58,0.2); flex-shrink: 0; }
  .random-card-body { flex: 1; }
  .random-label { font-family: 'Space Mono', monospace; font-size: 0.6rem; letter-spacing: 0.15em; text-transform: uppercase; color: var(--lime); margin-bottom: 0.5rem; }
  .random-name { font-family: 'Bebas Neue', sans-serif; font-size: 1.8rem; color: var(--paper); line-height: 1; margin-bottom: 0.25rem; letter-spacing: 0.02em; }
  .random-sci { font-style: italic; font-size: 0.9rem; color: var(--ash); margin-bottom: 0.75rem; }
  .random-tags { display: flex; flex-wrap: wrap; gap: 0.4rem; }
  @media (max-width: 768px) { .random-plant-section { padding: 3rem 1.5rem; } .random-card-link { flex-direction: column; } .random-img { width: 100%; height: 200px; } }

  .random-btn { margin-top: 1.25rem; display: inline-flex; align-items: center; gap: 0.5rem; font-family: 'Space Mono', monospace; font-size: 0.7rem; letter-spacing: 0.1em; text-transform: uppercase; padding: 0.6rem 1.25rem; background: transparent; border: 1px solid rgba(139,184,58,0.3); color: var(--lime); cursor: pointer; transition: all 0.2s; }
  .random-btn:hover { border-color: var(--lime); background: rgba(139,184,58,0.08); }
  .random-btn span { font-size: 1rem; }

  @keyframes fadeUp { from { opacity: 0; transform: translateY(24px); } to { opacity: 1; transform: translateY(0); } }
  .hero-eyebrow { animation: fadeUp 0.6s ease both; }
  .hero-headline { animation: fadeUp 0.6s 0.1s ease both; }
  .hero-sub      { animation: fadeUp 0.6s 0.2s ease both; }
  .hero-cta-group{ animation: fadeUp 0.6s 0.3s ease both; }
  .hero-panel    { animation: fadeUp 0.6s 0.15s ease both; }

  .nav-hamburger { display: none; background: none; border: 1px solid rgba(139,184,58,0.3); padding: 0.4rem 0.7rem; cursor: pointer; color: var(--lime); font-size: 1.2rem; line-height: 1; }
  .nav-links-mobile { display: none; }

  @media (max-width: 900px) {
    .nav-links { display: none; }
    .hero { grid-template-columns: 1fr; padding: 3rem 1.5rem; min-height: auto; gap: 3rem; }
    .hero::before { display: none; }
    .pillars { grid-template-columns: 1fr; }
    .pillar { border-right: none; border-bottom: 1px solid rgba(139,184,58,0.15); }
    .manifesto { grid-template-columns: 1fr; gap: 2rem; padding: 3rem 1.5rem; }
    .manifesto-left { position: static; }
    .ask-strip { grid-template-columns: 1fr; padding: 3rem 1.5rem; }
    .footer { flex-direction: column; gap: 1rem; text-align: center; padding: 2rem 1.5rem; }
    .nav { padding: 1.25rem 1.5rem; }
    .nav-links { gap: 1.2rem; }
    .nav-hamburger { display: flex; }
    .nav-links-mobile { display: none; }
    .nav-links-mobile.open { display: flex; flex-direction: column; position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(15,13,10,0.98); z-index: 200; justify-content: center; align-items: center; gap: 2rem; }
    .nav-links-mobile.open a { font-family: 'Space Mono', monospace; font-size: 1.1rem; text-transform: uppercase; letter-spacing: 0.15em; color: var(--ash); text-decoration: none; }
    .nav-links-mobile.open a:hover { color: var(--lime); }
    .nav-links-desktop { display: none; }
    .nav-close { position: absolute; top: 1.5rem; right: 1.5rem; font-family: 'Space Mono', monospace; font-size: 0.8rem; color: var(--ash); background: none; border: 1px solid rgba(184,176,160,0.3); padding: 0.4rem 0.75rem; cursor: pointer; letter-spacing: 0.1em; }
  }
</style>

<nav class="nav">
  <a href="/" class="nav-logo">PermiePortal</a>
  <ul class="nav-links">
    <li><a href="/plants">Plants</a></li>
    <li><a href="/pests">Pests</a></li>
    <li><a href="/diagnose">Diagnose</a></li>
    <li><a href="/articles">Articles</a></li>
    <li><a href="/projects">Projects</a></li>
    <li><a href="/about">About</a></li>
  </ul>
  <button class="nav-hamburger" id="nav-open" aria-label="Open menu">☰</button>
</nav>

<!-- Mobile nav overlay -->
<div class="nav-links-mobile" id="nav-mobile">
  <button class="nav-close" id="nav-close">✕ close</button>
  <a href="/plants">Plants</a>
  <a href="/pests">Pests</a>
  <a href="/diagnose">Diagnose</a>
  <a href="/articles">Articles</a>
  <a href="/projects">Projects</a>
  <a href="/about">About</a>
</div>

<script is:inline>
  document.addEventListener('DOMContentLoaded', function() {
    var btn = document.getElementById('nav-open');
    var close = document.getElementById('nav-close');
    var menu = document.getElementById('nav-mobile');
    if (btn) btn.addEventListener('click', function() { menu.classList.add('open'); document.body.style.overflow = 'hidden'; });
    if (close) close.addEventListener('click', function() { menu.classList.remove('open'); document.body.style.overflow = ''; });
    if (menu) menu.querySelectorAll('a').forEach(function(a) {
      a.addEventListener('click', function() { menu.classList.remove('open'); document.body.style.overflow = ''; });
    });
  });
</script>

<div class="rant-bar" aria-hidden="true">
  <div class="rant-track">
    {[...tickerMessages, ...tickerMessages].map((msg, i) => (
      <span class="rant-segment">
        <span class="rant-dot">⬤</span>
        <span class="rant-item">{msg}</span>
      </span>
    ))}
  </div>
</div>


<section class="hero">
  <div class="hero-text">
    <p class="hero-eyebrow">Permaculture. Unfiltered.</p>
    <h1 class="hero-headline">
      Burn<br>
      the <span class="strike">grass</span><br>
      <em>grasshole.</em>
    </h1>
    <p class="hero-sub">
      A <strong>field guide, a rant, and a genuinely useful database</strong>
      for people done pretending monocultures make sense.
      No greenwash. No HOA compliance. Just soil, biology, and the occasional scorched earth metaphor.
    </p>

  </div>

  <div class="hero-panel">
    <div class="stat-row">
      <div class="stat">
        <div class="stat-number">{plantCount}</div>
        <div class="stat-label">Plants Documented</div>
      </div>
      <div class="stat">
        <div class="stat-number">{pestCount}</div>
        <div class="stat-label">Organic Pest Profiles</div>
      </div>
    </div>

  </div>
</section>



<!-- TICKER — duplicated for seamless loop -->
<section class="start-here">
  <div class="start-here-inner">
    <div class="start-here-header">
      <p class="start-eyebrow">New here?</p>
      <h2 class="start-title">Start Here</h2>
      <p class="start-sub">No jargon. No gatekeeping. Just the path in.</p>
    </div>
    <div class="start-cards">
      <a href="/diagnose" class="start-card">
        <div class="start-card-number">01</div>
        <div class="start-card-content">
          <div class="start-card-title">Something is eating my plants</div>
          <div class="start-card-desc">Pick what you see. We'll show you what's causing it and how to stop it without chemicals.</div>
        </div>
        <span class="start-card-arrow">→</span>
      </a>
      <a href="/plants" class="start-card">
        <div class="start-card-number">02</div>
        <div class="start-card-content">
          <div class="start-card-title">I need a plant that does something</div>
