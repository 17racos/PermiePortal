---
import '../styles.css';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import ArticleCard from '../components/ArticleCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import CTA from '../components/CTA.astro';
import Footer from '../components/Footer.astro';

// Pull latest 3 articles and projects
const articleImports = import.meta.glob('../content/articles/**/*.mdx', { eager: true });
const articles = Object.values(articleImports)
  .map((m: any) => ({ ...(m.frontmatter || {}), url: m.url }))
  .filter(a => a.title)
  .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime())
  .slice(0, 3);

const projectImports = import.meta.glob('../content/projects/**/*.mdx', { eager: true });
const projects = Object.values(projectImports)
  .map((m: any) => ({ ...(m.frontmatter || {}), url: m.url }))
  .filter(p => p.title)
  .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime())
  .slice(0, 3);
---
<header>
  <Navbar />
</header>
<main id="main">
  <Hero />

  <section class="mt-10" aria-labelledby="latest-articles">
    <h2 id="latest-articles" class="text-2xl font-bold">Latest Articles</h2>
    <div class="mt-4 grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {articles.map((a) => (
        <ArticleCard title={a.title} summary={a.summary} date={a.date} tags={a.tags} href={a.url || `/articles/${a.slug}`} />
      ))}
    </div>
  </section>

  <section class="mt-12" aria-labelledby="latest-projects">
    <h2 id="latest-projects" class="text-2xl font-bold">Latest Projects</h2>
    <div class="mt-4 grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {projects.map((p) => (
        <ProjectCard title={p.title} summary={p.summary} date={p.date} tags={p.tags} href={p.url || `/projects/${p.slug}`} />
      ))}
    </div>
  </section>

  <CTA />
</main>
<Footer />


