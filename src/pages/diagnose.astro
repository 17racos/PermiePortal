---
import BaseLayout from '../components/layouts/BaseLayout.astro';
import pestsData from '../data/pests.json';

const SYMPTOM_LABELS: Record<string, string> = {
  'holes-in-leaves':    '🕳️ Holes in leaves',
  'yellowing-leaves':   '🟡 Yellowing leaves',
  'wilting':            '😩 Wilting',
  'sticky-residue':     '🍯 Sticky residue',
  'white-powder':       '🤍 White powder',
  'leaf-spots':         '🔵 Leaf spots',
  'curling-leaves':     '🌀 Curling leaves',
  'webbing':            '🕸️ Webbing',
  'chewed-stems':       '🪲 Chewed stems',
  'stem-damage':        '🪵 Stem damage',
  'root-damage':        '🌱 Root damage',
  'fruit-damage':       '🍎 Fruit damage',
  'black-coating':      '⚫ Black coating',
  'distorted-growth':   '🌿 Distorted growth',
  'tunneling':          '🔩 Tunneling',
  'galls':              '🫧 Galls',
  'dropping-leaves':    '🍂 Dropping leaves',
  'silvery-streaking':  '✨ Silvery streaking',
  'brown-edges':        '🟤 Brown edges',
  'die-back':           '💀 Die-back',
  'sooty-deposits':     '🖤 Sooty deposits',
  'slime-trails':       '🐌 Slime trails',
  'skeletonized-leaves':'🦴 Skeletonized leaves',
  'bark-damage':        '🌳 Bark damage',
  'crown-damage':       '👑 Crown damage',
};

const allSymptoms = Object.keys(SYMPTOM_LABELS);
---
<BaseLayout
  title="Diagnose My Plant — What's Wrong With My Garden? | PermiePortal"
  description="Can't identify the pest damaging your plants? Select the symptoms you see and PermiePortal will show you the most likely culprits with organic control options."
>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Instrument+Serif:ital@0;1&family=Space+Mono:ital,wght@0,400;0,700;1,400&display=swap');
  :root {
    --soil: #0f0d0a; --bark: #1c1812; --moss: #2a3d1f;
    --leaf: #4a7c35; --lime: #8fb83a; --straw: #d4a843;
    --ash: #b8b0a0; --paper: #ede8dc; --rot: #7a3b1e; --rust: #c4551a;
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body { background: var(--soil); color: var(--paper); font-family: 'Instrument Serif', Georgia, serif; }

  .nav { display: flex; justify-content: space-between; align-items: center; padding: 1.5rem 2rem; border-bottom: 1px solid rgba(139,184,58,0.2); position: sticky; top: 0; z-index: 100; background: rgba(15,13,10,0.97); backdrop-filter: blur(8px); }
  .nav-logo { font-family: 'Bebas Neue', sans-serif; font-size: 1.8rem; letter-spacing: 0.08em; color: var(--lime); text-decoration: none; }
  .nav-links { display: flex; gap: 2rem; list-style: none; }
  .nav-links a { font-family: 'Space Mono', monospace; font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.12em; color: var(--ash); text-decoration: none; transition: color 0.2s; }
  .nav-links a:hover { color: var(--lime); }

  .page-header { padding: 4rem 2rem 2rem; border-bottom: 1px solid rgba(139,184,58,0.15); }
  .page-eyebrow { font-family: 'Space Mono', monospace; font-size: 0.65rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--rust); margin-bottom: 1rem; display: flex; align-items: center; gap: 0.75rem; }
  .page-eyebrow::before { content: ''; width: 2rem; height: 1px; background: var(--rust); }
  .page-title { font-family: 'Bebas Neue', sans-serif; font-size: clamp(3rem, 7vw, 6rem); line-height: 0.92; color: var(--paper); margin-bottom: 1rem; }
  .page-title em { color: var(--rust); font-style: normal; }
  .page-sub { font-size: 1.1rem; color: var(--ash); max-width: 600px; line-height: 1.7; font-style: italic; }

  .diagnose-wrap { max-width: 1200px; margin: 0 auto; padding: 2rem; display: grid; grid-template-columns: 320px 1fr; gap: 2rem; align-items: start; }

  /* SYMPTOM PICKER */
  .picker { position: sticky; top: 5rem; }
  .picker-label { font-family: 'Space Mono', monospace; font-size: 0.65rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--straw); margin-bottom: 1rem; }
  .symptom-grid { display: flex; flex-direction: column; gap: 0.4rem; }
  .symptom-btn { display: flex; align-items: center; gap: 0.75rem; padding: 0.6rem 1rem; background: var(--bark); border: 1px solid rgba(139,184,58,0.15); color: var(--ash); font-family: 'Space Mono', monospace; font-size: 0.68rem; letter-spacing: 0.05em; cursor: pointer; transition: all 0.15s; text-align: left; }
  .symptom-btn:hover { border-color: rgba(139,184,58,0.4); color: var(--paper); }
  .symptom-btn.selected { background: rgba(42,61,31,0.6); border-color: var(--lime); color: var(--lime); }
  .symptom-btn .check { width: 14px; height: 14px; border: 1px solid currentColor; flex-shrink: 0; display: flex; align-items: center; justify-content: center; font-size: 0.6rem; }
  .clear-btn { margin-top: 1rem; width: 100%; padding: 0.6rem; font-family: 'Space Mono', monospace; font-size: 0.65rem; letter-spacing: 0.1em; text-transform: uppercase; background: transparent; border: 1px solid rgba(196,85,26,0.3); color: var(--rust); cursor: pointer; transition: all 0.2s; }
  .clear-btn:hover { border-color: var(--rust); background: rgba(122,59,30,0.2); }

  /* RESULTS */
  .results-header { font-family: 'Space Mono', monospace; font-size: 0.65rem; letter-spacing: 0.15em; text-transform: uppercase; color: var(--ash); margin-bottom: 1.5rem; min-height: 1.2rem; }
  .results-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 1rem; }

  :global(.pest-card) { display: block; text-decoration: none; background: var(--bark); border: 1px solid rgba(196,85,26,0.15); transition: all 0.2s; }
  :global(.pest-card:hover) { border-color: rgba(196,85,26,0.4); background: rgba(122,59,30,0.1); }
  :global(.pest-card-img) { width: 100%; height: 160px; object-fit: cover; opacity: 0.8; }
  :global(.pest-card-img-placeholder) { width: 100%; height: 160px; background: linear-gradient(135deg, rgba(122,59,30,0.4), var(--bark)); display: flex; align-items: center; justify-content: center; }
  :global(.pest-card-body) { padding: 1rem; }
  :global(.pest-card-name) { font-family: 'Bebas Neue', sans-serif; font-size: 1.3rem; letter-spacing: 0.03em; color: var(--paper); margin-bottom: 0.4rem; }
  :global(.pest-card-sci) { font-style: italic; font-size: 0.8rem; color: var(--ash); margin-bottom: 0.6rem; }
  :global(.pest-card-symptoms) { display: flex; flex-wrap: wrap; gap: 0.3rem; margin-bottom: 0.75rem; }
  :global(.pest-symptom-tag) { font-family: 'Space Mono', monospace; font-size: 0.55rem; letter-spacing: 0.05em; padding: 0.2rem 0.5rem; background: rgba(196,85,26,0.15); border: 1px solid rgba(196,85,26,0.25); color: var(--rust); }
  :global(.pest-symptom-tag.matched) { background: rgba(42,61,31,0.4); border-color: rgba(139,184,58,0.4); color: var(--lime); }
  :global(.pest-card-link) { font-family: 'Space Mono', monospace; font-size: 0.6rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--rust); }
  :global(.match-score) { font-family: 'Bebas Neue', sans-serif; font-size: 1rem; color: var(--lime); float: right; }

  .empty-state { grid-column: 1 / -1; padding: 4rem 2rem; text-align: center; border: 1px dashed rgba(139,184,58,0.2); }
  .empty-state-title { font-family: 'Bebas Neue', sans-serif; font-size: 2rem; color: var(--ash); margin-bottom: 0.5rem; }
  .empty-state-sub { font-size: 0.9rem; color: var(--ash); opacity: 0.6; font-style: italic; }

  .footer { padding: 2rem 4rem; border-top: 1px solid rgba(139,184,58,0.15); display: flex; justify-content: space-between; align-items: center; margin-top: 4rem; }
  .footer-logo { font-family: 'Bebas Neue', sans-serif; font-size: 1.2rem; color: var(--lime); letter-spacing: 0.08em; }
  .footer-copy { font-family: 'Space Mono', monospace; font-size: 0.65rem; color: var(--ash); }

  @media (max-width: 768px) {
    .diagnose-wrap { grid-template-columns: 1fr; }
    .picker { position: static; }
    .symptom-grid { display: grid; grid-template-columns: 1fr 1fr; }
    .nav-links { gap: 1rem; }
    .footer { flex-direction: column; gap: 1rem; padding: 2rem 1.5rem; }
  }
</style>

<nav class="nav">
  <a href="/" class="nav-logo">PermiePortal</a>
  <ul class="nav-links">
    <li><a href="/plants">Plants</a></li>
    <li><a href="/pests">Pests</a></li>
    <li><a href="/diagnose" aria-current="page">Diagnose</a></li>
    <li><a href="/articles">Articles</a></li>
    <li><a href="/about">About</a></li>
  </ul>
</nav>

<div class="page-header">
  <p class="page-eyebrow">Pest Identification</p>
  <h1 class="page-title">What's Wrong<br>With My <em>Plant?</em></h1>
  <p class="page-sub">Select the symptoms you see. We'll show you the most likely culprits — with organic controls for each one.</p>
</div>

<div class="diagnose-wrap">
  <aside class="picker">
    <p class="picker-label">What do you see?</p>
    <div class="symptom-grid" id="symptom-grid">
      {allSymptoms.map(sym => (
        <button class="symptom-btn" data-symptom={sym} onclick="toggleSymptom(this)">
          <span class="check" id={`check-${sym}`}></span>
          {SYMPTOM_LABELS[sym]}
        </button>
      ))}
    </div>
    <button class="clear-btn" onclick="clearAll()">✕ Clear all</button>
  </aside>

  <div>
    <p class="results-header" id="results-header">Select symptoms to identify likely pests</p>
    <div class="results-grid" id="results-grid">
      <div class="empty-state">
        <div class="empty-state-title">Pick a Symptom</div>
        <div class="empty-state-sub">What does the damage look like?</div>
      </div>
    </div>
  </div>
</div>

<footer class="footer">
  <div class="footer-logo">PermiePortal</div>
  <div class="footer-copy">© {new Date().getFullYear()} — Built in a food forest in Yulee, FL</div>
</footer>

<script define:vars={{ pestsData }}>
(function() {
  var selected = [];
  var pests = pestsData;

  function toggleSymptom(btn) {
    var sym = btn.dataset.symptom;
    var idx = selected.indexOf(sym);
    if (idx === -1) {
      selected.push(sym);
      btn.classList.add('selected');
      document.getElementById('check-' + sym).textContent = 'v';
    } else {
      selected.splice(idx, 1);
      btn.classList.remove('selected');
      document.getElementById('check-' + sym).textContent = '';
    }
    render();
  }

  function clearAll() {
    selected = [];
    document.querySelectorAll('.symptom-btn').forEach(function(btn) {
      btn.classList.remove('selected');
      document.getElementById('check-' + btn.dataset.symptom).textContent = '';
    });
    render();
  }

  function render() {
    var header = document.getElementById('results-header');
    var grid = document.getElementById('results-grid');

    if (selected.length === 0) {
      header.textContent = 'Select symptoms to identify likely pests';
      grid.innerHTML = '<div class="empty-state"><div class="empty-state-title">Pick a Symptom</div><div class="empty-state-sub">What does the damage look like?</div></div>';
      return;
    }

    // STRICT AND filter -- pest must have ALL selected symptoms
    var matched = pests.filter(function(p) {
      var pestSymptoms = p.symptoms || [];
      return selected.every(function(s) {
        return pestSymptoms.indexOf(s) !== -1;
      });
    });

    // Sort by affected plant count descending
    matched.sort(function(a, b) {
      return (b.affected_plants || []).length - (a.affected_plants || []).length;
    });

    var top = matched.slice(0, 24);

    header.textContent = matched.length + ' pest' + (matched.length !== 1 ? 's' : '') + ' match' + (matched.length === 1 ? 'es' : '') + ' all ' + selected.length + ' symptom' + (selected.length !== 1 ? 's' : '');

    if (top.length === 0) {
      grid.innerHTML = '<div class="empty-state"><div class="empty-state-title">No matches found</div><div class="empty-state-sub">Try removing a symptom or selecting a different combination</div></div>';
      return;
    }

    grid.innerHTML = top.map(function(p) {
      var pestSymptoms = p.symptoms || [];
      var imgHtml = p.picture
        ? '<img class="pest-card-img" src="/assets/pests/' + p.picture + '" alt="' + p.name + '" loading="lazy" />'
        : '<div class="pest-card-img-placeholder"><span style="font-family:monospace;font-size:0.6rem;color:rgba(196,85,26,0.3);text-transform:uppercase">' + p.name + '</span></div>';

      var sympTags = pestSymptoms.map(function(s) {
        var isMatch = selected.indexOf(s) !== -1;
        var label = s.replace(/-/g, ' ');
        return '<span class="pest-symptom-tag' + (isMatch ? ' matched' : '') + '">' + label + '</span>';
      }).join('');

      return '<a href="/pests/' + p.slug + '" class="pest-card">'
        + imgHtml
        + '<div class="pest-card-body">'
        + '<div class="pest-card-name">' + p.name + '</div>'
        + '<div class="pest-card-sci">' + (p.scientific_name || '') + '</div>'
        + '<div class="pest-card-symptoms">' + sympTags + '</div>'
        + '<span class="pest-card-link">View organic controls</span>'
        + '</div>'
        + '</a>';
    }).join('');
  }

  window.toggleSymptom = toggleSymptom;
  window.clearAll = clearAll;
})();
</script>

</BaseLayout>
