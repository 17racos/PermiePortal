---
// src/pages/plants/family/[family].astro
import BaseLayout from '../../../components/layouts/BaseLayout.astro';
import plantsData from '../../../data/plants.json';
import pestsData from '../../../data/pests.json';

export function getStaticPaths() {
  const familyMap: Record<string, any[]> = {};
  for (const plant of plantsData) {
    const f = plant.family;
    if (!f || f === 'NEEDS_DATA') continue;
    const slug = f.toLowerCase().replace(/[^a-z0-9]+/g, '-');
    if (!familyMap[slug]) familyMap[slug] = [];
    familyMap[slug].push(plant);
  }
  return Object.entries(familyMap).map(([slug, plants]) => ({
    params: { family: slug },
    props: { plants, familyName: plants[0].family }
  }));
}

const { plants, familyName } = Astro.props;

// Sort plants by common name
const sorted = [...plants].sort((a, b) => a.common_name.localeCompare(b.common_name));

// Collect all functions across family
const allFunctions: Record<string, number> = {};
for (const p of plants) {
  for (const f of (p.plant_function || [])) {
    allFunctions[f] = (allFunctions[f] || 0) + 1;
  }
}
const topFunctions = Object.entries(allFunctions)
  .sort((a, b) => b[1] - a[1])
  .slice(0, 6);

// Collect all layers
const allLayers: Record<string, number> = {};
for (const p of plants) {
  for (const l of (p.layers || [])) {
    allLayers[l] = (allLayers[l] || 0) + 1;
  }
}
const topLayers = Object.entries(allLayers).sort((a, b) => b[1] - a[1]);

// Zone range
const zones = plants.flatMap(p => {
  const z = String(p.zone || '');
  const m = z.match(/(\d+)/g);
  return m ? m.map(Number) : [];
}).filter(Boolean);
const minZone = zones.length ? Math.min(...zones) : null;
const maxZone = zones.length ? Math.max(...zones) : null;

// Build pest pressure for this family
// Count how many family plants each pest affects
const pestCounts: Record<string, number> = {};
for (const plant of plants) {
  for (const pestName of (plant.pests || [])) {
    pestCounts[pestName] = (pestCounts[pestName] || 0) + 1;
  }
}

// Build pest lookup for slug/scientific_name
const pestLookup: Record<string, any> = {};
for (const pest of pestsData) {
  pestLookup[pest.name] = pest;
}

// Pests affecting at least 20% of family — sorted by coverage
const minCount = Math.max(2, Math.floor(plants.length * 0.2));
const familyPests = Object.entries(pestCounts)
  .filter(([, count]) => count >= minCount)
  .sort((a, b) => b[1] - a[1])
  .slice(0, 15)
  .map(([name, count]) => ({
    name,
    count,
    slug: pestLookup[name]?.slug || name.toLowerCase().replace(/\s+/g, '-'),
    scientific_name: pestLookup[name]?.scientific_name || '',
    pct: Math.round((count / plants.length) * 100),
  }));

const FAMILY_NOTES: Record<string, {note: string, wiki: string}> = {
  'Fabaceae': {
    note: `The nitrogen-fixing backbone of every food forest guild. Plant at least one Fabaceae member per guild — they feed everything around them for free via Rhizobium root nodules. Woody members like pigeon pea and black locust are best chopped to the ground annually; leave the roots to decompose and release nitrogen in place. Avoid planting alliums nearby — sulfur compounds suppress the Rhizobium bacteria legumes depend on. Beans and peas are the easiest seeds to save — self-pollinating before flowers open, so varieties stay true with no isolation needed.`,
    wiki: 'Fabaceae'
  },
  'Asteraceae': {
    note: `Dynamic accumulator powerhouse. Deep taproots on dandelion, chicory, and elecampane mine calcium, potassium, and iron from subsoil that shallow-rooted plants cannot reach — chop and drop as living fertilizer. Composite flower heads are the most efficient landing structure for parasitoid wasps and hoverflies; a single bolted plant provides weeks of pest management support. Plant in guild edges and disturbed areas. Yarrow specifically accumulates copper, a micronutrient most soils lack.`,
    wiki: 'Asteraceae'
  },
  'Lamiaceae': {
    note: `The pest deterrence layer of any guild. Volatile aromatic oils confuse the chemical navigation of aphids, whitefly, and cabbage moths — plant at guild edges, not tucked away in the center. Square stems and opposite leaves are the forager's ID shortcut; if it smells aromatic and has a square stem, you're almost certainly in a safe, useful family. Most members prefer well-drained soil and will rot in wet feet. Drought-tolerant once established — ideal for dry guild edges where irrigation does not reach.`,
    wiki: 'Lamiaceae'
  },
  'Rosaceae': {
    note: `The temperate fruit family — but also the family with the heaviest shared pest pressure in the database. Fire blight, codling moth, brown rot, and plum curculio all move freely between members, so clustering Rosaceae species amplifies pest problems. Diversify with Elaeagnaceae nitrogen fixers like goumi as understory companions — they fix nitrogen and do not share Rosaceae pest pressure. Alliums planted beneath fruit trees suppress fungal disease at the root zone. Most cross freely — seed saving requires isolation.`,
    wiki: 'Rosaceae'
  },
  'Myrtaceae': {
    note: `The subtropical food forest workhorse. Guava, feijoa, jaboticaba, lilly pilly, and surinam cherry — aromatic leaves, edible flowers on many species, generally lower pest pressure than Rosaceae equivalents. Jaboticaba is uniquely productive: fruit grows directly on the trunk, so mature trees yield heavily in a small footprint. Feijoa is one of the most cold-hardy subtropical fruits — worth pushing into zone 8 with protection. Most members tolerate poor soils once established but need consistent moisture during establishment.`,
    wiki: 'Myrtaceae'
  },
  'Solanaceae': {
    note: `Productive but demanding — rotate out of beds every 3-4 years minimum or disease pressure compounds fast. Late blight, fusarium wilt, and bacterial speck all persist in soil and target the whole family. Tomatoes are largely self-pollinating and easy to save seed from; peppers cross more readily and need distance isolation. Alliums and basil are classic companions — alliums suppress fungal disease, basil deters thrips. Green parts of all family members contain solanine alkaloids — do not compost green tomato or potato waste in systems with livestock access.`,
    wiki: 'Solanaceae'
  },
  'Brassicaceae': {
    note: `Heavy nitrogen feeders — always follow a Fabaceae year in rotation and they will use every bit of what legumes left. Club root is the family nemesis: a soil pathogen that persists 20 years and targets the entire family, so strict rotation is non-negotiable. Glucosinolates deter generalist pests but actively attract specialist insects like cabbage loopers — separate brassica beds in time and space rather than scattering through guilds. The entire family crosses freely including with wild mustard, making seed saving almost impossible without isolation.`,
    wiki: 'Brassicaceae'
  },
  'Cucurbitaceae': {
    note: `Vining ground covers that suppress weeds and retain moisture — useful in the ground layer of food forests if you have the space. Squash bugs, cucumber beetles, and vine borers target every family member, so intercrop with nasturtium and catnip at the perimeter. Varieties cross freely within species — summer squash crosses with summer squash but not winter squash — isolate by half a mile or stagger plantings for seed saving. Heavy feeders: plant over compost trenches or last year's compost pile for best results.`,
    wiki: 'Cucurbitaceae'
  },
  'Apiaceae': {
    note: `The most important family for biological pest control — flat-topped umbel flowers are landing pads for parasitoid wasps, hoverflies, and lacewings that control aphids and caterpillars. Let at least one plant per season bolt and flower. Warning for foragers: this family contains both edibles and deadly species — poison hemlock looks similar to wild carrot at certain growth stages. Never eat an Apiaceae plant you have not positively identified. Deep taproots break soil compaction — useful after heavy-feeding crops.`,
    wiki: 'Apiaceae'
  },
  'Rutaceae': {
    note: `All citrus belongs here and they share pest pressure completely — Asian citrus psyllid, citrus greening, and rust mite spread freely across the family. An infestation on one tree is a threat to every citrus on the property. Most need free-draining soil and will not tolerate wet feet — raised mounds extend their range in heavy soils. Aromatic volatile oils in leaves deter many generalist pests; citrus peel and leaf mulch around vulnerable plants has real deterrent effect. Kumquat is the most cold-hardy member.`,
    wiki: 'Rutaceae'
  },
  'Ericaceae': {
    note: `Acid-lovers that need pH 4.5-5.5 — do not lime their beds, ever. They partner with ericoid mycorrhizal fungi different from what most garden plants use, so standard mycorrhizal inoculants will not help. Use pine needle or oak leaf mulch to maintain acidity over time. Blueberries need cross-pollination from a different variety for best yields — plant at least two cultivars. Slow to establish but long-lived and low-maintenance once settled — think decades, not seasons.`,
    wiki: 'Ericaceae'
  },
  'Poaceae': {
    note: `The most biomass-productive family in the database. Bamboo, elephant grass, and vetiver generate more chop-and-drop material per square foot than almost anything else. Deep fibrous root systems build soil organic matter rapidly and prevent erosion — vetiver is used worldwide for slope stabilization. Wind-pollinated, so they contribute nothing to insect forage — balance with flowering plants. Running bamboo varieties need root barriers or aggressive management; clumping types are safer for most systems.`,
    wiki: 'Poaceae'
  },
  'Malvaceae': {
    note: `Deep taproots break compaction and accumulate minerals — hollyhock, marshmallow, and okra all have edible, medicinal, or soil-building value. Cacao, kenaf, and hibiscus belong here. Many are dynamic accumulators high in calcium and potassium — chop and drop adds real mineral value. Okra is one of the most heat and drought tolerant food crops, producing through summer when most vegetables stall. Most family members attract bumblebees specifically — the flower structure requires buzz pollination that honeybees often cannot perform.`,
    wiki: 'Malvaceae'
  },
  'Araceae': {
    note: `Tropical shade-layer specialists — taro, elephant ear, and dasheen thrive in wet or heavily shaded conditions where other food crops fail. Most contain calcium oxalate crystals that cause irritation if eaten raw — always cook thoroughly and do not let livestock graze freely. Taro is one of the most productive calories-per-square-foot crops in tropical and subtropical zones. Large leaves make excellent mulch and chop-and-drop material. Many spread aggressively in wet conditions — site carefully near waterways.`,
    wiki: 'Araceae'
  },
  'Arecaceae': {
    note: `The true canopy layer for tropical and subtropical food forests — long-lived, wind-resistant, yielding fruit, hearts, sap, and fiber across decades with minimal inputs. Saw palmetto is a southeastern US wildlife keystone, medicinal, and fire-adapted. Peach palm produces starchy protein-rich fruit and edible hearts from offshoots without killing the main plant. Most palms are single-stemmed and die if the growing tip is damaged — site carefully away from falling hazards. Coconut needs zone 10+ reliably; everything else in this family is more forgiving.`,
    wiki: 'Arecaceae'
  },
};

const familyWikiSlug = familyName.replace(/\s+/g, '_');
const familyOverviewNote = (() => {
  const topFunction = topFunctions[0]?.[0];
  const topLayer = topLayers[0]?.[0];
  const zoneBand = minZone && maxZone ? `zones ${minZone}-${maxZone}` : 'your local zone band';
  const pestSummary = familyPests.length > 0
    ? `${familyPests.length} recurring pests in this family`
    : 'lower shared pest pressure in this family';
  const roleSummary = topFunction
    ? `Use its strongest role (${topFunction}) intentionally`
    : 'Use mixed-function species to spread risk';
  const structureSummary = topLayer
    ? `Anchor it in the ${topLayer} layer and pair with unrelated support species in other layers`
    : 'Distribute it across layers instead of clustering one growth form';

  return `${familyName} in this database spans ${zoneBand} with ${plants.length} species, so design it as a guild component instead of a monoculture block. ${roleSummary} and manage spacing for airflow because there are ${pestSummary}. ${structureSummary}; if you save seed from multiple cultivars, isolate flowering plants to reduce accidental crosses within the family.`;
})();

const activeFamilyNote = FAMILY_NOTES[familyName] || {
  note: familyOverviewNote,
  wiki: familyWikiSlug,
};
---

<BaseLayout
  title={`${familyName} Plant Family — Permaculture Guide | PermiePortal`}
  description={`Permaculture guide to the ${familyName} plant family — characteristics, companion planting, pest relationships, and food forest applications.`}
>
<style>
  :root {
    --soil: #0f0d0a; --bark: #1c1812; --moss: #2a3d1f;
    --leaf: #4a7c35; --lime: #8fb83a; --straw: #d4a843;
    --ash: #b8b0a0; --paper: #ede8dc; --rot: #7a3b1e; --rust: #c4551a;
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body { background: var(--soil); color: var(--paper); font-family: 'Instrument Serif', Georgia, serif; }
  .breadcrumb { padding: 1rem 2rem; font-family: 'Space Mono', monospace; font-size: 0.65rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--ash); border-bottom: 1px solid rgba(139,184,58,0.1); }
  .breadcrumb a { color: var(--lime); text-decoration: none; }

  /* HERO */
  .hero { padding: 3rem 2rem 2.5rem; border-bottom: 1px solid rgba(139,184,58,0.15); display: grid; grid-template-columns: 1fr auto; gap: 3rem; align-items: start; }
  .hero-eyebrow { font-family: 'Space Mono', monospace; font-size: 0.65rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--straw); margin-bottom: 1rem; display: flex; align-items: center; gap: 0.75rem; }
  .hero-eyebrow::before { content: ''; width: 2rem; height: 1px; background: var(--straw); }
  .hero-title { font-family: 'Bebas Neue', sans-serif; font-size: clamp(3rem, 8vw, 7rem); line-height: 0.92; color: var(--paper); margin-bottom: 0.5rem; }
  .hero-count { font-family: 'Space Mono', monospace; font-size: 0.7rem; color: var(--lime); letter-spacing: 0.1em; text-transform: uppercase; margin-bottom: 1.25rem; }
  .hero-note { font-size: 1.05rem; line-height: 1.75; color: var(--ash); max-width: 560px; }
  .wiki-link { display: inline-flex; align-items: center; gap: 0.4rem; font-family: 'Space Mono', monospace; font-size: 0.65rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--lime); text-decoration: none; padding: 0.4rem 0.9rem; border: 1px solid rgba(139,184,58,0.3); margin-top: 1rem; transition: all 0.2s; }
  .wiki-link:hover { border-color: var(--lime); background: rgba(139,184,58,0.08); }
  .wiki-link::after { content: '↗'; font-size: 0.6rem; }

  /* STATS PANEL */
  .stats-panel { background: rgba(28,24,18,0.8); border: 1px solid rgba(139,184,58,0.2); padding: 1.5rem; min-width: 220px; }
  .stats-panel::before { content: '// FAMILY DATA'; font-family: 'Space Mono', monospace; font-size: 0.6rem; letter-spacing: 0.15em; color: var(--lime); opacity: 0.7; display: block; margin-bottom: 1.25rem; }
  .stat-row { margin-bottom: 1rem; border-left: 2px solid var(--moss); padding-left: 0.75rem; }
  .stat-label { font-family: 'Space Mono', monospace; font-size: 0.6rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--ash); margin-bottom: 0.2rem; }
  .stat-value { font-family: 'Bebas Neue', sans-serif; font-size: 1.3rem; color: var(--lime); line-height: 1.1; }

  /* SECTIONS */
  .section { padding: 2.5rem 2rem; border-bottom: 1px solid rgba(139,184,58,0.1); }
  .section-label { font-family: 'Space Mono', monospace; font-size: 0.65rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--straw); margin-bottom: 0.5rem; }
  .section-title { font-family: 'Bebas Neue', sans-serif; font-size: 1.8rem; letter-spacing: 0.03em; color: var(--paper); margin-bottom: 1.25rem; }

  /* FUNCTIONS */
  .function-tags { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .function-tag { font-family: 'Space Mono', monospace; font-size: 0.65rem; letter-spacing: 0.06em; text-transform: uppercase; padding: 0.3rem 0.8rem; background: rgba(42,61,31,0.5); border: 1px solid rgba(74,124,53,0.4); color: var(--lime); }
  .function-count { opacity: 0.6; font-size: 0.55rem; margin-left: 0.3rem; }

  /* PEST PRESSURE */
  .pest-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 0.6rem; }
  .pest-card { display: block; text-decoration: none; padding: 0.9rem 1.1rem; background: var(--bark); border: 1px solid rgba(196,85,26,0.15); transition: all 0.2s; position: relative; }
  .pest-card:hover { border-color: rgba(196,85,26,0.4); background: rgba(122,59,30,0.12); }
  .pest-card-header { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 0.3rem; }
  .pest-name { font-family: 'Bebas Neue', sans-serif; font-size: 1.2rem; color: var(--paper); letter-spacing: 0.02em; }
  .pest-coverage { font-family: 'Space Mono', monospace; font-size: 0.6rem; color: var(--rust); letter-spacing: 0.06em; }
  .pest-sci { font-style: italic; font-size: 0.75rem; color: var(--ash); opacity: 0.7; }
  .pest-bar { margin-top: 0.5rem; height: 2px; background: rgba(196,85,26,0.15); border-radius: 1px; }
  .pest-bar-fill { height: 100%; background: var(--rust); border-radius: 1px; transition: width 0.3s; }

  /* PLANTS GRID */
  .plants-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 0.5rem; }
  .plant-card { display: block; text-decoration: none; padding: 0.75rem 1rem; background: var(--bark); border: 1px solid rgba(139,184,58,0.12); transition: all 0.2s; }
  .plant-card:hover { border-color: rgba(139,184,58,0.35); background: rgba(42,61,31,0.25); }
  .plant-name { font-family: 'Space Mono', monospace; font-size: 0.72rem; color: var(--paper); letter-spacing: 0.04em; margin-bottom: 0.2rem; }
  .plant-sci { font-style: italic; font-size: 0.72rem; color: var(--ash); opacity: 0.7; }

  /* FOOTER */
  .footer { padding: 2rem 4rem; border-top: 1px solid rgba(139,184,58,0.15); display: flex; justify-content: space-between; align-items: center; margin-top: 2rem; }
  .footer-logo { font-family: 'Bebas Neue', sans-serif; font-size: 1.2rem; color: var(--lime); letter-spacing: 0.08em; }
  .footer-copy { font-family: 'Space Mono', monospace; font-size: 0.65rem; color: var(--ash); }

  @media (max-width: 768px) {
    .hero { grid-template-columns: 1fr; gap: 2rem; }
    .plants-grid { grid-template-columns: 1fr 1fr; }
    .pest-grid { grid-template-columns: 1fr; }
    .footer { flex-direction: column; gap: 1rem; padding: 2rem 1.5rem; }
  }
</style>

<nav class="nav">
  <a href="/" class="nav-logo">PermiePortal</a>
  <ul class="nav-links">
    <li><a href="/plants">Plants</a></li>
    <li><a href="/pests">Pests</a></li>
    <li><a href="/plants/families">Plant Families</a></li>
    <li><a href="/articles">Articles</a></li>
    <li><a href="/projects">Projects</a></li>
    <li><a href="/about">About</a></li>
  </ul>
</nav>

<div class="breadcrumb">
  <a href="/plants">Plants</a> / <a href="/plants/families">Families</a> / {familyName}
</div>

<div class="hero">
  <div>
    <p class="hero-eyebrow">Plant Family</p>
    <h1 class="hero-title">{familyName}</h1>
    <p class="hero-count">{plants.length} plant{plants.length !== 1 ? 's' : ''} in database</p>
    <p class="hero-note">{activeFamilyNote.note}</p>
    <a href={`https://en.wikipedia.org/wiki/${activeFamilyNote.wiki}`}
       target="_blank" rel="noopener" class="wiki-link">
      Wikipedia — {familyName}
    </a>
  </div>

  <div class="stats-panel">
    <div class="stat-row">
      <div class="stat-label">Plants in Database</div>
      <div class="stat-value">{plants.length}</div>
    </div>
    {familyPests.length > 0 && (
      <div class="stat-row">
        <div class="stat-label">Common Pests</div>
        <div class="stat-value">{familyPests.length}</div>
      </div>
    )}
    {minZone && maxZone && (
      <div class="stat-row">
        <div class="stat-label">Zone Range</div>
        <div class="stat-value">{minZone}–{maxZone}</div>
      </div>
    )}
    {topLayers.slice(0,3).map(([layer, count]) => (
      <div class="stat-row">
        <div class="stat-label">{layer}</div>
        <div class="stat-value">{count} plants</div>
      </div>
    ))}
  </div>
</div>

{topFunctions.length > 0 && (
  <div class="section">
    <p class="section-label">Common Functions in This Family</p>
    <div class="function-tags">
      {topFunctions.map(([fn, count]) => (
        <span class="function-tag">
          {fn}<span class="function-count">×{count}</span>
        </span>
      ))}
    </div>
  </div>
)}

{familyPests.length > 0 && (
  <div class="section">
    <p class="section-label">Shared Pest Pressure</p>
    <div class="section-title">Pests That Target {familyName}</div>
    <p style="font-size:0.9rem; color:var(--ash); margin-bottom:1.5rem; font-style:italic;">
      Showing pests affecting {minCount}+ plants in this family. Click any pest for organic control methods.
    </p>
    <div class="pest-grid">
      {familyPests.map(pest => (
        <a href={`/pests/${pest.slug}`} class="pest-card">
          <div class="pest-card-header">
            <div class="pest-name">{pest.name}</div>
            <div class="pest-coverage">{pest.pct}% of family</div>
          </div>
          {pest.scientific_name && pest.scientific_name !== 'NEEDS_DATA' && (
            <div class="pest-sci">{pest.scientific_name}</div>
          )}
          <div class="pest-bar">
            <div class="pest-bar-fill" style={`width:${pest.pct}%`}></div>
          </div>
        </a>
      ))}
    </div>
  </div>
)}

<div class="section">
  <p class="section-label">All {familyName} Plants — {plants.length} total</p>
  <div class="plants-grid">
    {sorted.map(plant => (
      <a href={`/plants/${plant.slug}`} class="plant-card">
        <div class="plant-name">{plant.common_name}</div>
        {plant.scientific_name && plant.scientific_name !== 'NEEDS_DATA' && (
          <div class="plant-sci">{plant.scientific_name}</div>
        )}
      </a>
    ))}
  </div>
</div>

<footer class="footer">
  <div class="footer-logo">PermiePortal</div>
  <div class="footer-copy">© {new Date().getFullYear()} PermiePortal</div>
</footer>

</BaseLayout>
