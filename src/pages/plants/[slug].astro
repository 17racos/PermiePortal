---
// src/pages/plants/[slug].astro
import BaseLayout from '../../components/layouts/BaseLayout.astro';
import plantsData from '../../data/plants.json';
import pestsData from '../../data/pests.json';

export function getStaticPaths() {
  return plantsData.map(plant => ({
    params: { slug: plant.slug },
    props: { plant }
  }));
}

const { plant } = Astro.props;

const plantPests = pestsData.filter(pest =>
  pest.affected_plants?.some((p: any) => p.slug === plant.slug)
);

const companions = plant.companions || [];
const avoid = plant.avoid || [];

// Check if image file exists path
const imagePath = plant.picture ? `/assets/plants/${plant.picture}` : null;
---

<BaseLayout title={plant.common_name}>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Instrument+Serif:ital@0;1&family=Space+Mono:ital,wght@0,400;0,700;1,400&display=swap');

  :root {
    --soil: #0f0d0a; --bark: #1c1812; --moss: #2a3d1f;
    --leaf: #4a7c35; --lime: #8fb83a; --straw: #d4a843;
    --ash: #b8b0a0; --paper: #ede8dc; --rot: #7a3b1e; --rust: #c4551a;
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }
  body {
    background: var(--soil); color: var(--paper);
    font-family: 'Instrument Serif', Georgia, serif;
  }

  .nav {
    display: flex; justify-content: space-between; align-items: center;
    padding: 1.5rem 2rem;
    border-bottom: 1px solid rgba(139,184,58,0.2);
  }
  .nav-logo {
    font-family: 'Bebas Neue', sans-serif; font-size: 1.8rem;
    letter-spacing: 0.08em; color: var(--lime); text-decoration: none;
  }
  .nav-links { display: flex; gap: 2rem; list-style: none; }
  .nav-links a {
    font-family: 'Space Mono', monospace; font-size: 0.72rem;
    text-transform: uppercase; letter-spacing: 0.12em;
    color: var(--ash); text-decoration: none; transition: color 0.2s;
  }
  .nav-links a:hover { color: var(--lime); }

  .breadcrumb {
    padding: 1rem 2rem;
    font-family: 'Space Mono', monospace; font-size: 0.65rem;
    letter-spacing: 0.1em; text-transform: uppercase;
    color: var(--ash);
    border-bottom: 1px solid rgba(139,184,58,0.1);
  }
  .breadcrumb a { color: var(--lime); text-decoration: none; }
  .breadcrumb a:hover { text-decoration: underline; }

  /* ── HERO IMAGE ── */
  .hero-image-wrap {
    position: relative;
    width: 100%;
    height: clamp(280px, 40vw, 480px);
    overflow: hidden;
    border-bottom: 1px solid rgba(139,184,58,0.15);
  }

  .hero-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    opacity: 0.85;
  }

  .hero-image-placeholder {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, var(--moss) 0%, var(--bark) 100%);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hero-image-placeholder span {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 1rem;
    letter-spacing: 0.2em;
    color: rgba(139,184,58,0.3);
    text-transform: uppercase;
  }

  /* Gradient overlay on image for text legibility */
  .hero-image-wrap::after {
    content: '';
    position: absolute;
    bottom: 0; left: 0; right: 0;
    height: 50%;
    background: linear-gradient(to top, rgba(15,13,10,0.9) 0%, transparent 100%);
    pointer-events: none;
  }

  /* ── HERO TEXT ── */
  .hero {
    padding: 2.5rem 2rem 2rem;
    border-bottom: 1px solid rgba(139,184,58,0.15);
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 3rem;
    align-items: start;
  }

  .plant-layer {
    font-family: 'Space Mono', monospace; font-size: 0.65rem;
    letter-spacing: 0.15em; text-transform: uppercase;
    color: var(--leaf); margin-bottom: 0.75rem;
    display: flex; align-items: center; gap: 0.75rem;
  }
  .plant-layer::before {
    content: ''; width: 2rem; height: 1px; background: var(--leaf);
  }

  .plant-name {
    font-family: 'Bebas Neue', sans-serif;
    font-size: clamp(3rem, 6vw, 5.5rem);
    line-height: 0.95; letter-spacing: 0.02em; color: var(--paper);
    margin-bottom: 0.5rem;
  }

  .plant-sci {
    font-style: italic; font-size: 1.1rem;
    color: var(--ash); margin-bottom: 1rem;
  }

  .plant-aka {
    font-family: 'Space Mono', monospace; font-size: 0.7rem;
    color: var(--ash); margin-bottom: 1.5rem;
  }

  .plant-tags {
    display: flex; flex-wrap: wrap; gap: 0.4rem; margin-bottom: 1.5rem;
  }

  .tag {
    font-family: 'Space Mono', monospace; font-size: 0.6rem;
    letter-spacing: 0.08em; padding: 0.2rem 0.7rem;
    background: rgba(42,61,31,0.6);
    border: 1px solid rgba(74,124,53,0.4);
    color: var(--lime); text-transform: uppercase;
  }

  .tag.layer {
    background: rgba(122,59,30,0.3);
    border-color: rgba(196,85,26,0.4);
    color: var(--straw);
  }

  .climate-panel {
    background: rgba(28,24,18,0.8);
    border: 1px solid rgba(139,184,58,0.2);
    padding: 1.5rem; min-width: 200px;
  }

  .climate-panel::before {
    content: '// CLIMATE DATA';
    font-family: 'Space Mono', monospace; font-size: 0.6rem;
    letter-spacing: 0.15em; color: var(--lime); opacity: 0.7;
    display: block; margin-bottom: 1.25rem;
  }

  .climate-row {
    margin-bottom: 1rem;
    border-left: 2px solid var(--moss);
    padding-left: 0.75rem;
  }

  .climate-label {
    font-family: 'Space Mono', monospace; font-size: 0.6rem;
    letter-spacing: 0.1em; text-transform: uppercase;
    color: var(--ash); margin-bottom: 0.2rem;
  }

  .climate-value {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 1.4rem; color: var(--lime); line-height: 1;
  }

  .content { max-width: 1200px; margin: 0 auto; }

  .section {
    padding: 2.5rem 2rem;
    border-bottom: 1px solid rgba(139,184,58,0.1);
  }

  .section-label {
    font-family: 'Space Mono', monospace; font-size: 0.65rem;
    letter-spacing: 0.2em; text-transform: uppercase;
    color: var(--straw); margin-bottom: 1rem;
  }

  .section-title {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 1.8rem; letter-spacing: 0.03em;
    color: var(--paper); margin-bottom: 1rem;
  }

  .description {
    font-size: 1.05rem; line-height: 1.8;
    color: var(--ash); white-space: pre-wrap;
  }

  .two-col {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
  }

  .companion-list {
    list-style: none;
    display: flex; flex-direction: column; gap: 0.4rem;
  }

  .companion-list li {
    font-family: 'Space Mono', monospace; font-size: 0.78rem;
    padding: 0.4rem 0.75rem;
    background: rgba(42,61,31,0.4);
    border-left: 2px solid var(--leaf);
    color: var(--paper);
  }

  .avoid-list li {
    background: rgba(122,59,30,0.2);
    border-left-color: var(--rust);
  }

  .pest-card {
    display: block; text-decoration: none;
    background: var(--bark);
    border: 1px solid rgba(139,184,58,0.15);
    padding: 1rem 1.25rem;
    transition: all 0.2s;
    margin-bottom: 0.5rem;
  }

  .pest-card:hover {
    border-color: rgba(196,85,26,0.5);
    background: rgba(122,59,30,0.15);
  }

  .pest-card-name {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 1.2rem; color: var(--paper); margin-bottom: 0.25rem;
  }

  .pest-card-sci {
    font-style: italic; font-size: 0.8rem; color: var(--ash);
  }

  .empty-state {
    font-family: 'Space Mono', monospace; font-size: 0.78rem;
    color: var(--ash); font-style: italic; padding: 1rem 0;
  }

  .footer {
    padding: 2rem 4rem;
    border-top: 1px solid rgba(139,184,58,0.15);
    display: flex; justify-content: space-between; align-items: center;
    margin-top: 2rem;
  }
  .footer-logo {
    font-family: 'Bebas Neue', sans-serif; font-size: 1.2rem;
    color: var(--lime); letter-spacing: 0.08em;
  }
  .footer-copy {
    font-family: 'Space Mono', monospace; font-size: 0.65rem; color: var(--ash);
  }

  @media (max-width: 768px) {
    .hero { grid-template-columns: 1fr; gap: 2rem; }
    .two-col { grid-template-columns: 1fr; }
    .footer { flex-direction: column; gap: 1rem; padding: 2rem 1.5rem; }
    .nav-links { gap: 1rem; }
    .hero-image-wrap { height: 240px; }
  }
</style>

<nav class="nav">
  <a href="/" class="nav-logo">PermiePortal</a>
  <ul class="nav-links">
    <li><a href="/plants">Plants</a></li>
    <li><a href="/pests">Pests</a></li>
    <li><a href="/articles">Articles</a></li>
    <li><a href="/projects">Projects</a></li>
    <li><a href="/about">About</a></li>
  </ul>
</nav>

<div class="breadcrumb">
  <a href="/plants">← Plants</a> / {plant.common_name}
</div>

<!-- HERO IMAGE — full width, edge to edge -->
<div class="hero-image-wrap">
  {imagePath ? (
    <img
      class="hero-image"
      src={imagePath}
      alt={plant.common_name}
      loading="eager"
    />
  ) : (
    <div class="hero-image-placeholder">
      <span>{plant.common_name}</span>
    </div>
  )}
</div>

<!-- HERO TEXT -->
<div class="hero">
  <div>
    <p class="plant-layer">{plant.layers?.[0] || 'Plant'}</p>
    <h1 class="plant-name">{plant.common_name}</h1>
    {plant.scientific_name && (
      <p class="plant-sci">{plant.scientific_name}</p>
    )}
    {plant.aka?.length > 0 && (
      <p class="plant-aka">Also known as: {plant.aka.join(', ')}</p>
    )}
    <div class="plant-tags">
      {(plant.layers || []).map((l: string) => (
        <span class="tag layer">{l}</span>
      ))}
      {(plant.plant_function || []).map((fn: string) => (
        <span class="tag">{fn}</span>
      ))}
    </div>
  </div>

  <div class="climate-panel">
    {plant.zone && (
      <div class="climate-row">
        <div class="climate-label">Hardiness Zone</div>
        <div class="climate-value">{plant.zone}</div>
      </div>
    )}
    {plant.ideal_temp_min != null && plant.ideal_temp_max != null && (
      <div class="climate-row">
        <div class="climate-label">Ideal Temp</div>
        <div class="climate-value">{plant.ideal_temp_min}–{plant.ideal_temp_max}°F</div>
      </div>
    )}
    {plant.min_temp != null && (
      <div class="climate-row">
        <div class="climate-label">Survives Down To</div>
        <div class="climate-value">{plant.min_temp}°F</div>
      </div>
    )}
    {plant.perennial != null && (
      <div class="climate-row">
        <div class="climate-label">Life Cycle</div>
        <div class="climate-value">{plant.perennial ? 'Perennial' : 'Annual'}</div>
      </div>
    )}
  </div>
</div>

<div class="content">
  {plant.description && (
    <div class="section">
      <p class="section-label">About</p>
      <p class="description">{plant.description}</p>
    </div>
  )}

  {(companions.length > 0 || avoid.length > 0) && (
    <div class="section">
      <p class="section-label">Companion Planting</p>
      <div class="two-col">
        <div>
          <div class="section-title">Good Neighbors</div>
          {companions.length > 0 ? (
            <ul class="companion-list">
              {companions.map((c: string) => <li>{c}</li>)}
            </ul>
          ) : (
            <p class="empty-state">No companion data yet.</p>
          )}
        </div>
        <div>
          <div class="section-title">Keep Away From</div>
          {avoid.length > 0 ? (
            <ul class="companion-list avoid-list">
              {avoid.map((a: string) => <li>{a}</li>)}
            </ul>
          ) : (
            <p class="empty-state">No antagonist data yet.</p>
          )}
        </div>
      </div>
    </div>
  )}

  {plantPests.length > 0 && (
    <div class="section">
      <p class="section-label">Pest Pressure</p>
      <div class="section-title">Known Threats — Organic Solutions Only</div>
      {plantPests.map(pest => (
        <a href={`/pests/${pest.slug}`} class="pest-card">
          <div class="pest-card-name">{pest.name}</div>
          {pest.scientific_name && (
            <div class="pest-card-sci">{pest.scientific_name}</div>
          )}
        </a>
      ))}
    </div>
  )}
</div>

<footer class="footer">
  <div class="footer-logo">PermiePortal</div>
  <div class="footer-copy">© {new Date().getFullYear()} — Built in a food forest in Yulee, FL</div>
</footer>

</BaseLayout>
