---
import Navbar from '../../components/Navbar.astro';
// src/pages/plants/[slug].astro
import BaseLayout from '../../components/layouts/BaseLayout.astro';
import plantsData from '../../data/plants.json';
import pestsData from '../../data/pests.json';
import relationshipsData from '../../data/relationships.json';
import { suggestCompanions } from '../../lib/companions.js';

export function getStaticPaths() {
  return plantsData.map(plant => ({
    params: { slug: plant.slug },
    props: { plant }
  }));
}

const { plant } = Astro.props;

const companions = plant.companions || [];
const companionSuggestions = suggestCompanions(plant.slug, plantsData, relationshipsData);

// Unresolved companions — valid plant references not yet in database
const companionsUnresolved = (plant.companions_unresolved || [])
  .filter((c: any) => {
    const name = typeof c === 'string' ? c : c?.name || '';
    return name && name !== 'NEEDS_DATA';
  })
  .slice(0, 5);

// Companion categories — ecological context entries, system type only
const companionCategories = (plant.companion_categories || [])
  .filter((c: any) => c?.type === 'system' && c?.name)
  .slice(0, 4);

// Filter out empty/placeholder cautions
const cautions = (plant.cautions || []).filter((c: string) =>
  c && !['none documented', 'none', 'none significant', 'none noted'].includes(
    c.toLowerCase().trim()
  )
);

const imagePath = plant.picture ? `/assets/plants/${plant.picture}` : null;
const familySlug = plant.family ? plant.family.toLowerCase().replace(/[^a-z0-9]+/g, '-') : null;

// Practitioner notes — split into individual facts
const fieldObsFacts = plant.field_observations
  ? String(plant.field_observations)
      .split('\n')
      .map((l: string) => l.trim())
      .filter((l: string) => l.length > 0 && l.toLowerCase() !== 'needs_data')
  : [];
const plantPestList: string[] = Array.isArray(plant.pests) ? plant.pests : [];
const plantStressorList: string[] = Array.isArray(plant.stressors) ? plant.stressors : [];

// Purpose — split into lines, separating intro from bullet points
const purposeRaw = plant.purpose || '';
const purposeLines = purposeRaw
  .split('\n')
  .map((l: string) => l.trim())
  .filter((l: string) => l.length > 0);
---

<BaseLayout
  title={`${plant.common_name} — Permaculture Plant Profile`}
  description={`${plant.common_name}${plant.aka?.length ? ' (' + plant.aka.slice(0,3).join(', ') + ')' : ''} — zones, functions, companions, pest relationships, and organic growing notes. Free permaculture plant data from PermiePortal.`}
>
<style>
  :root {
    --soil: #0f0d0a; --bark: #1c1812; --moss: #2a3d1f;
    --leaf: #4a7c35; --lime: #8fb83a; --straw: #d4a843;
    --ash: #b8b0a0; --paper: #ede8dc; --rot: #7a3b1e; --rust: #c4551a;
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }
  body { background: var(--soil); color: var(--paper); font-family: 'Instrument Serif', Georgia, serif; }

  /* BREADCRUMB */
  .breadcrumb { padding: 1rem 2rem; font-family: 'Space Mono', monospace; font-size: 0.65rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--ash); border-bottom: 1px solid rgba(139,184,58,0.1); }
  .breadcrumb a { color: var(--lime); text-decoration: none; }
  .breadcrumb a:hover { text-decoration: underline; }

  /* HERO IMAGE */
  .hero-image-wrap { position: relative; width: 100%; height: clamp(280px, 40vw, 480px); overflow: hidden; border-bottom: 1px solid rgba(139,184,58,0.15); }
  .hero-image { width: 100%; height: 100%; object-fit: cover; display: block; opacity: 0.85; }
  .hero-image-placeholder { width: 100%; height: 100%; flex-direction: column; gap: 0.5rem; background: linear-gradient(135deg, var(--moss) 0%, var(--bark) 100%); display: flex; align-items: center; justify-content: center; }
  .placeholder-main { font-family: 'Bebas Neue', sans-serif; font-size: 1rem; letter-spacing: 0.2em; color: rgba(139,184,58,0.3); text-transform: uppercase; }
  .placeholder-sub { font-family: 'Space Mono', monospace; font-size: 0.55rem; letter-spacing: 0.12em; text-transform: uppercase; color: rgba(139,184,58,0.2); margin-top: 0.5rem; }
  .placeholder-main { font-family: 'Bebas Neue', sans-serif; font-size: 1rem; letter-spacing: 0.2em; color: rgba(139,184,58,0.3); text-transform: uppercase; }
  .placeholder-sub { font-family: 'Space Mono', monospace; font-size: 0.5rem; letter-spacing: 0.12em; text-transform: uppercase; color: rgba(139,184,58,0.18); }
  .hero-image-wrap::after { content: ''; position: absolute; bottom: 0; left: 0; right: 0; height: 50%; background: linear-gradient(to top, rgba(15,13,10,0.9) 0%, transparent 100%); pointer-events: none; }

  /* HERO TEXT */
  .hero { padding: 2.5rem 2rem 2rem; border-bottom: 1px solid rgba(139,184,58,0.15); display: grid; grid-template-columns: 1fr auto; gap: 3rem; align-items: start; }
  .plant-layer { font-family: 'Space Mono', monospace; font-size: 0.65rem; letter-spacing: 0.15em; text-transform: uppercase; color: var(--leaf); margin-bottom: 0.75rem; display: flex; align-items: center; gap: 0.75rem; }
  .plant-layer::before { content: ''; width: 2rem; height: 1px; background: var(--leaf); }
  .plant-name { font-family: 'Bebas Neue', sans-serif; font-size: clamp(3rem, 6vw, 5.5rem); line-height: 0.95; letter-spacing: 0.02em; color: var(--paper); margin-bottom: 0.5rem; }
  .plant-sci { font-style: italic; font-size: 1.1rem; color: var(--ash); margin-bottom: 1rem; }
  .plant-aka-wrap { display: flex; flex-wrap: wrap; align-items: center; gap: 0.35rem; margin-bottom: 1.25rem; }
  .plant-aka-label { font-family: 'Space Mono', monospace; font-size: 0.58rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--ash); opacity: 0.6; margin-right: 0.25rem; }
  .plant-aka-tag { font-family: 'Space Mono', monospace; font-size: 0.58rem; letter-spacing: 0.04em; padding: 0.15rem 0.5rem; background: rgba(212,168,67,0.1); border: 1px solid rgba(212,168,67,0.2); color: var(--straw); }
  .plant-tags { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-bottom: 1.5rem; }
  .tag { font-family: 'Space Mono', monospace; font-size: 0.6rem; letter-spacing: 0.08em; padding: 0.2rem 0.7rem; background: rgba(42,61,31,0.6); border: 1px solid rgba(74,124,53,0.4); color: var(--lime); text-transform: uppercase; }
  .tag.layer { background: rgba(122,59,30,0.3); border-color: rgba(196,85,26,0.4); color: var(--straw); }
  .tag.family { background: rgba(28,24,18,0.8); border-color: rgba(212,168,67,0.3); color: var(--straw); text-decoration: none; }
  .tag.family:hover { border-color: var(--straw); color: var(--paper); }

  /* CLIMATE PANEL */
  .climate-panel { background: rgba(28,24,18,0.8); border: 1px solid rgba(139,184,58,0.2); padding: 1.5rem; min-width: 200px; }
  .climate-panel::before { content: '// CLIMATE DATA'; font-family: 'Space Mono', monospace; font-size: 0.6rem; letter-spacing: 0.15em; color: var(--lime); opacity: 0.7; display: block; margin-bottom: 1.25rem; }
  .climate-row { margin-bottom: 1rem; border-left: 2px solid var(--moss); padding-left: 0.75rem; }
  .climate-label { font-family: 'Space Mono', monospace; font-size: 0.6rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--ash); margin-bottom: 0.2rem; }
  .climate-value { font-family: 'Bebas Neue', sans-serif; font-size: 1.4rem; color: var(--lime); line-height: 1; }

  /* SECTIONS */
  .content { max-width: 1200px; margin: 0 auto; }
  .section { padding: 2.5rem 2rem; border-bottom: 1px solid rgba(139,184,58,0.1); }
  .section-label { font-family: 'Space Mono', monospace; font-size: 0.65rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--straw); margin-bottom: 1rem; }
  .section-title { font-family: 'Bebas Neue', sans-serif; font-size: 1.8rem; letter-spacing: 0.03em; color: var(--paper); margin-bottom: 1rem; }

  /* ABOUT */
  .description { font-size: 1.05rem; line-height: 1.8; color: var(--ash); white-space: pre-wrap; }

  /* PERMACULTURE FUNCTIONS */
  .purpose-intro { font-size: 1rem; color: var(--ash); margin-bottom: 1rem; font-style: italic; line-height: 1.6; }
  .purpose-list { list-style: none; display: flex; flex-direction: column; gap: 0.45rem; padding: 0; }
  .purpose-list li { font-size: 0.95rem; line-height: 1.7; color: var(--ash); padding: 0.4rem 0.75rem 0.4rem 1rem; border-left: 2px solid var(--moss); }
  .purpose-list li strong { color: var(--paper); }

  /* PRACTITIONER NOTES */
  .practitioner-list { list-style: none; display: flex; flex-direction: column; gap: 0.6rem; padding: 0; }
  .practitioner-list li { padding: 0.65rem 1rem 0.65rem 1.25rem; border-left: 2px solid var(--lime); background: rgba(28,24,18,0.6); font-size: 1rem; line-height: 1.65; color: var(--paper); }
  .practitioner-list li::before { content: '→ '; color: var(--lime); font-family: 'Space Mono', monospace; font-size: 0.75rem; }

  /* COMPANIONS */
  .two-col { display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; }
  .companion-list { list-style: none; display: flex; flex-direction: column; gap: 0.4rem; }
  .companion-list li { font-family: 'Space Mono', monospace; font-size: 0.78rem; padding: 0.4rem 0.75rem; background: rgba(42,61,31,0.4); border-left: 2px solid var(--leaf); color: var(--paper); }
  .cautions-list li { background: rgba(122,59,30,0.2); border-left-color: var(--rust); }
  .unresolved-companions { margin-top: 1.25rem; }
  .suggested-companions { margin-top: 1.5rem; padding-top: 1.25rem; border-top: 1px solid rgba(139,184,58,0.12); }
  .suggested-companions-note { font-size: 0.78rem; color: var(--ash); font-style: italic; margin-bottom: 0.75rem; line-height: 1.5; }
  .suggestion-cards { display: flex; flex-direction: column; gap: 0.4rem; }
  .suggestion-card { display: flex; justify-content: space-between; align-items: center; padding: 0.5rem 0.75rem; background: rgba(28,24,18,0.6); border: 1px solid rgba(139,184,58,0.15); text-decoration: none; transition: border-color 0.2s; }
  .suggestion-card:hover { border-color: rgba(139,184,58,0.35); }
  .suggestion-card-left { display: flex; flex-direction: column; gap: 0.15rem; }
  .suggestion-card-name { font-family: 'Space Mono', monospace; font-size: 0.72rem; color: var(--paper); }
  .suggestion-card-family { font-size: 0.68rem; color: var(--ash); font-style: italic; }
  .suggestion-card-right { display: flex; align-items: center; gap: 0.5rem; flex-shrink: 0; }
  .suggestion-badge { font-family: 'Space Mono', monospace; font-size: 0.55rem; letter-spacing: 0.06em; text-transform: uppercase; padding: 0.15rem 0.45rem; border: 1px solid rgba(139,184,58,0.3); color: var(--lime); }
  .suggestion-badge.same { border-color: rgba(184,176,160,0.25); color: var(--ash); }
  .suggestion-pest-count { font-family: 'Space Mono', monospace; font-size: 0.6rem; color: var(--ash); opacity: 0.7; }
  .unresolved-label { font-family: 'Space Mono', monospace; font-size: 0.6rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--ash); opacity: 0.7; margin-bottom: 0.4rem; }
  .unresolved-list li { background: rgba(28,24,18,0.5); border-left-color: rgba(184,176,160,0.3); color: var(--ash); font-style: italic; }
  .unresolved-note { font-family: 'Space Mono', monospace; font-size: 0.55rem; letter-spacing: 0.08em; color: var(--ash); opacity: 0.45; margin-top: 0.4rem; }
  .ecological-context { margin-top: 1.5rem; }
  .context-list li { background: rgba(28,24,18,0.4); border-left-color: rgba(143,184,58,0.25); color: var(--ash); font-size: 0.73rem; }

  /* PEST CARDS */
  .threat-group { margin-bottom: 1.5rem; }
  .threat-group-title { font-family: 'Space Mono', monospace; font-size: 0.65rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--straw); margin-bottom: 0.5rem; }
  .threat-list { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: 0.4rem; margin-bottom: 0.5rem; }
  .threat-list li { font-family: 'Space Mono', monospace; font-size: 0.65rem; background: var(--bark); border: 1px solid rgba(139,184,58,0.15); padding: 0.25rem 0.6rem; color: var(--ash); }
  .threat-link { color: var(--rust); text-decoration: none; }
  .threat-link:hover { color: var(--paper); }
  .pest-card { display: block; text-decoration: none; background: var(--bark); border: 1px solid rgba(139,184,58,0.15); padding: 1rem 1.25rem; transition: all 0.2s; margin-bottom: 0.5rem; }
  .pest-card:hover { border-color: rgba(196,85,26,0.5); background: rgba(122,59,30,0.15); }
  .pest-card-name { font-family: 'Bebas Neue', sans-serif; font-size: 1.2rem; color: var(--paper); margin-bottom: 0.25rem; }
  .pest-card-sci { font-style: italic; font-size: 0.8rem; color: var(--ash); }
  .empty-state { font-family: 'Space Mono', monospace; font-size: 0.78rem; color: var(--ash); font-style: italic; padding: 1rem 0; }

  /* FOOTER */
  .footer { padding: 2rem 4rem; border-top: 1px solid rgba(139,184,58,0.15); display: flex; justify-content: space-between; align-items: center; margin-top: 2rem; }
  .footer-logo { font-family: 'Bebas Neue', sans-serif; font-size: 1.2rem; color: var(--lime); letter-spacing: 0.08em; }
  .footer-copy { font-family: 'Space Mono', monospace; font-size: 0.65rem; color: var(--ash); }

  @media (max-width: 768px) {
    .hero { grid-template-columns: 1fr; gap: 2rem; }
    .two-col { grid-template-columns: 1fr; }
    .footer { flex-direction: column; gap: 1rem; padding: 2rem 1.5rem; }
    .hero-image-wrap { height: 240px; }
  }
</style>

<Navbar />

<div class="breadcrumb">
  <a href="/plants">← Plants</a> / {plant.common_name}
</div>

<div class="hero-image-wrap">
  {imagePath ? (
    <img class="hero-image" src={imagePath} alt={plant.common_name} loading="eager" />
  ) : (
    <div class="hero-image-placeholder">
      <span class="placeholder-main">{plant.common_name}</span>
      <span class="placeholder-sub">Image pending. Reforestation ongoing.</span>
    </div>
  )}
</div>

<div class="hero">
  <div>
    <p class="plant-layer">{plant.layers?.[0] || 'Plant'}</p>
    <h1 class="plant-name">{plant.common_name}</h1>
    {plant.scientific_name && <p class="plant-sci">{plant.scientific_name}</p>}
    {plant.aka?.length > 0 && (
      <div class="plant-aka-wrap">
        <span class="plant-aka-label">Also known as:</span>
        {plant.aka.map((name: string) => (
          <span class="plant-aka-tag">{name}</span>
        ))}
      </div>
    )}
    <div class="plant-tags">
      {(plant.layers || []).map((l: string) => <span class="tag layer">{l}</span>)}
      {plant.family && familySlug && (
        <a href={`/plants/family/${familySlug}`} class="tag family">{plant.family}</a>
      )}
      {(plant.plant_function || []).map((fn: string) => <span class="tag">{fn}</span>)}
    </div>
  </div>

  <div class="climate-panel">
    {plant.zone && (
      <div class="climate-row">
        <div class="climate-label">Hardiness Zone</div>
        <div class="climate-value">{plant.zone}</div>
      </div>
    )}
    {plant.ideal_temp_min != null && plant.ideal_temp_max != null && (
      <div class="climate-row">
        <div class="climate-label">Ideal Temp</div>
        <div class="climate-value">{plant.ideal_temp_min}–{plant.ideal_temp_max}°F</div>
      </div>
    )}
    {plant.min_temp != null && (
      <div class="climate-row">
        <div class="climate-label">Survives Down To</div>
        <div class="climate-value">{plant.min_temp}°F</div>
      </div>
    )}
    {plant.perennial != null && (
      <div class="climate-row">
        <div class="climate-label">Life Cycle</div>
        <div class="climate-value">{plant.perennial ? 'Perennial' : 'Annual'}</div>
      </div>
    )}
  </div>
</div>

<div class="content">

  <!-- ABOUT -->
  {plant.description && (
    <div class="section">
      <p class="section-label">About</p>
      <p class="description">{plant.description}</p>
    </div>
  )}

  <!-- PERMACULTURE FUNCTIONS -->
  {purposeLines.length > 0 && (
    <div class="section">
      <p class="section-label">Permaculture Functions</p>
      <ul class="purpose-list">
        {purposeLines.map((line: string) => {
          const isIntro = !line.startsWith('-') && !line.startsWith('•') && line.endsWith(':');
          if (isIntro) return <p class="purpose-intro">{line}</p>;
          const clean = line.replace(/^[-•]\s*/, '');
          if (!clean) return null;
          // Bold the function name before the colon
          const colonIdx = clean.indexOf(':');
          if (colonIdx > 0) {
            const funcName = clean.slice(0, colonIdx);
            const funcDesc = clean.slice(colonIdx + 1).trim();
            return <li><strong>{funcName}:</strong> {funcDesc}</li>;
          }
          return <li>{clean}</li>;
        })}
      </ul>
    </div>
  )}

  <!-- FIELD OBSERVATIONS -->
  {fieldObsFacts.length > 0 && (
    <div class="section">
      <p class="section-label">Field Observations</p>
      <ul class="practitioner-list">
        {fieldObsFacts.map((fact: string) => <li>{fact}</li>)}
      </ul>
    </div>
  )}

  <!-- COMPANION PLANTING -->
  {(companions.length > 0 || cautions.length > 0 || companionsUnresolved.length > 0 || companionCategories.length > 0) && (
    <div class="section">
      <p class="section-label">Companion Planting</p>
      <div class="two-col">
        <div>
          <div class="section-title">Good Neighbors</div>
          {companions.length > 0 ? (
            <ul class="companion-list">
              {companions.map((c: any) => <li>{typeof c === "string" ? c : <a href={`/plants/${c.slug}`}>{c.name}</a>}</li>)}
            </ul>
          ) : (
            <p class="empty-state">No companion data yet.</p>
          )}

          {companionsUnresolved.length > 0 && (
            <div class="unresolved-companions">
              <p class="unresolved-label">Also mentioned as companions:</p>
              <ul class="companion-list unresolved-list">
                {companionsUnresolved.map((c: any) => (
                  <li>{typeof c === 'string' ? c : c.name}</li>
                ))}
              </ul>
              <p class="unresolved-note">Not yet profiled in PermiePortal</p>
            </div>
          )}
        </div>

        <div>
          {cautions.length > 0 && (
            <div>
              <div class="section-title">Cautions</div>
              <ul class="companion-list cautions-list">
                {cautions.map((a: string) => <li>{a}</li>)}
              </ul>
            </div>
          )}

          {companionCategories.length > 0 && (
            <div class="ecological-context">
              <div class="section-title">Ecological Context</div>
              <ul class="companion-list context-list">
                {companionCategories.map((c: any) => (
                  <li>{c.name}</li>
                ))}
              </ul>
            </div>
          )}
        </div>
      </div>
    </div>
  )}

  <!-- SUGGESTED COMPANIONS -->
  {companionSuggestions.suggestions && companionSuggestions.suggestions.length > 0 && (
    <div class="section">
      <p class="section-label">Graph-Derived Suggestions</p>
      <div class="section-inner">
        <div class="suggested-companions">
          <p class="suggested-companions-note">
            Data-driven suggestions based on lower shared pest overlap and family diversity.
          </p>
          <div class="suggestion-cards">
            {companionSuggestions.suggestions.map((s: any) => (
              <a href={`/plants/${s.slug}`} class="suggestion-card">
                <div class="suggestion-card-left">
                  <div class="suggestion-card-name">{s.common_name}</div>
                  {s.family && <div class="suggestion-card-family">{s.family}</div>}
                </div>
                <div class="suggestion-card-right">
                  <span class={`suggestion-badge${s.same_family ? ' same' : ''}`}>
                    {s.same_family ? 'Same family' : 'Diff family'}
                  </span>
                  {s.shared_pest_count === 0
                    ? <span class="suggestion-pest-count">0 shared pests</span>
                    : <span class="suggestion-pest-count">{s.shared_pest_count} shared</span>
                  }
                </div>
              </a>
            ))}
          </div>
        </div>
      </div>
    </div>
  )}

  <!-- THREATS & PRESSURE -->
  {(plantPestList.length > 0 || plantStressorList.length > 0) && (() => {
    const pestSlug = (name: string) => {
      const db = pestsData.find((pd: any) => pd.name?.toLowerCase() === name.toLowerCase());
      return db?.slug;
    };
    return (
      <div class="section">
        <p class="section-label">Threats &amp; Pressure</p>
        {plantPestList.length > 0 && (
          <div class="threat-group">
            <div class="threat-group-title">🐛 Pests</div>
            <ul class="threat-list">
              {plantPestList.map((p: string) => (
                <li>{pestSlug(p)
                  ? <a href={`/pests/${pestSlug(p)}`} class="threat-link">{p}</a>
                  : p}
                </li>
              ))}
            </ul>
          </div>
        )}
        {plantStressorList.length > 0 && (() => {
          const diseases = plantStressorList.filter((p: string) => {
            const db = pestsData.find((pd: any) => pd.name?.toLowerCase() === p.toLowerCase());
            return db?.category === 'disease';
          });
          const abiotic = plantStressorList.filter((p: string) => {
            const db = pestsData.find((pd: any) => pd.name?.toLowerCase() === p.toLowerCase());
            return db?.category === 'abiotic';
          });
          const animals = plantStressorList.filter((p: string) => {
            const db = pestsData.find((pd: any) => pd.name?.toLowerCase() === p.toLowerCase());
            return db?.category === 'animal_pressure';
          });
          return (
            <>
              {diseases.length > 0 && (
                <div class="threat-group">
                  <div class="threat-group-title">🦠 Diseases</div>
                  <ul class="threat-list">
                    {diseases.map((p: string) => (
                      <li>{pestSlug(p)
                        ? <a href={`/pests/${pestSlug(p)}`} class="threat-link">{p}</a>
                        : p}
                      </li>
                    ))}
                  </ul>
                </div>
              )}
              {abiotic.length > 0 && (
                <div class="threat-group">
                  <div class="threat-group-title">⚠️ Abiotic Stress</div>
                  <ul class="threat-list">
                    {abiotic.map((p: string) => (
                      <li>{pestSlug(p)
                        ? <a href={`/pests/${pestSlug(p)}`} class="threat-link">{p}</a>
                        : p}
                      </li>
                    ))}
                  </ul>
                </div>
              )}
              {animals.length > 0 && (
                <div class="threat-group">
                  <div class="threat-group-title">🦎 Animal Pressure</div>
                  <ul class="threat-list">
                    {animals.map((p: string) => (
                      <li>{pestSlug(p)
                        ? <a href={`/pests/${pestSlug(p)}`} class="threat-link">{p}</a>
                        : p}
                      </li>
                    ))}
                  </ul>
                </div>
              )}
            </>
          );
        })()}
      </div>
    );
  })()}

</div>

<footer class="footer">
  <div class="footer-logo">PermiePortal</div>
  <div class="footer-copy">© {new Date().getFullYear()} — Built in a food forest in Yulee, FL</div>
</footer>

</BaseLayout>
