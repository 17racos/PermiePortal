---
export interface Props {
  title: string;
  summary: string;
  date: string;
  tags?: string[];
  href: string;
}
const { title, summary, date, tags = [], href } = Astro.props as Props;
---
<article class="p-4 border border-gray-800 rounded hover:border-citrus transition" aria-labelledby={title}>
  <h3 class="text-xl font-bold"><a href={href} class="hover:text-citrus">{title}</a></h3>
  <p class="text-xs text-gray-400 mt-1">{new Date(date).toLocaleDateString()}</p>
  <p class="mt-2 text-sm text-gray-200">{summary}</p>
  {tags.length > 0 && (
    <ul class="mt-3 flex flex-wrap gap-2" aria-label="tags">
      {tags.map(t => <li class="text-xs bg-ink border border-gray-800 rounded px-2 py-0.5">{t}</li>)}
    </ul>
  )}
</article>


