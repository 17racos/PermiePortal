---
import '../../styles/tailwind.css';
import '../../styles/base.css';
interface Props {
  title?: string;
  description?: string;
}
const { title = 'PermiePortal', description = 'PermiePortal — 1000+ permaculture plants, 200 organic pest profiles, food forest guides. Real field data. No greenwash.' } = Astro.props as Props;
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title ? `${title} • PermiePortal` : 'PermiePortal'}</title>
    <meta name="description" content={description} />
    <meta name="google-site-verification" content="bLxvoBd89aDYT3Dj1T9TatnrTBMSLzKTLPcG2TQ67SM" />
  </head>
  <body>
    <slot />
  </body>
</html>


