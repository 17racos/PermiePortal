---
import '../../styles/tailwind.css';
import '../../styles/base.css';
interface Props {
  title?: string;
  description?: string;
}
const { title = 'PermiePortal', description = 'PermiePortal — permaculture zine + project lab' } = Astro.props as Props;
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title ? `${title} • PermiePortal` : 'PermiePortal'}</title>
    <meta name="description" content={description} />
  </head>
  <body>
    <slot />
  </body>
</html>


